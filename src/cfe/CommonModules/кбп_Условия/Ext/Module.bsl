#Область ПрограммныйИнтерфейс

// Вычисляет условие-обработчик линии (ФТ-203). Выражения — этап 6.
// Обработчик получает контекст с полем Результат и должен установить его в Истина или Ложь.
//
// Параметры:
//  Обработчик - СправочникСсылка.кбп_ОбработчикиПроцессов
//  Контекст - Структура - контекст операции движка.
//
// Возвращаемое значение:
//  Булево
//
Функция УсловиеВыполняется(Обработчик, Контекст) Экспорт

	Если Не ЗначениеЗаполнено(Обработчик) Тогда
		Возврат Ложь;
	КонецЕсли;
	Контекст.Вставить("Результат", Ложь);
	кбп_Действия.ВыполнитьОбработчик(Обработчик, Контекст);
	Результат = (Контекст.Результат = Истина);
	Контекст.Удалить("Результат");
	Возврат Результат;

КонецФункции

// Вычисляет условие-отбор (ФТ-201): отбор компоновки данных по полям «Предмет…», «Переменные.…», «Автор…».
// Отбор проверяется по значениям контекста, без запроса к данным: поля через точку читаются из ссылок.
//
// Параметры:
//  Условие - ХранилищеЗначения, НастройкиКомпоновкиДанных - сохранённые настройки редактора условия.
//  Контекст - Структура - контекст операции движка (Предмет, Переменные, Автор, …).
//
// Возвращаемое значение:
//  Булево - Ложь, если условие не задано.
//
Функция ОтборВыполняется(Условие, Контекст) Экспорт

	Настройки = НастройкиУсловия(Условие);
	Если Настройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ГруппаВыполняется(Настройки.Отбор.Элементы, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ, Контекст);

КонецФункции

// Схема компоновки с полями, доступными в условиях схемы процесса: предмет (с реквизитами через точку),
// автор, результат последней задачи и переменные процесса.
//
// Параметры:
//  Схема - СправочникСсылка.кбп_СхемыПроцессов
//
// Возвращаемое значение:
//  СхемаКомпоновкиДанных
//
Функция СхемаУсловия(Схема) Экспорт

	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	Источник = СхемаКомпоновки.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных1";
	Источник.ТипИсточникаДанных = "Local";

	Набор = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Контекст";
	Набор.ИмяОбъекта = "Контекст";
	Набор.ИсточникДанных = "ИсточникДанных1";

	ТипПредмета = ?(ЗначениеЗаполнено(Схема), Схема.ТипПредмета, "");
	Если ЗначениеЗаполнено(ТипПредмета) Тогда
		ДобавитьПоле(Набор, "Предмет", "Предмет", НСтр("ru = 'Предмет процесса'"), ОписаниеТипаСсылки(ТипПредмета));
	КонецЕсли;
	ДобавитьПоле(Набор, "Автор", "Автор", НСтр("ru = 'Автор процесса'"),
		Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ДобавитьПоле(Набор, "РезультатЗадачи", "РезультатЗадачи", НСтр("ru = 'Результат предыдущей задачи (кнопка)'"),
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));

	Переменные = ПеременныеСхемы(Схема);
	Если Переменные.Количество() > 0 Тогда
		Папка = Набор.Поля.Добавить(Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных"));
		Папка.ПутьКДанным = "Переменные";
		Папка.Заголовок = НСтр("ru = 'Переменные процесса'");
		Для Каждого Переменная Из Переменные Цикл
			ДобавитьПоле(Набор, "Переменная_" + Переменная.Имя, "Переменные." + Переменная.Имя,
				Переменная.Наименование, Переменная.ТипЗначения);
		КонецЦикла;
	КонецЕсли;

	Возврат СхемаКомпоновки;

КонецФункции

// Текст условия для панели свойств и журнала: «Предмет.Сумма больше 100 000 И Переменные.Срочно равно Да».
//
// Параметры:
//  Условие - ХранилищеЗначения, НастройкиКомпоновкиДанных
//
// Возвращаемое значение:
//  Строка - пустая, если условие не задано.
//
Функция ПредставлениеУсловия(Условие) Экспорт

	Настройки = НастройкиУсловия(Условие);
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПредставлениеГруппы(Настройки.Отбор.Элементы, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ, Ложь);

КонецФункции

// Есть ли в условии хотя бы один используемый элемент отбора.
//
// Параметры:
//  Условие - ХранилищеЗначения, НастройкиКомпоновкиДанных
//
// Возвращаемое значение:
//  Булево
//
Функция УсловиеЗаполнено(Условие) Экспорт
	Возврат ЗначениеЗаполнено(ПредставлениеУсловия(Условие));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкиУсловия(Условие)

	Настройки = Условие;
	Если ТипЗнч(Настройки) = Тип("ХранилищеЗначения") Тогда
		Настройки = Настройки.Получить();
	КонецЕсли;
	Если ТипЗнч(Настройки) <> Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Настройки;

КонецФункции

Процедура ДобавитьПоле(Набор, Имя, Путь, Заголовок, ТипЗначения)

	Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	Поле.Поле = Имя;
	Поле.ПутьКДанным = Путь;
	Поле.Заголовок = Заголовок;
	Поле.ТипЗначения = ТипЗначения;

КонецПроцедуры

// «Документ.ЗаказКлиента» → ОписаниеТипов("ДокументСсылка.ЗаказКлиента").
Функция ОписаниеТипаСсылки(ПолноеИмя)

	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Новый ОписаниеТипов;
	КонецЕсли;
	Попытка
		Возврат Новый ОписаниеТипов(Части[0] + "Ссылка." + Части[1]);
	Исключение
		Возврат Новый ОписаниеТипов;
	КонецПопытки;

КонецФункции

Функция ПеременныеСхемы(Схема)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Схема", Схема);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переменные.Имя КАК Имя,
	|	Переменные.Наименование КАК Наименование,
	|	Переменные.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	ПланВидовХарактеристик.кбп_ПеременныеПроцессов КАК Переменные
	|ГДЕ
	|	Переменные.Схема = &Схема
	|	И НЕ Переменные.ПометкаУдаления
	|	И Переменные.Имя <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Переменные.Порядок,
	|	Переменные.Наименование";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// «И»: все используемые элементы истинны; «ИЛИ»: хотя бы один; «НЕ»: не выполняются все элементы вместе.
Функция ГруппаВыполняется(Элементы, ТипГруппы, Контекст)

	Типы = ТипГруппыЭлементовОтбораКомпоновкиДанных;
	ЕстьЭлементы = Ложь;
	ВсеИстинны = Истина;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		ЕстьЭлементы = Истина;
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Значение = ГруппаВыполняется(Элемент.Элементы, Элемент.ТипГруппы, Контекст);
		Иначе
			Значение = ЭлементВыполняется(Элемент, Контекст);
		КонецЕсли;
		Если ТипГруппы = Типы.ГруппаИли И Значение Тогда
			Возврат Истина;
		КонецЕсли;
		ВсеИстинны = ВсеИстинны И Значение;
	КонецЦикла;

	Если ТипГруппы = Типы.ГруппаИли Тогда
		Возврат Не ЕстьЭлементы;
	ИначеЕсли ТипГруппы = Типы.ГруппаНе Тогда
		Возврат Не (ЕстьЭлементы И ВсеИстинны);
	КонецЕсли;
	Возврат ВсеИстинны;

КонецФункции

Функция ЭлементВыполняется(Элемент, Контекст)

	Лево = ЗначениеПоля(Элемент.ЛевоеЗначение, Контекст);
	Право = Элемент.ПравоеЗначение;
	Если ТипЗнч(Право) = Тип("ПолеКомпоновкиДанных") Тогда
		Право = ЗначениеПоля(Право, Контекст);
	КонецЕсли;
	Попытка
		Возврат Сравнить(Лево, Элемент.ВидСравнения, Право);
	Исключение
		// Несравнимые типы (например, строка и число) — условие не выполняется.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция Сравнить(Лево, ВидСравнения, Право)

	Виды = ВидСравненияКомпоновкиДанных;
	Если ВидСравнения = Виды.Равно Тогда
		Возврат Лево = Право;
	ИначеЕсли ВидСравнения = Виды.НеРавно Тогда
		Возврат Лево <> Право;
	ИначеЕсли ВидСравнения = Виды.Больше Тогда
		Возврат Лево > Право;
	ИначеЕсли ВидСравнения = Виды.БольшеИлиРавно Тогда
		Возврат Лево >= Право;
	ИначеЕсли ВидСравнения = Виды.Меньше Тогда
		Возврат Лево < Право;
	ИначеЕсли ВидСравнения = Виды.МеньшеИлиРавно Тогда
		Возврат Лево <= Право;
	ИначеЕсли ВидСравнения = Виды.Заполнено Тогда
		Возврат ЗначениеЗаполнено(Лево);
	ИначеЕсли ВидСравнения = Виды.НеЗаполнено Тогда
		Возврат Не ЗначениеЗаполнено(Лево);
	ИначеЕсли ВидСравнения = Виды.ВСписке Тогда
		Возврат ВСписке(Лево, Право);
	ИначеЕсли ВидСравнения = Виды.НеВСписке Тогда
		Возврат Не ВСписке(Лево, Право);
	ИначеЕсли ВидСравнения = Виды.Содержит Тогда
		Возврат СтрНайти(НРег(Строка(Лево)), НРег(Строка(Право))) > 0;
	ИначеЕсли ВидСравнения = Виды.НеСодержит Тогда
		Возврат СтрНайти(НРег(Строка(Лево)), НРег(Строка(Право))) = 0;
	ИначеЕсли ВидСравнения = Виды.НачинаетсяС Тогда
		Возврат СтрНачинаетсяС(НРег(Строка(Лево)), НРег(Строка(Право)));
	ИначеЕсли ВидСравнения = Виды.НеНачинаетсяС Тогда
		Возврат Не СтрНачинаетсяС(НРег(Строка(Лево)), НРег(Строка(Право)));
	ИначеЕсли ВидСравнения = Виды.ВИерархии Тогда
		Возврат ВИерархии(Лево, Право);
	ИначеЕсли ВидСравнения = Виды.НеВИерархии Тогда
		Возврат Не ВИерархии(Лево, Право);
	ИначеЕсли ВидСравнения = Виды.ВСпискеПоИерархии Тогда
		Возврат ВСпискеПоИерархии(Лево, Право);
	ИначеЕсли ВидСравнения = Виды.НеВСпискеПоИерархии Тогда
		Возврат Не ВСпискеПоИерархии(Лево, Право);
	КонецЕсли;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'Вид сравнения «%1» в условиях процессов не поддерживается.'"), ВидСравнения);

КонецФункции

Функция ВСписке(Значение, Список)

	Если ТипЗнч(Список) = Тип("СписокЗначений") Тогда
		Возврат Список.НайтиПоЗначению(Значение) <> Неопределено;
	ИначеЕсли ТипЗнч(Список) = Тип("Массив") Или ТипЗнч(Список) = Тип("ФиксированныйМассив") Тогда
		Возврат Список.Найти(Значение) <> Неопределено;
	КонецЕсли;
	Возврат Значение = Список;

КонецФункции

Функция ВИерархии(Значение, Группа)

	Если Значение = Группа Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Или Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Значение.ПринадлежитЭлементу(Группа);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВСпискеПоИерархии(Значение, Список)

	Если ТипЗнч(Список) = Тип("СписокЗначений") Тогда
		Для Каждого ЭлементСписка Из Список Цикл
			Если ВИерархии(Значение, ЭлементСписка.Значение) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	Возврат ВИерархии(Значение, Список);

КонецФункции

// Значение поля условия по контексту: «Предмет[.Реквизит…]», «Переменные.Имя[.Реквизит…]», «Автор[.Реквизит…]»,
// «РезультатЗадачи» — заголовок кнопки, которой выполнена предыдущая задача.
Функция ЗначениеПоля(Поле, Контекст)

	Путь = Строка(Поле);
	Части = СтрРазделить(Путь, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Начало = НРег(Части[0]);
	Если Начало = "предмет" Тогда
		Части.Удалить(0);
		Если Части.Количество() = 0 Тогда
			Возврат Контекст.Предмет;
		КонецЕсли;
		Возврат кбп_Адресация.ЗначениеПоПути(Контекст, СтрСоединить(Части, "."));
	ИначеЕсли Начало = "переменные" Тогда
		Возврат кбп_Адресация.ЗначениеПоПути(Контекст, Путь);
	ИначеЕсли Начало = "автор" Тогда
		Значение = Контекст.Автор;
		Для Индекс = 1 По Части.ВГраница() Цикл
			Если Не ЗначениеЗаполнено(Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Значение = Значение[Части[Индекс]];
		КонецЦикла;
		Возврат Значение;
	ИначеЕсли Начало = "результатзадачи" Тогда
		Если Контекст.Задача = Неопределено Или Не ЗначениеЗаполнено(Контекст.ИдКнопки) Тогда
			Возврат "";
		КонецЕсли;
		Возврат кбп_Действия.ЗаголовокКнопки(Контекст.Задача.Шаг, Контекст.ИдКнопки);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ПредставлениеГруппы(Элементы, ТипГруппы, ВСкобках)

	Типы = ТипГруппыЭлементовОтбораКомпоновкиДанных;
	Части = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Текст = ПредставлениеГруппы(Элемент.Элементы, Элемент.ТипГруппы, Истина);
		Иначе
			Текст = ПредставлениеЭлемента(Элемент);
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) Тогда
			Части.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ТипГруппы = Типы.ГруппаИли Тогда
		Текст = СтрСоединить(Части, " " + НСтр("ru = 'ИЛИ'") + " ");
	Иначе
		Текст = СтрСоединить(Части, " " + НСтр("ru = 'И'") + " ");
	КонецЕсли;
	Если ТипГруппы = Типы.ГруппаНе Тогда
		Возврат НСтр("ru = 'НЕ'") + " (" + Текст + ")";
	КонецЕсли;
	Возврат ?(ВСкобках И Части.Количество() > 1, "(" + Текст + ")", Текст);

КонецФункции

Функция ПредставлениеЭлемента(Элемент)

	Если ЗначениеЗаполнено(Элемент.Представление) Тогда
		Возврат Элемент.Представление;
	КонецЕсли;
	Виды = ВидСравненияКомпоновкиДанных;
	Текст = Строка(Элемент.ЛевоеЗначение) + " " + НРег(Строка(Элемент.ВидСравнения));
	Если Элемент.ВидСравнения <> Виды.Заполнено И Элемент.ВидСравнения <> Виды.НеЗаполнено Тогда
		Право = Элемент.ПравоеЗначение;
		Если ТипЗнч(Право) = Тип("Булево") Тогда
			Право = ?(Право, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
		КонецЕсли;
		Текст = Текст + " " + Строка(Право);
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти
