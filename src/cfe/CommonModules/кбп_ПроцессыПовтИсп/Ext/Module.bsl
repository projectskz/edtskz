#Область СлужебныеПроцедурыИФункции

// Типы предметов (полные имена метаданных), для которых есть правила автозапуска: быстрая проверка
// в подписках на запись всех объектов. Кэш сеанса обновляется платформой (до 20 минут) и при публикации схемы.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие - полное имя → Истина.
//
Функция ТипыСПравиламиЗапуска() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Правила.ТипПредмета КАК ТипПредмета
	|ИЗ
	|	РегистрСведений.кбп_ПравилаЗапуска КАК Правила";
	Типы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Типы.Вставить(Выборка.ТипПредмета, Истина);
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Типы);

КонецФункции

#КонецОбласти
