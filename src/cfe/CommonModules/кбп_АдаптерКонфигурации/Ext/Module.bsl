#Область ПрограммныйИнтерфейс

// Возвращает код продукта базовой конфигурации: "ERP", "КА", "УТ", "УНФ", "БП", "УХ" или "Другое".
//
// Возвращаемое значение:
//  Строка
//
Функция ТекущийПродукт() Экспорт

	Имя = Метаданные.Имя;
	Если СтрНачинаетсяС(Имя, "УправлениеПредприятием") Тогда
		Возврат "ERP";
	ИначеЕсли СтрНачинаетсяС(Имя, "КомплекснаяАвтоматизация") Тогда
		Возврат "КА";
	ИначеЕсли СтрНачинаетсяС(Имя, "УправлениеТорговлей") Тогда
		Возврат "УТ";
	ИначеЕсли СтрНачинаетсяС(Имя, "УправлениеНебольшойФирмой") Тогда
		Возврат "УНФ";
	ИначеЕсли СтрНачинаетсяС(Имя, "Бухгалтерия") Тогда
		Возврат "БП";
	ИначеЕсли СтрНачинаетсяС(Имя, "УправлениеХолдингом") Тогда
		Возврат "УХ";
	КонецЕсли;
	Возврат "Другое";

КонецФункции

// Текущий пользователь информационной базы (БСП «Пользователи»).
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи
//
Функция ТекущийПользователь() Экспорт
	Возврат Пользователи.ТекущийПользователь();
КонецФункции

// Администратор процессов: роль кбп_АдминистрированиеПроцессов или полные права.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоАдминистраторПроцессов() Экспорт
	Возврат РольДоступна("кбп_АдминистрированиеПроцессов") Или Пользователи.ЭтоПолноправныйПользователь();
КонецФункции

// Обёртка над ОбщегоНазначения.ПодсистемаСуществует.
//
// Параметры:
//  ПолноеИмяПодсистемы - Строка - например "СтандартныеПодсистемы.РаботаСПочтовымиСообщениями".
//
// Возвращаемое значение:
//  Булево
//
Функция ПодсистемаСуществует(ПолноеИмяПодсистемы) Экспорт
	Возврат ОбщегоНазначения.ПодсистемаСуществует(ПолноеИмяПодсистемы);
КонецФункции

// Отправляет письмо через системную учётную запись БСП «Работа с почтовыми сообщениями».
// Вызывает исключение, если почта не настроена или отправка не удалась.
//
// Параметры:
//  Письмо - Структура - Кому (Строка), Тема, Текст, ЭтоHTML.
//
Процедура ОтправитьПочту(Письмо) Экспорт

	Если Не ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации нет подсистемы «Работа с почтовыми сообщениями».'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	МодульПочта = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	УчетнаяЗапись = МодульПочта.СистемнаяУчетнаяЗапись();
	Если Не МодульПочта.УчетнаяЗаписьНастроена(УчетнаяЗапись, Истина, Ложь) Тогда
		ВызватьИсключение НСтр("ru = 'Не настроена системная учётная запись электронной почты (Администрирование → Органайзер → Почта).'");
	КонецЕсли;

	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", Письмо.Кому);
	ПараметрыПисьма.Вставить("Тема", Письмо.Тема);
	ПараметрыПисьма.Вставить("Тело", Письмо.Текст);
	ПараметрыПисьма.Вставить("ТипТекста", ?(Письмо.ЭтоHTML, "HTML", "ПростойТекст"));
	Сообщение = МодульПочта.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	МодульПочта.ОтправитьПисьмо(УчетнаяЗапись, Сообщение);

КонецПроцедуры

// Адрес электронной почты пользователя из контактной информации (БСП).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Строка - пустая, если адрес не указан.
//
Функция АдресЭлектроннойПочты(Пользователь) Экспорт

	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление КАК Адрес
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Пользователь
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактнаяИнформация.Представление <> """"";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), СокрЛП(Выборка.Адрес), "");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Руководитель пользователя. Структура предприятия у конфигураций разная — этап 3 (ФТ-303).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено
//
Функция РуководительПользователя(Пользователь) Экспорт
	Возврат Неопределено;
КонецФункции

// Пользователь по значению реквизита: сам пользователь или пользователь физического лица.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено
//
Функция ПользовательПоЗначению(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Пользователи") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФизическоеЛицо = Значение;
	Попытка
		ФизическоеЛицо = Значение["ФизическоеЛицо"]; // сотрудник, пользователь
	Исключение
		ФизическоеЛицо = Значение;
	КонецПопытки;

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизическоеЛицо = &ФизическоеЛицо
	|	И НЕ Пользователи.Недействителен
	|	И НЕ Пользователи.ПометкаУдаления";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Производственный календарь для сроков — этап 3 (БСП «Календарные графики»).
//
// Возвращаемое значение:
//  Неопределено
//
Функция ПроизводственныйКалендарь() Экспорт
	Возврат Неопределено;
КонецФункции

// Срок через заданное число рабочих часов. Пока без календаря: календарные часы.
//
// Параметры:
//  Дата - Дата
//  Часы - Число
//
// Возвращаемое значение:
//  Дата
//
Функция ДобавитьРабочиеЧасы(Дата, Часы) Экспорт
	Возврат Дата + Часы * 3600;
КонецФункции

// Срок через заданное число рабочих дней. Пока без календаря: пропускаются суббота и воскресенье.
//
// Параметры:
//  Дата - Дата
//  Дни - Число
//
// Возвращаемое значение:
//  Дата
//
Функция ДобавитьРабочиеДни(Дата, Дни) Экспорт

	Результат = Дата;
	Осталось = Цел(Дни);
	Пока Осталось > 0 Цикл
		Результат = Результат + 86400;
		Если ДеньНедели(Результат) < 6 Тогда
			Осталось = Осталось - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат + (Дни - Цел(Дни)) * 86400;

КонецФункции

// Типы объектов, по которым можно запускать процессы (ФТ-104): документы и справочники конфигурации.
//
// Возвращаемое значение:
//  СписокЗначений - значение: полное имя метаданных, представление: «Документ: Заказ клиента».
//
Функция ТипыОбъектовДляПроцессов() Экспорт

	Результат = Новый СписокЗначений;
	Коллекции = Новый Структура("Документы, Справочники, БизнесПроцессы, Задачи",
		НСтр("ru = 'Документ'"), НСтр("ru = 'Справочник'"), НСтр("ru = 'Бизнес-процесс'"), НСтр("ru = 'Задача'"));
	Для Каждого КлючЗначение Из Коллекции Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[КлючЗначение.Ключ] Цикл
			Если СтрНачинаетсяС(ОбъектМетаданных.Имя, "кбп_") Или Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(ОбъектМетаданных.ПолноеИмя(),
				СтрШаблон("%1: %2", КлючЗначение.Значение, ОбъектМетаданных.Представление()));
		КонецЦикла;
	КонецЦикла;
	Результат.СортироватьПоПредставлению();
	Возврат Результат;

КонецФункции

// Представление объекта для наименований и оповещений.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеОбъекта(Ссылка) Экспорт
	Возврат Строка(Ссылка);
КонецФункции

// Ссылка на объект для писем: адрес базы + навигационная ссылка.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка
//
Функция ВнешняяСсылка(Ссылка) Экспорт

	Попытка
		Навигационная = ПолучитьНавигационнуюСсылку(Ссылка);
	Исключение
		Возврат "";
	КонецПопытки;
	Попытка
		АдресБазы = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
	Исключение
		АдресБазы = "";
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(АдресБазы), АдресБазы + "#" + Навигационная, Навигационная);

КонецФункции

#КонецОбласти
