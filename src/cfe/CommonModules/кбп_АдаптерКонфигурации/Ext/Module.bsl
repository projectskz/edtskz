#Область ПрограммныйИнтерфейс

// Возвращает код продукта базовой конфигурации: "ERP", "КА", "УТ", "УНФ", "БП", "УХ" или "Другое".
//
// Возвращаемое значение:
//  Строка
//
Функция ТекущийПродукт() Экспорт

	Имя = Метаданные.Имя;
	Если СтрНачинаетсяС(Имя, "УправлениеПредприятием") Тогда
		Возврат "ERP";
	ИначеЕсли СтрНачинаетсяС(Имя, "КомплекснаяАвтоматизация") Тогда
		Возврат "КА";
	ИначеЕсли СтрНачинаетсяС(Имя, "УправлениеТорговлей") Тогда
		Возврат "УТ";
	ИначеЕсли СтрНачинаетсяС(Имя, "УправлениеНебольшойФирмой") Тогда
		Возврат "УНФ";
	ИначеЕсли СтрНачинаетсяС(Имя, "Бухгалтерия") Тогда
		Возврат "БП";
	ИначеЕсли СтрНачинаетсяС(Имя, "УправлениеХолдингом") Тогда
		Возврат "УХ";
	КонецЕсли;
	Возврат "Другое";

КонецФункции

// Текущий пользователь информационной базы (БСП «Пользователи»).
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи
//
Функция ТекущийПользователь() Экспорт
	Возврат Пользователи.ТекущийПользователь();
КонецФункции

// Администратор процессов: роль кбп_АдминистрированиеПроцессов или полные права.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоАдминистраторПроцессов() Экспорт
	Возврат РольДоступна("кбп_АдминистрированиеПроцессов") Или Пользователи.ЭтоПолноправныйПользователь();
КонецФункции

// Обёртка над ОбщегоНазначения.ПодсистемаСуществует.
//
// Параметры:
//  ПолноеИмяПодсистемы - Строка - например "СтандартныеПодсистемы.РаботаСПочтовымиСообщениями".
//
// Возвращаемое значение:
//  Булево
//
Функция ПодсистемаСуществует(ПолноеИмяПодсистемы) Экспорт
	Возврат ОбщегоНазначения.ПодсистемаСуществует(ПолноеИмяПодсистемы);
КонецФункции

// Отправляет письмо через системную учётную запись БСП «Работа с почтовыми сообщениями».
// Вызывает исключение, если почта не настроена или отправка не удалась.
//
// Параметры:
//  Письмо - Структура - Кому (Строка), Тема, Текст, ЭтоHTML.
//
Процедура ОтправитьПочту(Письмо) Экспорт

	Если Не ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации нет подсистемы «Работа с почтовыми сообщениями».'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	МодульПочта = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	УчетнаяЗапись = МодульПочта.СистемнаяУчетнаяЗапись();
	Если Не МодульПочта.УчетнаяЗаписьНастроена(УчетнаяЗапись, Истина, Ложь) Тогда
		ВызватьИсключение НСтр("ru = 'Не настроена системная учётная запись электронной почты (Администрирование → Органайзер → Почта).'");
	КонецЕсли;

	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", Письмо.Кому);
	ПараметрыПисьма.Вставить("Тема", Письмо.Тема);
	ПараметрыПисьма.Вставить("Тело", Письмо.Текст);
	ПараметрыПисьма.Вставить("ТипТекста", ?(Письмо.ЭтоHTML, "HTML", "ПростойТекст"));
	Сообщение = МодульПочта.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	МодульПочта.ОтправитьПисьмо(УчетнаяЗапись, Сообщение);

КонецПроцедуры

// Адрес электронной почты пользователя из контактной информации (БСП).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Строка - пустая, если адрес не указан.
//
Функция АдресЭлектроннойПочты(Пользователь) Экспорт

	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление КАК Адрес
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Пользователь
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактнаяИнформация.Представление <> """"";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), СокрЛП(Выборка.Адрес), "");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Руководитель пользователя. Структура предприятия у конфигураций разная — этап 3 (ФТ-303).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено
//
Функция РуководительПользователя(Пользователь) Экспорт
	Возврат Неопределено;
КонецФункции

// Пользователь по значению реквизита: сам пользователь или пользователь физического лица.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено
//
Функция ПользовательПоЗначению(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Пользователи") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФизическоеЛицо = Значение;
	Попытка
		ФизическоеЛицо = Значение["ФизическоеЛицо"]; // сотрудник, пользователь
	Исключение
		ФизическоеЛицо = Значение;
	КонецПопытки;

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизическоеЛицо = &ФизическоеЛицо
	|	И НЕ Пользователи.Недействителен
	|	И НЕ Пользователи.ПометкаУдаления";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Производственный календарь для сроков (ФТ-406): из настройки «ПроизводственныйКалендарь»,
// иначе основной календарь БСП «Календарные графики». Неопределено, если подсистемы нет
// или календарь не заполнен, — тогда рабочими считаются будни.
//
// Возвращаемое значение:
//  СправочникСсылка.ПроизводственныеКалендари, Неопределено
//
Функция ПроизводственныйКалендарь() Экспорт

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КалендарныеГрафики") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Календарь = кбп_ПроцессыСлужебный.Настройка("ПроизводственныйКалендарь");
	Если ЗначениеЗаполнено(Календарь) Тогда
		Возврат Календарь;
	КонецЕсли;
	Попытка
		МодульКалендарныеГрафики = ОбщегоНазначения.ОбщийМодуль("КалендарныеГрафики");
		Календарь = МодульКалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	Исключение
		Календарь = Неопределено;
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(Календарь), Календарь, Неопределено);

КонецФункции

// Срок через заданное число рабочих часов: считаются только часы рабочего дня
// (настройки «НачалоРабочегоДня», «ОкончаниеРабочегоДня») в рабочие дни календаря.
//
// Параметры:
//  Дата - Дата
//  Часы - Число
//
// Возвращаемое значение:
//  Дата
//
Функция ДобавитьРабочиеЧасы(Дата, Часы) Экспорт

	Начало = кбп_ПроцессыСлужебный.Настройка("НачалоРабочегоДня") * 3600;
	Окончание = кбп_ПроцессыСлужебный.Настройка("ОкончаниеРабочегоДня") * 3600;
	Если Окончание <= Начало Тогда
		Возврат Дата + Часы * 3600;
	КонецЕсли;
	Осталось = Окр(Часы * 3600);
	РабочиеДни = СледующиеРабочиеДни(НачалоДня(Дата) - 86400, Цел(Часы * 3600 / (Окончание - Начало)) + 10);
	Текущая = Дата;
	Для Каждого День Из РабочиеДни Цикл
		Если День < НачалоДня(Текущая) Тогда
			Продолжить;
		КонецЕсли;
		С = Макс(Текущая, День + Начало);
		По = День + Окончание;
		Если С >= По Тогда
			Продолжить;
		КонецЕсли;
		Если По - С >= Осталось Тогда
			Возврат С + Осталось;
		КонецЕсли;
		Осталось = Осталось - (По - С);
		Текущая = По;
	КонецЦикла;
	// Календарь не заполнен на нужный период: остаток — календарными часами.
	Возврат Текущая + Осталось;

КонецФункции

// Срок через заданное число рабочих дней по производственному календарю; время дня сохраняется.
// Без календаря пропускаются суббота и воскресенье.
//
// Параметры:
//  Дата - Дата
//  Дни - Число
//
// Возвращаемое значение:
//  Дата
//
Функция ДобавитьРабочиеДни(Дата, Дни) Экспорт

	Целых = Цел(Дни);
	Время = Дата - НачалоДня(Дата);
	Результат = НачалоДня(Дата);
	Если Целых > 0 Тогда
		РабочиеДни = СледующиеРабочиеДни(НачалоДня(Дата), Целых);
		Если РабочиеДни.Количество() >= Целых Тогда
			Результат = РабочиеДни[Целых - 1];
		Иначе
			Результат = Результат + Целых * 86400;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат + Время + (Дни - Целых) * 86400;

КонецФункции

// Рабочий ли день по производственному календарю (без календаря — будни).
//
// Параметры:
//  Дата - Дата
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоРабочийДень(Дата) Экспорт

	РабочиеДни = СледующиеРабочиеДни(НачалоДня(Дата) - 86400, 1);
	Возврат РабочиеДни.Количество() > 0 И РабочиеДни[0] = НачалоДня(Дата);

КонецФункции

// Типы объектов, по которым можно запускать процессы (ФТ-104): документы и справочники конфигурации.
//
// Возвращаемое значение:
//  СписокЗначений - значение: полное имя метаданных, представление: «Документ: Заказ клиента».
//
Функция ТипыОбъектовДляПроцессов() Экспорт

	Результат = Новый СписокЗначений;
	Коллекции = Новый Структура("Документы, Справочники, БизнесПроцессы, Задачи",
		НСтр("ru = 'Документ'"), НСтр("ru = 'Справочник'"), НСтр("ru = 'Бизнес-процесс'"), НСтр("ru = 'Задача'"));
	Для Каждого КлючЗначение Из Коллекции Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[КлючЗначение.Ключ] Цикл
			Если СтрНачинаетсяС(ОбъектМетаданных.Имя, "кбп_") Или Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(ОбъектМетаданных.ПолноеИмя(),
				СтрШаблон("%1: %2", КлючЗначение.Значение, ОбъектМетаданных.Представление()));
		КонецЦикла;
	КонецЦикла;
	Результат.СортироватьПоПредставлению();
	Возврат Результат;

КонецФункции

// Представление объекта для наименований и оповещений.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеОбъекта(Ссылка) Экспорт
	Возврат Строка(Ссылка);
КонецФункции

// Включает регламентные задания очередей (таймеры, продолжение родителей, оповещения, окончание замещений),
// если они выключены.
// В модели сервиса задания управляются иначе — этап 8 (Архитектура п. 10.1).
Процедура ВключитьРегламентныеЗадания() Экспорт

	Задания = Новый Соответствие;
	Задания.Вставить(Метаданные.РегламентныеЗадания.кбп_ОбработкаОчередиДействий, 60);
	Задания.Вставить(Метаданные.РегламентныеЗадания.кбп_ОбработкаОчередиОповещений, 300);
	Задания.Вставить(Метаданные.РегламентныеЗадания.кбп_КонтрольСроков, 900);
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого КлючЗначение Из Задания Цикл
		Задание = РегламентныеЗадания.НайтиПредопределенное(КлючЗначение.Ключ);
		Если Задание = Неопределено Или Задание.Использование Тогда
			Продолжить;
		КонецЕсли;
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ПериодПовтораВТечениеДня = КлючЗначение.Значение;
		Задание.Расписание = Расписание;
		Задание.Использование = Истина;
		Задание.Записать();
	КонецЦикла;

КонецПроцедуры

// Ссылка на объект для писем: адрес базы + навигационная ссылка.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка
//
Функция ВнешняяСсылка(Ссылка) Экспорт

	Попытка
		Навигационная = ПолучитьНавигационнуюСсылку(Ссылка);
	Исключение
		Возврат "";
	КонецПопытки;
	Попытка
		АдресБазы = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
	Исключение
		АдресБазы = "";
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(АдресБазы), АдресБазы + "#" + Навигационная, Навигационная);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Рабочие дни (начало дня) строго после даты ПослеДаты: по производственному календарю,
// а если его нет или он не заполнен на период — будни.
Функция СледующиеРабочиеДни(ПослеДаты, Количество)

	Результат = Новый Массив;
	Если Количество <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Календарь = ПроизводственныйКалендарь();
	Если Календарь <> Неопределено Тогда
		МассивДней = Новый Массив;
		Для Номер = 1 По Количество Цикл
			МассивДней.Добавить(Номер);
		КонецЦикла;
		Попытка
			МодульКалендарныеГрафики = ОбщегоНазначения.ОбщийМодуль("КалендарныеГрафики");
			Даты = МодульКалендарныеГрафики.ДатыПоКалендарю(Календарь, НачалоДня(ПослеДаты), МассивДней, , Ложь);
		Исключение
			Даты = Неопределено;
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Конструктор бизнес-процессов.Производственный календарь'"),
				УровеньЖурналаРегистрации.Предупреждение, , Календарь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если ТипЗнч(Даты) = Тип("Массив") И Даты.Количество() = Количество Тогда
			Для Каждого Дата Из Даты Цикл
				Результат.Добавить(НачалоДня(Дата));
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	День = НачалоДня(ПослеДаты);
	Пока Результат.Количество() < Количество Цикл
		День = День + 86400;
		Если ДеньНедели(День) < 6 Тогда
			Результат.Добавить(День);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
