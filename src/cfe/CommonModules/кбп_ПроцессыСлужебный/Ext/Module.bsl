#Область ПрограммныйИнтерфейс

// Значение настройки продукта из регистра кбп_Настройки или значение по умолчанию (ФТ-904).
//
// Параметры:
//  Ключ - Строка - ключ из НастройкиПоУмолчанию.
//
// Возвращаемое значение:
//  Произвольный
//
Функция Настройка(Ключ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.кбп_Настройки.СоздатьМенеджерЗаписи();
	Запись.Ключ = Ключ;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Значение = Запись.Значение.Получить();
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат НастройкиПоУмолчанию()[Ключ];

КонецФункции

// Записывает настройку продукта.
//
// Параметры:
//  Ключ - Строка
//  Значение - Произвольный
//
Процедура УстановитьНастройку(Ключ, Значение) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.кбп_Настройки.СоздатьМенеджерЗаписи();
	Запись.Ключ = Ключ;
	Запись.Значение = Новый ХранилищеЗначения(Значение);
	Запись.Записать();

КонецПроцедуры

// Ключи настроек и значения по умолчанию.
//
// Возвращаемое значение:
//  Соответствие - ключ → значение.
//
Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Соответствие;
	Настройки.Вставить("МаксимальнаяГлубинаВложенности", 20);
	Настройки.Вставить("СрокХраненияЖурналаДней", 0);
	Настройки.Вставить("ОтправлятьПочту", Истина);
	Настройки.Вставить("АдминистраторПроцессов", Неопределено);
	Настройки.Вставить("ПроизводственныйКалендарь", Неопределено);
	Настройки.Вставить("НачалоРабочегоДня", 9);
	Настройки.Вставить("ОкончаниеРабочегоДня", 18);
	Возврат Настройки;

КонецФункции

#Область ПравилаЗапуска

// Подписка «кбп_ПриЗаписиОбъекта» (все документы и справочники): автозапуск по событию «При записи» (ФТ-108).
// Процесс не запускается в транзакции записи: запуск ставится в очередь и выполняется после фиксации,
// поэтому ошибка схемы не мешает записать объект.
//
// Параметры:
//  Источник - ДокументОбъект, СправочникОбъект
//  Отказ - Булево
//
Процедура ПриЗаписиОбъекта(Источник, Отказ) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ПоставитьАвтозапуски(Источник, Перечисления.кбп_СобытияЗапуска.Запись);

КонецПроцедуры

// Подписка «кбп_ПриПроведенииДокумента» (все документы): автозапуск по событию «При проведении».
//
// Параметры:
//  Источник - ДокументОбъект
//  Отказ - Булево
//  РежимПроведения - РежимПроведенияДокумента
//
Процедура ОбработкаПроведенияДокумента(Источник, Отказ, РежимПроведения) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ПоставитьАвтозапуски(Источник, Перечисления.кбп_СобытияЗапуска.Проведение);

КонецПроцедуры

// Правило запуска разрешает запуск: оно активно, предмет не в исключениях, условие выполнено.
//
// Параметры:
//  Схема - СправочникСсылка.кбп_СхемыПроцессов
//  Событие - ПеречислениеСсылка.кбп_СобытияЗапуска
//  Контекст - Структура - Предмет, Автор, Переменные (для условия).
//
// Возвращаемое значение:
//  Булево
//
Функция АвтозапускРазрешен(Схема, Событие, Контекст) Экспорт

	Предмет = Контекст.Предмет;
	Для Каждого Исключение Из Схема.ИсключенияЗапуска Цикл
		Если Не ЗначениеЗаполнено(Исключение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Исключение.Значение = Контекст.Автор Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЗначениеЗаполнено(Предмет) Тогда
			Сравниваемое = ?(ЗначениеЗаполнено(Исключение.ПутьКРеквизиту),
				кбп_Адресация.ЗначениеПоПути(Контекст, Исключение.ПутьКРеквизиту), Предмет);
			Если Сравниваемое = Исключение.Значение Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Правило Из Схема.ПравилаЗапуска Цикл
		Если Правило.Событие <> Событие Или Не Правило.Активно Тогда
			Продолжить;
		КонецЕсли;
		Если Не кбп_Условия.УсловиеЗаполнено(Правило.Условие)
			Или кбп_Условия.ОтборВыполняется(Правило.Условие, Контекст) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Активные правила «По расписанию» опубликованных схем без предмета.
//
// Возвращаемое значение:
//  Массив из Структура - Схема, Ключ (строка для времени последнего запуска), Расписание.
//
Функция ПравилаПоРасписанию() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Расписание", Перечисления.кбп_СобытияЗапуска.Расписание);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Ссылка КАК Схема,
	|	Правила.НомерСтроки КАК НомерСтроки,
	|	Правила.Расписание КАК Расписание
	|ИЗ
	|	Справочник.кбп_СхемыПроцессов.ПравилаЗапуска КАК Правила
	|ГДЕ
	|	Правила.Событие = &Расписание
	|	И Правила.Активно
	|	И НЕ Правила.Ссылка.ПометкаУдаления
	|	И Правила.Ссылка.ТекущаяВерсия <> ЗНАЧЕНИЕ(Справочник.кбп_ВерсииСхем.ПустаяСсылка)
	|	И Правила.Ссылка.ТипПредмета = """"";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Расписание = Выборка.Расписание.Получить();
		Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания") Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Схема, Ключ, Расписание", Выборка.Схема,
			XMLСтрока(Выборка.Схема) + "/" + Формат(Выборка.НомерСтроки, "ЧГ=0"), Расписание));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пересчитывает кэш правил автозапуска схемы (кбп_ПравилаЗапуска): правила «При записи» и «При проведении»
// опубликованной схемы с предметом.
//
// Параметры:
//  Схема - СправочникСсылка.кбп_СхемыПроцессов
//
Процедура ОбновитьПравилаЗапуска(Схема) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.кбп_ПравилаЗапуска.СоздатьНаборЗаписей();
	Набор.Отбор.Схема.Установить(Схема);
	События = Перечисления.кбп_СобытияЗапуска;
	Если ЗначениеЗаполнено(Схема.ТекущаяВерсия) И ЗначениеЗаполнено(Схема.ТипПредмета) И Не Схема.ПометкаУдаления Тогда
		Добавленные = Новый Соответствие;
		Для Каждого Правило Из Схема.ПравилаЗапуска Цикл
			Если Не Правило.Активно Или Правило.Событие = События.Расписание Или Добавленные[Правило.Событие] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Добавленные.Вставить(Правило.Событие, Истина);
			Запись = Набор.Добавить();
			Запись.ТипПредмета = Схема.ТипПредмета;
			Запись.Схема = Схема;
			Запись.Событие = Правило.Событие;
		КонецЦикла;
	КонецЕсли;
	Набор.Записать();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПоставитьАвтозапуски(Источник, Событие)

	ПолноеИмя = Источник.Метаданные().ПолноеИмя();
	Если кбп_ПроцессыПовтИсп.ТипыСПравиламиЗапуска().Получить(ПолноеИмя) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипПредмета", ПолноеИмя);
	Запрос.УстановитьПараметр("Событие", Событие);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Схема КАК Схема
	|ИЗ
	|	РегистрСведений.кбп_ПравилаЗапуска КАК Правила
	|ГДЕ
	|	Правила.ТипПредмета = &ТипПредмета
	|	И Правила.Событие = &Событие";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		кбп_Движок.ПоставитьАвтозапуск(Выборка.Схема, Источник.Ссылка, Событие);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
