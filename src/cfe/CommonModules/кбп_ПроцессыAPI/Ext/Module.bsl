#Область ПрограммныйИнтерфейс

// Запускает процесс по текущей опубликованной версии схемы.
//
// Параметры:
//  Схема - СправочникСсылка.кбп_СхемыПроцессов
//  Предмет - ЛюбаяСсылка, Неопределено
//  Переменные - Структура, Соответствие, Неопределено - значения переменных по имени.
//  Родитель - Неопределено - зарезервировано; вложенные процессы запускает шаг «Вложенный процесс» схемы.
//
// Возвращаемое значение:
//  СправочникСсылка.кбп_Процессы
//
Функция ЗапуститьПроцесс(Схема, Предмет = Неопределено, Переменные = Неопределено, Родитель = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Родитель) Тогда
		ВызватьИсключение НСтр("ru = 'Вложенный процесс запускается шагом «Вложенный процесс» схемы родителя.'");
	КонецЕсли;
	Возврат кбп_Движок.ЗапуститьПроцесс(Схема, Предмет, Переменные);

КонецФункции

// Выполняет задачу нажатием кнопки.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  ИдКнопки - Строка
//  Комментарий - Строка
//  ЗначенияПолей - Структура, Соответствие, Неопределено - поля к заполнению: имя переменной → значение.
//
// Возвращаемое значение:
//  Структура - Выполнено (Булево).
//
Функция ВыполнитьДействие(Задача, ИдКнопки, Комментарий = "", ЗначенияПолей = Неопределено) Экспорт

	кбп_Движок.ВыполнитьЗадачу(Задача, ИдКнопки, Комментарий, ЗначенияПолей);
	Возврат Новый Структура("Выполнено", Истина);

КонецФункции

// Возвращает задачу на доработку.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  ИдШагаВозврата - СправочникСсылка.кбп_ЭлементыСхем, Строка - шаг или его ИдЭлемента.
//  Комментарий - Строка
//
// Возвращаемое значение:
//  Структура - Выполнено (Булево).
//
Функция ВернутьНаДоработку(Задача, ИдШагаВозврата, Комментарий) Экспорт

	Шаг = ИдШагаВозврата;
	Если ТипЗнч(ИдШагаВозврата) = Тип("Строка") Тогда
		Шаг = Справочники.кбп_ЭлементыСхем.ПустаяСсылка();
		Для Каждого ЭлементСписка Из кбп_Движок.ШагиДляВозврата(Задача) Цикл
			Если ЭлементСписка.Значение.ИдЭлемента = ИдШагаВозврата Тогда
				Шаг = ЭлементСписка.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	кбп_Движок.ВернутьНаДоработку(Задача, Шаг, Комментарий);
	Возврат Новый Структура("Выполнено", Истина);

КонецФункции

// Переадресует задачу другому пользователю (ФТ-309), если это разрешено на шаге.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  НовыйИсполнитель - СправочникСсылка.Пользователи
//  Комментарий - Строка - обязателен.
//
Процедура Переадресовать(Задача, НовыйИсполнитель, Комментарий) Экспорт
	кбп_Движок.ПереадресоватьЗадачу(Задача, НовыйИсполнитель, Комментарий);
КонецПроцедуры

// Добавляет комментарий в ленту процесса.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Текст - Строка
//  Задача - СправочникСсылка.кбп_Задачи, Неопределено
//  Файлы - Неопределено - вложения, этап 3.
//
Процедура ДобавитьКомментарий(Процесс, Текст, Задача = Неопределено, Файлы = Неопределено) Экспорт
	кбп_Движок.ДобавитьКомментарий(Процесс, Текст, Задача);
КонецПроцедуры

// Прерывает процесс.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Комментарий - Строка
//
Процедура ПрерватьПроцесс(Процесс, Комментарий) Экспорт
	кбп_Движок.ПрерватьПроцесс(Процесс, Комментарий);
КонецПроцедуры

// Приостанавливает активный процесс (ФТ-901): задачи нельзя выполнить, таймеры ждут. Автор или администратор.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Комментарий - Строка
//
Процедура ПриостановитьПроцесс(Процесс, Комментарий = "") Экспорт
	кбп_Движок.ПриостановитьПроцесс(Процесс, Комментарий);
КонецПроцедуры

// Продолжает приостановленный процесс (автор или администратор) или процесс с ошибкой (администратор).
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Комментарий - Строка
//
Процедура ПродолжитьПроцесс(Процесс, Комментарий = "") Экспорт
	кбп_Движок.ПродолжитьПроцесс(Процесс, Комментарий);
КонецПроцедуры

// Переводит процесс на шаг той же версии схемы (ФТ-901). Только администратор, комментарий обязателен.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Шаг - СправочникСсылка.кбп_ЭлементыСхем
//  Комментарий - Строка
//  ИдМаркера - Строка - какую ветку перевести; пусто — единственную (или новую, если веток нет).
//
Процедура ПеревестиНаШаг(Процесс, Шаг, Комментарий, ИдМаркера = "") Экспорт

	Если Не ЗначениеЗаполнено(ИдМаркера) Тогда
		Маркеры = кбп_Движок.МаркерыПроцесса(Процесс);
		Если Маркеры.Количество() > 1 Тогда
			ВызватьИсключение НСтр("ru = 'У процесса несколько веток: укажите, какую перевести.'");
		ИначеЕсли Маркеры.Количество() = 1 Тогда
			ИдМаркера = Маркеры[0].ИдМаркера;
		КонецЕсли;
	КонецЕсли;
	кбп_Движок.ПеревестиНаШаг(Процесс, ИдМаркера, Шаг, Комментарий);

КонецПроцедуры

// Активные процессы по предмету.
//
// Параметры:
//  Предмет - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.кбп_Процессы
//
Функция АктивныеПроцессыПредмета(Предмет) Экспорт
	Возврат кбп_Движок.АктивныеПроцессыПредмета(Предмет);
КонецФункции

// Задачи пользователя.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//  Отбор - Структура, Неопределено - ВключаяВыполненные (Булево).
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. кбп_Движок.ЗадачиПользователя.
//
Функция ЗадачиПользователя(Пользователь, Отбор = Неопределено) Экспорт

	ВключаяВыполненные = Ложь;
	Если Отбор <> Неопределено Тогда
		Отбор.Свойство("ВключаяВыполненные", ВключаяВыполненные);
	КонецЕсли;
	Возврат кбп_Движок.ЗадачиПользователя(Пользователь, ВключаяВыполненные = Истина);

КонецФункции

// Состояние процесса и его активные задачи.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//
// Возвращаемое значение:
//  Структура - Состояние (ПеречислениеСсылка.кбп_СостоянияПроцессов), Задачи (ТаблицаЗначений).
//
Функция СостояниеПроцесса(Процесс) Экспорт

	Задачи = кбп_Движок.ЗадачиПроцесса(Процесс);
	Активные = Задачи.СкопироватьКолонки();
	Для Каждого СтрокаЗадачи Из Задачи Цикл
		Если кбп_Движок.СостоянияАктивных().Найти(СтрокаЗадачи.Состояние) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Активные.Добавить(), СтрокаЗадачи);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Состояние, Задачи", Процесс.Состояние, Активные);

КонецФункции

#КонецОбласти
