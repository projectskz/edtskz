#Область ПрограммныйИнтерфейс

// Запускает процесс по текущей опубликованной версии схемы (Архитектура п. 6.1).
//
// Параметры:
//  Схема - СправочникСсылка.кбп_СхемыПроцессов
//  Предмет - ЛюбаяСсылка, Неопределено - объект, по которому идёт процесс.
//  Переменные - Соответствие, Структура, Неопределено - начальные значения переменных по имени.
//  Комментарий - Строка - комментарий автора при запуске.
//
// Возвращаемое значение:
//  СправочникСсылка.кбп_Процессы
//
Функция ЗапуститьПроцесс(Схема, Предмет = Неопределено, Переменные = Неопределено, Комментарий = "") Экспорт

	Если Не кбп_Лицензирование.ДоступноДействие("ЗапускПроцесса") Тогда
		ВызватьИсключение НСтр("ru = 'Запуск процессов недоступен по условиям лицензии.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Схема) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана схема процесса.'");
	КонецЕсли;
	Версия = Схема.ТекущаяВерсия;
	Если Не ЗначениеЗаполнено(Версия) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У схемы «%1» нет опубликованной версии.'"), Схема);
	КонецЕсли;
	ПроверитьПредмет(Схема, Предмет);

	Отказ = Ложь;
	кбп_ПроцессыПереопределяемый.ПередЗапускомПроцесса(Схема, Предмет, Переменные, Отказ);
	Если Отказ Тогда
		ВызватьИсключение НСтр("ru = 'Запуск процесса отменён.'");
	КонецЕсли;

	Автор = кбп_АдаптерКонфигурации.ТекущийПользователь();

	НачатьТранзакцию();
	Попытка
		Ссылка = СоздатьПроцесс(Схема, Версия, Предмет, Переменные, Комментарий, Автор);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗапуститьОбработкуОчереди();
	кбп_Оповещения.ЗапуститьОтправку();
	Возврат Ссылка;

КонецФункции

// Выполняет задачу нажатием кнопки (Архитектура п. 6.2, 8.1).
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  ИдКнопки - Строка - идентификатор кнопки из кбп_Действия.КнопкиЗадачи.
//  Комментарий - Строка
//  ЗначенияПолей - Соответствие, Структура, Неопределено - значения полей к заполнению (имя переменной → значение),
//                  см. ПоляЗадачи.
//
Процедура ВыполнитьЗадачу(Задача, ИдКнопки, Комментарий = "", ЗначенияПолей = Неопределено) Экспорт

	Процесс = Задача.Процесс;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ПроверитьВыполнениеЗадачи(ЗадачаОбъект);
		Контекст = НовыйКонтекст(Процесс);
		ВыполнитьЗадачуВКонтексте(Контекст, ЗадачаОбъект, ИдКнопки, Комментарий, ЗначенияПолей, Ложь);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗапуститьОбработкуОчереди();
	кбп_Оповещения.ЗапуститьОтправку();

КонецПроцедуры

// Переадресует задачу другому пользователю (ФТ-309): задача закрывается состоянием «Переадресована»,
// новый исполнитель получает такую же задачу того же шага.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  НовыйИсполнитель - СправочникСсылка.Пользователи
//  Комментарий - Строка - обязателен.
//
Процедура ПереадресоватьЗадачу(Задача, НовыйИсполнитель, Комментарий) Экспорт

	Если Не ЗначениеЗаполнено(НовыйИсполнитель) Тогда
		ВызватьИсключение НСтр("ru = 'Выберите, кому переадресовать задачу.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ВызватьИсключение НСтр("ru = 'Напишите, почему задача переадресуется.'");
	КонецЕсли;
	Процесс = Задача.Процесс;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ПроверитьВыполнениеЗадачи(ЗадачаОбъект);
		Если Не ЗадачаОбъект.Шаг.РазрешенаПереадресация И Не кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов() Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'На шаге «%1» переадресация не разрешена.'"), ЗадачаОбъект.Шаг);
		КонецЕсли;
		Если НовыйИсполнитель = ЗадачаОбъект.Назначенный Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Задача уже назначена пользователю %1.'"), НовыйИсполнитель);
		КонецЕсли;
		Контекст = НовыйКонтекст(Процесс);
		Контекст.Задача = Задача;
		ПередатьЗадачу(Контекст, ЗадачаОбъект, НовыйИсполнитель, Комментарий,
			СтрШаблон(НСтр("ru = '%1 → %2'"), ЗадачаОбъект.Назначенный, НовыйИсполнитель));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗапуститьОбработкуОчереди();
	кбп_Оповещения.ЗапуститьОтправку();

КонецПроцедуры

// Кнопка задачи с действием «Запустить вложенный процесс» (ФТ-502): запускает процесс по схеме кнопки
// с тем же предметом, без ожидания. Задача остаётся открытой.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  ИдКнопки - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.кбп_Процессы
//
Функция ЗапуститьПроцессИзЗадачи(Задача, ИдКнопки) Экспорт

	Процесс = Задача.Процесс;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ПроверитьВыполнениеЗадачи(ЗадачаОбъект);
		Кнопка = кбп_Действия.НайтиКнопку(ЗадачаОбъект.Шаг, ИдКнопки);
		Если Кнопка = Неопределено Или Кнопка.Действие <> Перечисления.кбп_ВидыДействий.ЗапуститьВложенный
			Или Не ЗначениеЗаполнено(Кнопка.ВложеннаяСхема) Тогда
			ВызватьИсключение НСтр("ru = 'У кнопки не указана схема запускаемого процесса.'");
		КонецЕсли;
		Схема = Кнопка.ВложеннаяСхема;
		Если Не ЗначениеЗаполнено(Схема.ТекущаяВерсия) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'У схемы «%1» нет опубликованной версии.'"), Схема);
		КонецЕсли;
		Контекст = НовыйКонтекст(Процесс);
		Контекст.Задача = Задача;
		Родитель = Новый Структура("Процесс, Шаг, ИдМаркера, Корень, Уровень",
			Процесс, ЗадачаОбъект.Шаг, "", Процесс.КорневойПроцесс, Процесс.УровеньВложенности + 1);
		Дочерний = СоздатьПроцесс(Схема, Схема.ТекущаяВерсия, Контекст.Предмет, Неопределено,
			СтрШаблон(НСтр("ru = 'Запущен из задачи «%1» кнопкой «%2»'"), Задача, Кнопка.Заголовок), Контекст.Пользователь, Родитель);
		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ВложенныйЗапущен, ЗадачаОбъект.Шаг, Задача, , ИдКнопки,
			СтрШаблон(НСтр("ru = '%1 (кнопка «%2»)'"), Дочерний, Кнопка.Заголовок));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗапуститьОбработкуОчереди();
	кбп_Оповещения.ЗапуститьОтправку();
	Возврат Дочерний;

КонецФункции

// Контекст процесса для вычисления условий видимости кнопок задачи (без изменения данных).
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//
// Возвращаемое значение:
//  Структура - см. НовыйКонтекст.
//
Функция КонтекстЗадачи(Задача) Экспорт

	Контекст = НовыйКонтекст(Задача.Процесс);
	Контекст.Задача = Задача;
	Возврат Контекст;

КонецФункции

// Возвращает задачу на один из пройденных шагов (ФТ-404, Архитектура п. 6.4).
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//  ШагВозврата - СправочникСсылка.кбп_ЭлементыСхем - из ШагиДляВозврата.
//  Комментарий - Строка - обязателен.
//
Процедура ВернутьНаДоработку(Задача, ШагВозврата, Комментарий) Экспорт

	Если Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите, что нужно доработать.'");
	КонецЕсли;
	Процесс = Задача.Процесс;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		Шаг = ЗадачаОбъект.Шаг;
		ПроверитьВыполнениеЗадачи(ЗадачаОбъект);
		Если Не Шаг.РазрешенВозврат Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'На шаге «%1» возврат не разрешён.'"), Шаг);
		КонецЕсли;
		Если ШагиДляВозврата(Задача).НайтиПоЗначению(ШагВозврата) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Вернуть на шаг «%1» нельзя.'"), ШагВозврата);
		КонецЕсли;

		Контекст = НовыйКонтекст(Процесс);
		Контекст.Задача = Задача;
		Контекст.Комментарий = Комментарий;

		ЗадачаОбъект.Состояние = Перечисления.кбп_СостоянияЗадач.Возвращена;
		ЗадачаОбъект.Исполнитель = Контекст.Пользователь;
		ЗадачаОбъект.ДатаВыполнения = ТекущаяДатаСеанса();
		ЗадачаОбъект.Результат = кбп_Действия.ИдКнопкиВозврата();
		ЗадачаОбъект.Комментарий = Комментарий;
		ЗадачаОбъект.Записать();
		ОтменитьЗадачиМаркера(Контекст, ЗадачаОбъект.ИдМаркера, Задача, Перечисления.кбп_СостоянияЗадач.Возвращена);

		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Возврат, Шаг, Задача, Комментарий,
			кбп_Действия.ИдКнопкиВозврата(), СтрШаблон(НСтр("ru = 'на шаг «%1»'"), ШагВозврата), ЗадачаОбъект.Назначенный);

		// Шаг возврата пройден этим маркером или маркером до разделения (Архитектура п. 6.4, шаг 6):
		// возврат за точку разделения закрывает все ветки этого разделения.
		ИдМаркера = МаркерШагаВЛинии(Процесс, ЗадачаОбъект.ИдМаркера, ШагВозврата);
		Маркер = ПрочитатьМаркер(Процесс, ИдМаркера);
		Маркер.Итерация = Маркер.Итерация + 1;
		Маркер.ОжидаетсяВеток = 0;
		Маркер.ПришлоВеток = 0;
		Если ИдМаркера = ЗадачаОбъект.ИдМаркера
			И Шаг.РежимВозврата = Перечисления.кбп_РежимыВозврата.ВернутьНаВернувшего Тогда
			Маркер.ВернутьНа = Шаг;
		Иначе
			Маркер.ВернутьНа = Справочники.кбп_ЭлементыСхем.ПустаяСсылка();
		КонецЕсли;
		Маркер.Записать();
		Если ИдМаркера <> ЗадачаОбъект.ИдМаркера Тогда
			ЗакрытьВетки(Контекст, ИдМаркера, Перечисления.кбп_СостоянияЗадач.Отменена);
		КонецЕсли;

		Контекст.Возврат = Истина;
		ВойтиВШаг(Контекст, ИдМаркера, ШагВозврата, "");

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗапуститьОбработкуОчереди();
	кбп_Оповещения.ЗапуститьОтправку();

КонецПроцедуры

// Шаги, на которые можно вернуть задачу: пройденные задачи процесса, пересечённые с настройкой шага.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//
// Возвращаемое значение:
//  СписокЗначений - значение: СправочникСсылка.кбп_ЭлементыСхем, представление: наименование шага.
//
Функция ШагиДляВозврата(Задача) Экспорт

	Результат = Новый СписокЗначений;
	Шаг = Задача.Шаг;
	Если Не Шаг.РазрешенВозврат Тогда
		Возврат Результат;
	КонецЕсли;

	// Пройденные шаги своей ветки и шаги до разделения; шаги соседних параллельных веток не предлагаются.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Задача.Процесс);
	Запрос.УстановитьПараметр("Шаг", Шаг);
	Запрос.УстановитьПараметр("Выполненные", СостоянияВыполненных());
	Запрос.УстановитьПараметр("Маркеры", ЛинияМаркера(Задача.Процесс, Задача.ИдМаркера));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Шаг КАК Шаг,
	|	МИНИМУМ(Задачи.ДатаСоздания) КАК ДатаСоздания
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.Шаг <> &Шаг
	|	И Задачи.Состояние В (&Выполненные)
	|	И Задачи.ИдМаркера В (&Маркеры)
	|	И НЕ Задачи.ЭтоКопия
	|
	|СГРУППИРОВАТЬ ПО
	|	Задачи.Шаг
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания";
	Разрешенные = Шаг.ШагиВозврата.ВыгрузитьКолонку("Шаг");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Разрешенные.Количество() = 0 Или Разрешенные.Найти(Выборка.Шаг) <> Неопределено Тогда
			Результат.Добавить(Выборка.Шаг, Строка(Выборка.Шаг));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отмечает задачу принятой к исполнению (ФТ-411). При «Взять в работу» снимает остальные задачи шага.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//
Процедура ПринятьКИсполнению(Задача) Экспорт

	Процесс = Задача.Процесс;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ПроверитьВыполнениеЗадачи(ЗадачаОбъект);
		Если ЗадачаОбъект.ПринятаКИсполнению Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		Контекст = НовыйКонтекст(Процесс);
		ЗадачаОбъект.ПринятаКИсполнению = Истина;
		ЗадачаОбъект.ПринялКИсполнению = Контекст.Пользователь;
		ЗадачаОбъект.ДатаПринятия = ТекущаяДатаСеанса();
		ЗадачаОбъект.Состояние = Перечисления.кбп_СостоянияЗадач.ВРаботе;
		ЗадачаОбъект.Записать();
		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ЗадачаПринята, ЗадачаОбъект.Шаг, Задача, , , ,
			ЗадачаОбъект.Назначенный);

		Если ЗадачаОбъект.Шаг.ВзятьВРаботу Тогда
			ОтменитьЗадачиМаркера(Контекст, ЗадачаОбъект.ИдМаркера, Задача, Перечисления.кбп_СостоянияЗадач.Отменена);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Прерывает процесс: активные задачи отменяются, маркеры закрываются.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Комментарий - Строка
//
Процедура ПрерватьПроцесс(Процесс, Комментарий) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		Контекст = НовыйКонтекст(Процесс);
		Если Не МожноУправлятьПроцессом(Процесс, Контекст.Пользователь) Тогда
			ВызватьИсключение НСтр("ru = 'Прервать процесс может его автор или администратор процессов.'");
		КонецЕсли;
		Если Не ПроцессАктивен(Процесс) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Процесс уже в состоянии «%1».'"), Процесс.Состояние);
		КонецЕсли;
		ПрерватьВТранзакции(Контекст, Комментарий);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗапуститьОбработкуОчереди();
	кбп_Оповещения.ЗапуститьОтправку();

КонецПроцедуры

// Добавляет комментарий в ленту процесса (ФТ-405).
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Текст - Строка
//  Задача - СправочникСсылка.кбп_Задачи, Неопределено
//
Процедура ДобавитьКомментарий(Процесс, Текст, Задача = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПроцесс(Процесс);
		Контекст = НовыйКонтекст(Процесс);
		Шаг = Неопределено;
		Если ЗначениеЗаполнено(Задача) Тогда
			Шаг = Задача.Шаг;
		КонецЕсли;
		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Комментарий, Шаг, Задача, Текст);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Лента процесса: история и комментарии.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//
// Возвращаемое значение:
//  ТаблицаЗначений - Момент, Пользователь, ЗаКого, Событие, Шаг, Задача, Текст.
//
Функция ЖурналПроцесса(Процесс) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.Момент КАК Момент,
	|	Журнал.НомерЗаписи КАК НомерЗаписи,
	|	Журнал.ВидЗаписи КАК ВидЗаписи,
	|	Журнал.Пользователь КАК Пользователь,
	|	Журнал.ЗаКого КАК ЗаКого,
	|	Журнал.Шаг КАК Шаг,
	|	Журнал.Задача КАК Задача,
	|	Журнал.Комментарий КАК Комментарий,
	|	Журнал.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.кбп_ЖурналПроцессов КАК Журнал
	|ГДЕ
	|	Журнал.Процесс = &Процесс
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаписи";
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Момент");
	Результат.Колонки.Добавить("Пользователь");
	Результат.Колонки.Добавить("Событие");
	Результат.Колонки.Добавить("Шаг");
	Результат.Колонки.Добавить("Задача");
	Результат.Колонки.Добавить("Текст");
	Результат.Колонки.Добавить("ЭтоКомментарий");
	Пока Выборка.Следующий() Цикл
		СтрокаЖурнала = Результат.Добавить();
		СтрокаЖурнала.Момент = Выборка.Момент;
		СтрокаЖурнала.Пользователь = Строка(Выборка.Пользователь);
		Если ЗначениеЗаполнено(Выборка.ЗаКого) И Выборка.ЗаКого <> Выборка.Пользователь Тогда
			СтрокаЖурнала.Пользователь = СтрШаблон(НСтр("ru = '%1 (за %2)'"), Выборка.Пользователь, Выборка.ЗаКого);
		КонецЕсли;
		СтрокаЖурнала.Событие = Строка(Выборка.ВидЗаписи);
		СтрокаЖурнала.Шаг = Выборка.Шаг;
		СтрокаЖурнала.Задача = Выборка.Задача;
		СтрокаЖурнала.ЭтоКомментарий = (Выборка.ВидЗаписи = Перечисления.кбп_ВидыЗаписейЖурнала.Комментарий);
		Части = Новый Массив;
		Если ЗначениеЗаполнено(Выборка.Данные) Тогда
			Части.Добавить(Выборка.Данные);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Комментарий) Тогда
			Части.Добавить(Выборка.Комментарий);
		КонецЕсли;
		СтрокаЖурнала.Текст = СтрСоединить(Части, ": ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Задачи процесса для формы процесса.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Наименование, Назначенный, Исполнитель, Состояние, ДатаСоздания, Срок, ДатаВыполнения, Результат.
//
Функция ЗадачиПроцесса(Процесс) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Назначенный КАК Назначенный,
	|	Задачи.Исполнитель КАК Исполнитель,
	|	Задачи.Состояние КАК Состояние,
	|	Задачи.ДатаСоздания КАК ДатаСоздания,
	|	Задачи.Срок КАК Срок,
	|	Задачи.ДатаВыполнения КАК ДатаВыполнения,
	|	Задачи.Результат КАК Результат,
	|	Задачи.Шаг КАК Шаг
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания";
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из Результат Цикл
		СтрокаТаблицы.Результат = кбп_Действия.ЗаголовокКнопки(СтрокаТаблицы.Шаг, СтрокаТаблицы.Результат);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Активные задачи пользователя («Мои задачи»).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//  ВключаяВыполненные - Булево - добавить выполненные за последние 30 дней.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Наименование, Процесс, Схема, ПредставлениеПредмета, Предмет, Состояние, ДатаСоздания, Срок,
//                    Просрочена, Активна, Назначенный, ЗаКого (замещаемый, если задача чужая — ФТ-304).
//
Функция ЗадачиПользователя(Пользователь, ВключаяВыполненные = Ложь) Экспорт

	// Свои задачи и активные задачи замещаемых (с учётом области замещения).
	Замещаемые = кбп_Адресация.ЗамещаемыеПользователем(Пользователь);
	Назначенные = Замещаемые.ВыгрузитьКолонку("Замещаемый");
	Назначенные.Добавить(Пользователь);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Назначенные", Назначенные);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивных());
	Запрос.УстановитьПараметр("ВключаяВыполненные", ВключаяВыполненные);
	Запрос.УстановитьПараметр("ДатаОтбора", ТекущаяДатаСеанса() - 30 * 86400);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Процесс КАК Процесс,
	|	Задачи.Процесс.Схема КАК Схема,
	|	Задачи.Предмет КАК Предмет,
	|	Задачи.ПредставлениеПредмета КАК ПредставлениеПредмета,
	|	Задачи.Состояние КАК Состояние,
	|	Задачи.ДатаСоздания КАК ДатаСоздания,
	|	Задачи.Срок КАК Срок,
	|	Задачи.Процесс.Автор КАК Автор,
	|	Задачи.Назначенный КАК Назначенный,
	|	Задачи.Роль КАК Роль,
	|	ВЫБОР
	|		КОГДА Задачи.Состояние В (&Активные)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Активна,
	|	ВЫБОР
	|		КОГДА Задачи.Состояние В (&Активные)
	|				И Задачи.Срок <> ДАТАВРЕМЯ(1, 1, 1)
	|				И Задачи.Срок < &Сейчас
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Просрочена
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Назначенный В (&Назначенные)
	|	И НЕ Задачи.ПометкаУдаления
	|	И (Задачи.Состояние В (&Активные)
	|			ИЛИ &ВключаяВыполненные
	|				И Задачи.ДатаВыполнения >= &ДатаОтбора
	|				И (Задачи.Назначенный = &Пользователь
	|					ИЛИ Задачи.Исполнитель = &Пользователь))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Активна УБЫВ,
	|	ДатаСоздания УБЫВ";
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("ЗаКого");
	Если Замещаемые.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Индекс = Результат.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаЗадачи = Результат[Индекс];
		Индекс = Индекс - 1;
		Если СтрокаЗадачи.Назначенный = Пользователь Тогда
			Продолжить;
		КонецЕсли;
		ПоОбласти = Ложь;
		Для Каждого Замещение Из Замещаемые Цикл
			Если Замещение.Замещаемый = СтрокаЗадачи.Назначенный
				И (Не ЗначениеЗаполнено(Замещение.Роль) Или Замещение.Роль = СтрокаЗадачи.Роль)
				И (Не ЗначениеЗаполнено(Замещение.Схема) Или Замещение.Схема = СтрокаЗадачи.Схема) Тогда
				ПоОбласти = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПоОбласти Тогда
			СтрокаЗадачи.ЗаКого = СтрокаЗадачи.Назначенный;
		Иначе
			Результат.Удалить(СтрокаЗадачи);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Процессы, запущенные пользователем.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Схема, ПредставлениеПредмета, Состояние, ДатаСтарта, ДатаЗавершения, ТекущиеШаги.
//
Функция ПроцессыАвтора(Пользователь) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Пользователь);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивных());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Процессы.Ссылка КАК Ссылка,
	|	Процессы.Схема КАК Схема,
	|	Процессы.ПредставлениеПредмета КАК ПредставлениеПредмета,
	|	Процессы.Состояние КАК Состояние,
	|	Процессы.ДатаСтарта КАК ДатаСтарта,
	|	Процессы.ДатаЗавершения КАК ДатаЗавершения
	|ПОМЕСТИТЬ ВТПроцессы
	|ИЗ
	|	Справочник.кбп_Процессы КАК Процессы
	|ГДЕ
	|	Процессы.Автор = &Автор
	|	И НЕ Процессы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Процессы.ДатаСтарта УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПроцессы.Ссылка КАК Ссылка,
	|	ВТПроцессы.Схема КАК Схема,
	|	ВТПроцессы.ПредставлениеПредмета КАК ПредставлениеПредмета,
	|	ВТПроцессы.Состояние КАК Состояние,
	|	ВТПроцессы.ДатаСтарта КАК ДатаСтарта,
	|	ВТПроцессы.ДатаЗавершения КАК ДатаЗавершения
	|ИЗ
	|	ВТПроцессы КАК ВТПроцессы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСтарта УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Задачи.Процесс КАК Процесс,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Назначенный КАК Назначенный
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс В
	|			(ВЫБРАТЬ
	|				ВТПроцессы.Ссылка
	|			ИЗ
	|				ВТПроцессы)
	|	И Задачи.Состояние В (&Активные)";
	Результаты = Запрос.ВыполнитьПакет();
	Результат = Результаты[1].Выгрузить();
	Результат.Колонки.Добавить("ТекущиеШаги", Новый ОписаниеТипов("Строка"));
	Результат.Индексы.Добавить("Ссылка");
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПроцесса = Результат.Найти(Выборка.Процесс, "Ссылка");
		Если СтрокаПроцесса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Текст = СтрШаблон("%1 (%2)", Выборка.Наименование, Выборка.Назначенный);
		СтрокаПроцесса.ТекущиеШаги = ?(ПустаяСтрока(СтрокаПроцесса.ТекущиеШаги), Текст, СтрокаПроцесса.ТекущиеШаги + "; " + Текст);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Активные процессы по предмету.
//
// Параметры:
//  Предмет - ЛюбаяСсылка
//  Схема - СправочникСсылка.кбп_СхемыПроцессов, Неопределено - отбор по схеме.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.кбп_Процессы
//
Функция АктивныеПроцессыПредмета(Предмет, Схема = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Предмет", Предмет);
	Запрос.УстановитьПараметр("Схема", Схема);
	Запрос.УстановитьПараметр("БезОтбораПоСхеме", Не ЗначениеЗаполнено(Схема));
	Запрос.УстановитьПараметр("Активные", СостоянияАктивныхПроцессов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Процессы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.кбп_Процессы КАК Процессы
	|ГДЕ
	|	Процессы.Предмет = &Предмет
	|	И Процессы.Состояние В (&Активные)
	|	И (&БезОтбораПоСхеме
	|			ИЛИ Процессы.Схема = &Схема)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Может ли текущий пользователь выполнить задачу (назначенный или администратор процессов).
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи, СправочникОбъект.кбп_Задачи
//
// Возвращаемое значение:
//  Булево
//
Функция МожноВыполнитьЗадачу(Задача) Экспорт

	Если Задача.ЭтоКопия Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СостоянияАктивных().Найти(Задача.Состояние) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Задача.Процесс.Состояние <> Перечисления.кбп_СостоянияПроцессов.Активен Тогда
		Возврат Ложь;
	КонецЕсли;
	Пользователь = кбп_АдаптерКонфигурации.ТекущийПользователь();
	Возврат Задача.Назначенный = Пользователь Или кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов()
		Или кбп_Адресация.ЗамещениеДляЗадачи(Задача, Пользователь) <> Неопределено;

КонецФункции

// Может ли пользователь прервать процесс (автор или администратор процессов).
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - текущий.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноУправлятьПроцессом(Процесс, Пользователь = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Пользователь = кбп_АдаптерКонфигурации.ТекущийПользователь();
	КонецЕсли;
	Возврат Процесс.Автор = Пользователь Или кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов();

КонецФункции

// Состояние шагов процесса для подсветки схемы (ФТ-110).
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//
// Возвращаемое значение:
//  Соответствие - ИдЭлемента шага → "Пройденный" или "Текущий".
//
Функция СостоянияШаговПроцесса(Процесс) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("Завершен", Перечисления.кбп_СостоянияМаркеров.Завершен);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Журнал.Шаг.ИдЭлемента КАК ИдЭлемента
	|ИЗ
	|	РегистрСведений.кбп_ЖурналПроцессов КАК Журнал
	|ГДЕ
	|	Журнал.Процесс = &Процесс
	|	И Журнал.Шаг <> ЗНАЧЕНИЕ(Справочник.кбп_ЭлементыСхем.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Маркеры.Шаг.ИдЭлемента КАК ИдЭлемента
	|ИЗ
	|	РегистрСведений.кбп_Маркеры КАК Маркеры
	|ГДЕ
	|	Маркеры.Процесс = &Процесс
	|	И Маркеры.Состояние <> &Завершен
	|	И Маркеры.ОжидаетсяВеток = 0";
	Результаты = Запрос.ВыполнитьПакет();
	Состояния = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояния.Вставить(Выборка.ИдЭлемента, "Пройденный");
	КонецЦикла;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояния.Вставить(Выборка.ИдЭлемента, "Текущий");
	КонецЦикла;
	Возврат Состояния;

КонецФункции

// Состояния задач, в которых задачу можно выполнить.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.кбп_СостоянияЗадач
//
Функция СостоянияАктивных() Экспорт

	Состояния = Новый Массив;
	Состояния.Добавить(Перечисления.кбп_СостоянияЗадач.Ожидает);
	Состояния.Добавить(Перечисления.кбп_СостоянияЗадач.ВРаботе);
	Возврат Состояния;

КонецФункции

// Процессы по предмету — для формы «Процессы по объекту» (ФТ-408).
//
// Параметры:
//  Предмет - ЛюбаяСсылка
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Состояние, ДатаСтарта, Сейчас (строка: у кого задачи, таймеры).
//
Функция ПроцессыПредмета(Предмет) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Предмет", Предмет);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Процессы.Ссылка КАК Ссылка,
	|	Процессы.Состояние КАК Состояние,
	|	Процессы.ДатаСтарта КАК ДатаСтарта
	|ИЗ
	|	Справочник.кбп_Процессы КАК Процессы
	|ГДЕ
	|	Процессы.Предмет = &Предмет
	|	И НЕ Процессы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСтарта УБЫВ";
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("Сейчас", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаПроцесса Из Результат Цикл
		Если СтрокаПроцесса.Состояние = Перечисления.кбп_СостоянияПроцессов.Активен Тогда
			СтрокаПроцесса.Сейчас = СтрСоединить(ТекущееСостояние(СтрокаПроцесса.Ссылка), "; ");
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Активные задачи пользователя (и замещаемых им) по предмету.
//
// Параметры:
//  Предмет - ЛюбаяСсылка
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ЗадачиПользователя.
//
Функция ЗадачиПредметаПользователя(Предмет, Пользователь) Экспорт

	Задачи = ЗадачиПользователя(Пользователь);
	Индекс = Задачи.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Задачи[Индекс].Предмет <> Предмет Тогда
			Задачи.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Задачи;

КонецФункции

// Выполняет наступившие отложенные действия: таймеры и продолжение родителей после вложенных процессов.
// Вызывается регламентным заданием, фоновым заданием после операции и командой в карточке процесса.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы, Неопределено - только действия этого процесса.
//  НеЖдатьСрока - Булево - выполнить и те действия, срок которых ещё не наступил (таймеры «сейчас»).
//
// Возвращаемое значение:
//  Число - сколько действий выполнено.
//
Функция ОбработатьОчередьДействий(Процесс = Неопределено, НеЖдатьСрока = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ожидает", Перечисления.кбп_СтатусыОчереди.Ожидает);
	Запрос.УстановитьПараметр("Сейчас", ?(НеЖдатьСрока, Дата(3999, 12, 31), ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("ВсеПроцессы", Не ЗначениеЗаполнено(Процесс));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Очередь.Ид КАК Ид,
	|	Очередь.ВыполнитьПосле КАК ВыполнитьПосле
	|ИЗ
	|	РегистрСведений.кбп_ОчередьДействий КАК Очередь
	|ГДЕ
	|	Очередь.Статус = &Ожидает
	|	И Очередь.ВыполнитьПосле <= &Сейчас
	|	И (&ВсеПроцессы
	|			ИЛИ Очередь.Процесс = &Процесс)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВыполнитьПосле";
	Выполнено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВыполнитьОтложенноеДействие(Выборка.Ид) Тогда
			Выполнено = Выполнено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Процесс) Тогда
		Выполнено = Выполнено + ЗапуститьПоРасписанию();
	КонецЕсли;
	Если Выполнено > 0 Тогда
		кбп_Оповещения.ЗапуститьОтправку();
	КонецЕсли;
	Возврат Выполнено;

КонецФункции

// Окончание замещений (ФТ-305): задачи, которые замещающий принял к исполнению, возвращаются замещаемому
// (если так задано в документе), участникам уходит оповещение. Каждое замещение обрабатывается один раз.
Процедура ЗавершитьЗамещения() Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Запрос.УстановитьПараметр("Неделя", Сейчас - 7 * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Замещения.Регистратор КАК Документ,
	|	Замещения.Замещаемый КАК Замещаемый,
	|	Замещения.Замещающий КАК Замещающий,
	|	Замещения.ВозвращатьЗадачи КАК ВозвращатьЗадачи
	|ИЗ
	|	РегистрСведений.кбп_Замещения КАК Замещения
	|ГДЕ
	|	Замещения.Активность
	|	И Замещения.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|	И Замещения.ДатаОкончания < &Сейчас
	|	И Замещения.ДатаОкончания >= &Неделя";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = "ЗамещениеЗавершено/" + XMLСтрока(Выборка.Документ);
		Если кбп_ПроцессыСлужебный.Настройка(Ключ) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если Выборка.ВозвращатьЗадачи Тогда
			ВернутьЗадачиЗамещаемому(Выборка.Замещаемый, Выборка.Замещающий);
		КонецЕсли;
		кбп_Оповещения.ОповеститьОЗамещении(Выборка.Документ, Перечисления.кбп_СобытияПроцессов.ЗамещениеЗакончилось);
		кбп_ПроцессыСлужебный.УстановитьНастройку(Ключ, Истина);
	КонецЦикла;
	кбп_Оповещения.ЗапуститьОтправку();

КонецПроцедуры

// Запускает фоновую обработку очереди действий, если в ней есть наступившие действия (после фиксации операции).
Процедура ЗапуститьОбработкуОчереди() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ожидает", Перечисления.кбп_СтатусыОчереди.Ожидает);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.кбп_ОчередьДействий КАК Очередь
	|ГДЕ
	|	Очередь.Статус = &Ожидает
	|	И Очередь.ВыполнитьПосле <= &Сейчас";
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ФоновыеЗадания.Выполнить("кбп_Движок.ОбработатьОчередьДействий", , "кбп_ОбработкаОчередиДействий",
			НСтр("ru = 'Конструктор процессов: отложенные действия'"));
	Исключение
		// Задание уже выполняется или фоновые задания недоступны — выполнит регламентное задание.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы.Очередь действий'"), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Поля к заполнению на шаге задачи (ФТ-403): переменные процесса.
//
// Параметры:
//  Задача - СправочникСсылка.кбп_Задачи
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Заголовок, ТипЗначения (ОписаниеТипов), Значение, Обязательное, ТолькоПросмотр.
//
Функция ПоляЗадачи(Задача) Экспорт

	Результат = Новый Массив;
	Шаг = Задача.Шаг;
	Если Шаг.ПоляЗаполнения.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Переменные = ПеременныеПроцесса(Задача.Процесс);
	Для Каждого Поле Из Шаг.ПоляЗаполнения Цикл
		Переменная = Поле.Переменная;
		Если Не ЗначениеЗаполнено(Переменная) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("Имя, Заголовок, ТипЗначения, Значение, Обязательное, ТолькоПросмотр");
		Описание.Имя = Переменная.Имя;
		Описание.Заголовок = ?(ЗначениеЗаполнено(Поле.Заголовок), Поле.Заголовок, Переменная.Наименование);
		Описание.ТипЗначения = Переменная.ТипЗначения;
		Описание.Значение = Переменные[Переменная.Имя];
		Описание.Обязательное = Поле.Обязательное;
		Описание.ТолькоПросмотр = Поле.ТолькоПросмотр;
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что сейчас происходит в процессе — для карточки процесса.
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//
// Возвращаемое значение:
//  Массив из Строка - «Задача «X» — у Иванова», «Таймер «Y» — до …», «Вложенный процесс «Z» — …».
//
Функция ТекущееСостояние(Процесс) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивных());
	Запрос.УстановитьПараметр("АктивныеПроцессы", СостоянияАктивныхПроцессов());
	Запрос.УстановитьПараметр("Ожидает", Перечисления.кбп_СтатусыОчереди.Ожидает);
	Запрос.УстановитьПараметр("Таймер", Перечисления.кбп_ВидыОтложенныхДействий.Таймер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Назначенный КАК Назначенный,
	|	Задачи.Срок КАК Срок
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.Состояние В (&Активные)
	|	И НЕ Задачи.ЭтоКопия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Очередь.ВыполнитьПосле КАК ВыполнитьПосле,
	|	Маркеры.Шаг КАК Шаг
	|ИЗ
	|	РегистрСведений.кбп_ОчередьДействий КАК Очередь
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.кбп_Маркеры КАК Маркеры
	|		ПО Очередь.Процесс = Маркеры.Процесс
	|			И Очередь.ИдМаркера = Маркеры.ИдМаркера
	|ГДЕ
	|	Очередь.Процесс = &Процесс
	|	И Очередь.Статус = &Ожидает
	|	И Очередь.Вид = &Таймер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Процессы.Ссылка КАК Ссылка,
	|	Процессы.ШагРодителя КАК ШагРодителя
	|ИЗ
	|	Справочник.кбп_Процессы КАК Процессы
	|ГДЕ
	|	Процессы.РодительскийПроцесс = &Процесс
	|	И Процессы.Состояние В (&АктивныеПроцессы)";
	Результаты = Запрос.ВыполнитьПакет();
	Строки = Новый Массив;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = СтрШаблон(НСтр("ru = 'Задача «%1» — у %2'"), Выборка.Наименование, Выборка.Назначенный);
		Если ЗначениеЗаполнено(Выборка.Срок) Тогда
			Текст = Текст + СтрШаблон(НСтр("ru = ', срок %1'"), Формат(Выборка.Срок, "ДЛФ=DT"));
		КонецЕсли;
		Строки.Добавить(Текст);
	КонецЦикла;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Таймер «%1» — ждёт до %2'"), Выборка.Шаг, Формат(Выборка.ВыполнитьПосле, "ДЛФ=DT")));
	КонецЦикла;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Вложенный процесс «%1» (шаг «%2»)'"), Выборка.Ссылка, Выборка.ШагРодителя));
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Родитель и вложенные процессы (дерево по корню, ФТ-706).
//
// Параметры:
//  Процесс - СправочникСсылка.кбп_Процессы
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Состояние, ШагРодителя, РодительскийПроцесс, УровеньВложенности, ДатаСтарта, ЭтоТекущий.
//
Функция ДеревоПроцесса(Процесс) Экспорт

	Корень = Процесс.КорневойПроцесс;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Корень", ?(ЗначениеЗаполнено(Корень), Корень, Процесс));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Процессы.Ссылка КАК Ссылка,
	|	Процессы.Состояние КАК Состояние,
	|	Процессы.ШагРодителя КАК ШагРодителя,
	|	Процессы.РодительскийПроцесс КАК РодительскийПроцесс,
	|	Процессы.УровеньВложенности КАК УровеньВложенности,
	|	Процессы.ДатаСтарта КАК ДатаСтарта
	|ИЗ
	|	Справочник.кбп_Процессы КАК Процессы
	|ГДЕ
	|	(Процессы.КорневойПроцесс = &Корень
	|			ИЛИ Процессы.Ссылка = &Корень)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УровеньВложенности,
	|	ДатаСтарта";
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("ЭтоТекущий", Новый ОписаниеТипов("Булево"));
	Для Каждого СтрокаДерева Из Результат Цикл
		СтрокаДерева.ЭтоТекущий = (СтрокаДерева.Ссылка = Процесс);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Маршрут

// Выбирает переход из шага и входит в следующий шаг (Архитектура п. 6.2).
Процедура ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки)

	Переход = ВыбратьПереход(Контекст, Шаг, ИдКнопки);
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переход, Переход.Куда, , , ИдКнопки,
		СтрШаблон("%1 → %2", Шаг, Переход.Куда));
	ВойтиВШаг(Контекст, ИдМаркера, Переход.Куда, ИдКнопки);

КонецПроцедуры

Процедура ВойтиВШаг(Контекст, ИдМаркера, Шаг, ИдКнопки)

	Контекст.Переходов = Контекст.Переходов + 1;
	Если Контекст.Переходов > 1000 Тогда
		ВызватьИсключение НСтр("ru = 'Схема зациклилась: больше 1000 автоматических переходов без задач.'");
	КонецЕсли;

	Типы = Перечисления.кбп_ТипыШагов;
	Состояния = Перечисления.кбп_СостоянияМаркеров;
	ТипШага = Шаг.ТипШага;
	Если ТипШага = Типы.Задача Тогда
		ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Состояния.Ожидает);
		СоздатьЗадачи(Контекст, ИдМаркера, Шаг);

	ИначеЕсли ТипШага = Типы.Условие Или ТипШага = Типы.ВыборВарианта Тогда
		ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Состояния.Активен);
		ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки);

	ИначеЕсли ТипШага = Типы.Обработка Тогда
		ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Состояния.Активен);
		Если ЗначениеЗаполнено(Шаг.Обработчик) Тогда
			кбп_Действия.ВыполнитьОбработчик(Шаг.Обработчик, Контекст);
			СохранитьПеременные(Контекст);
		КонецЕсли;
		ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки);

	ИначеЕсли ТипШага = Типы.Разделение Тогда
		РазделитьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки);

	ИначеЕсли ТипШага = Типы.Слияние Тогда
		СлитьВетку(Контекст, ИдМаркера, Шаг, ИдКнопки);

	ИначеЕсли ТипШага = Типы.Таймер Тогда
		ЗапуститьТаймер(Контекст, ИдМаркера, Шаг, ИдКнопки);

	ИначеЕсли ТипШага = Типы.ВложенныйПроцесс Тогда
		ЗапуститьВложенный(Контекст, ИдМаркера, Шаг, ИдКнопки);

	ИначеЕсли ТипШага = Типы.Завершение Тогда
		ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Состояния.Завершен);
		// Завершение закрывает процесс целиком, даже если другие ветки ещё идут (проверка схемы это запрещает).
		// Асинхронные вложенные процессы продолжают работать.
		ЗакрытьМаркерыПроцесса(Контекст, Перечисления.кбп_СостоянияЗадач.Отменена, Ложь);
		ЗавершитьПроцесс(Контекст, Шаг);

	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Шаг «%1» типа «%2» не поддерживается этой версией программы.'"), Шаг, ТипШага);
	КонецЕсли;

КонецПроцедуры

// Переход по кнопке, по подписи, по условию или «по умолчанию».
Функция ВыбратьПереход(Контекст, Шаг, ИдКнопки)

	Выходы = ВыходыШага(Шаг);
	Если Выходы.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Из шага «%1» нет исходящих линий.'"), Шаг);
	КонецЕсли;
	Типы = Перечисления.кбп_ТипыШагов;
	ЭтоРазвилка = (Шаг.ТипШага = Типы.Условие Или Шаг.ТипШага = Типы.ВыборВарианта);
	Если Выходы.Количество() = 1 И Шаг.ТипШага <> Типы.Условие Тогда
		Возврат Выходы[0];
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдКнопки) Тогда
		ПереходКнопки = "";
		Если Шаг.ТипШага = Типы.Задача Тогда
			ПереходКнопки = кбп_Действия.ПереходКнопки(Шаг, ИдКнопки);
		КонецЕсли;
		Для Каждого Выход Из Выходы Цикл
			Если Выход.ИдПерехода = ИдКнопки Или Выход.ИдКнопки = ИдКнопки
				Или ЗначениеЗаполнено(ПереходКнопки) И Выход.ИдПерехода = ПереходКнопки Тогда
				Возврат Выход;
			КонецЕсли;
		КонецЦикла;

		// Развилка после задачи: ветка, подпись которой (или название варианта) совпадает с нажатой кнопкой.
		Если ЭтоРазвилка И Контекст.Задача <> Неопределено Тогда
			Заголовок = НРег(СокрЛП(кбп_Действия.ЗаголовокКнопки(Контекст.Задача.Шаг, ИдКнопки)));
			Для Каждого Выход Из Выходы Цикл
				Если ЗначениеЗаполнено(Заголовок) И (НРег(СокрЛП(Выход.Наименование)) = Заголовок
					Или НРег(СокрЛП(Выход.НаименованиеВарианта)) = Заголовок) Тогда
					Возврат Выход;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Для Каждого Выход Из Выходы Цикл
		Если ЕстьУсловие(Выход) И УсловиеЛинииВыполняется(Контекст, Выход) Тогда
			Возврат Выход;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Выход Из Выходы Цикл
		Если Выход.ПоУмолчанию Тогда
			Возврат Выход;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Не удалось выбрать ветку после шага «%1» (кнопка «%2»): ни одно условие не выполнено и нет линии «По умолчанию».'"),
		Шаг, ИдКнопки);

КонецФункции

Функция ЕстьУсловие(Выход)
	Возврат ЗначениеЗаполнено(Выход.ВидУсловия) И Выход.ВидУсловия <> Перечисления.кбп_ВидыУсловий.Нет;
КонецФункции

// Условие линии: обработчик или отбор (Архитектура п. 4.1). Линия без условия считается выполненной.
Функция УсловиеЛинииВыполняется(Контекст, Выход)

	ВидыУсловий = Перечисления.кбп_ВидыУсловий;
	Если Не ЕстьУсловие(Выход) Тогда
		Возврат Истина;
	ИначеЕсли Выход.ВидУсловия = ВидыУсловий.Обработчик Тогда
		Возврат кбп_Условия.УсловиеВыполняется(Выход.ОбработчикУсловия, Контекст);
	ИначеЕсли Выход.ВидУсловия = ВидыУсловий.Отбор Тогда
		Возврат кбп_Условия.ОтборВыполняется(Выход.Условие, Контекст);
	КонецЕсли;
	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Условие вида «%1» на линии «%2» будет поддерживаться с этапа 6.'"), Выход.ВидУсловия, Выход.Наименование);

КонецФункции

// Исходящие линии шага по порядку.
//
// Параметры:
//  Шаг - СправочникСсылка.кбп_ЭлементыСхем
//
// Возвращаемое значение:
//  ТаблицаЗначений - ИдПерехода, Куда, Наименование, ПоУмолчанию, ВидУсловия, ОбработчикУсловия, Условие, ИдКнопки,
//                    Порядок, Вариант, НаименованиеВарианта.
//
Функция ВыходыШага(Шаг) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Шаг", Шаг);
	Запрос.УстановитьПараметр("Версия", Шаг.Владелец);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переходы.ИдПерехода КАК ИдПерехода,
	|	Переходы.Куда КАК Куда,
	|	Переходы.Наименование КАК Наименование,
	|	Переходы.ПоУмолчанию КАК ПоУмолчанию,
	|	Переходы.ВидУсловия КАК ВидУсловия,
	|	Переходы.ОбработчикУсловия КАК ОбработчикУсловия,
	|	Переходы.Условие КАК Условие,
	|	Переходы.ИдКнопки КАК ИдКнопки,
	|	Переходы.Порядок КАК Порядок,
	|	Переходы.Вариант КАК Вариант,
	|	ЕСТЬNULL(Переходы.Вариант.Наименование, """") КАК НаименованиеВарианта
	|ИЗ
	|	РегистрСведений.кбп_ПереходыСхем КАК Переходы
	|ГДЕ
	|	Переходы.Версия = &Версия
	|	И (Переходы.Откуда = &Шаг
	|			ИЛИ Переходы.Вариант = &Шаг)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ШагСтарт(Версия)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("Старт", Перечисления.кбп_ТипыШагов.Старт);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Элементы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.кбп_ЭлементыСхем КАК Элементы
	|ГДЕ
	|	Элементы.Владелец = &Версия
	|	И Элементы.ТипШага = &Старт
	|	И НЕ Элементы.ПометкаУдаления
	|	И НЕ Элементы.НетНаСхеме";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В версии «%1» нет шага Старт.'"), Версия);
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

// Выполненная задача завершает шаг: «каждому» — после всех задач (или сразу по кнопке вида «Опасная»),
// «любому из» — сразу; остальные задачи шага отменяются.
Процедура ЗавершитьШагИПродвинуть(Контекст, ЗадачаОбъект, Кнопка)

	ИдМаркера = ЗадачаОбъект.ИдМаркера;
	Шаг = ЗадачаОбъект.Шаг;
	Каждому = (Шаг.РежимНазначения <> Перечисления.кбп_РежимыНазначения.ЛюбомуИз);
	Если Каждому И Кнопка.Вид <> Перечисления.кбп_ВидыКнопок.Опасная
		И ОставшиесяЗадачиМаркера(Контекст.Процесс, ИдМаркера, ЗадачаОбъект.Ссылка).Количество() > 0 Тогда
		Возврат; // ждём остальных исполнителей
	КонецЕсли;
	ОтменитьЗадачиМаркера(Контекст, ИдМаркера, ЗадачаОбъект.Ссылка, Перечисления.кбп_СостоянияЗадач.Отменена);

	Маркер = ПрочитатьМаркер(Контекст.Процесс, ИдМаркера);
	ВернутьНа = Маркер.ВернутьНа;
	Если ЗначениеЗаполнено(ВернутьНа) Тогда
		// После доработки — сразу на вернувший шаг (режим «Вернуть на вернувший шаг»).
		Маркер.ВернутьНа = Справочники.кбп_ЭлементыСхем.ПустаяСсылка();
		Маркер.Записать();
		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переход, ВернутьНа, , , Кнопка.ИдКнопки,
			СтрШаблон(НСтр("ru = '%1 → %2 (после доработки)'"), Шаг, ВернутьНа));
		ВойтиВШаг(Контекст, ИдМаркера, ВернутьНа, Кнопка.ИдКнопки);
	Иначе
		ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, Кнопка.ИдКнопки);
	КонецЕсли;

КонецПроцедуры

Процедура ЗавершитьПроцесс(Контекст, Шаг)

	ПроцессОбъект = Контекст.Процесс.ПолучитьОбъект();
	ПроцессОбъект.Состояние = Перечисления.кбп_СостоянияПроцессов.Завершен;
	ПроцессОбъект.ДатаЗавершения = ТекущаяДатаСеанса();
	ПроцессОбъект.Записать();
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Завершение, Шаг);
	кбп_Оповещения.ОповеститьОПроцессе(Контекст.Процесс, Перечисления.кбп_СобытияПроцессов.ПроцессЗавершен);
	кбп_ПроцессыПереопределяемый.ПриЗавершенииПроцесса(Контекст.Процесс);
	Если ЗначениеЗаполнено(ПроцессОбъект.РодительскийПроцесс) Тогда
		ПриЗавершенииВложенного(Контекст.Процесс);
	КонецЕсли;

КонецПроцедуры

// Прерывание: задачи отменяются, маркеры и отложенные действия закрываются, вложенные процессы прерываются.
Процедура ПрерватьВТранзакции(Контекст, Комментарий, Каскадно = Ложь)

	Процесс = Контекст.Процесс;
	ЗакрытьМаркерыПроцесса(Контекст, Перечисления.кбп_СостоянияЗадач.Отменена);

	ПроцессОбъект = Процесс.ПолучитьОбъект();
	ПроцессОбъект.Состояние = Перечисления.кбп_СостоянияПроцессов.Прерван;
	ПроцессОбъект.ДатаЗавершения = ТекущаяДатаСеанса();
	ПроцессОбъект.Записать();
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Прерывание, , , Комментарий,
		, ?(Каскадно, НСтр("ru = 'прерван вместе с родительским процессом'"), ""));
	кбп_Оповещения.ОповеститьОПроцессе(Процесс, Перечисления.кбп_СобытияПроцессов.ПроцессПрерван);

	Если Не Каскадно И ЗначениеЗаполнено(ПроцессОбъект.РодительскийПроцесс) Тогда
		ПриПрерыванииВложенного(Процесс);
	КонецЕсли;

КонецПроцедуры

// Закрывает все маркеры процесса: активные задачи и отложенные действия отменяются, вложенные процессы прерываются.
Процедура ЗакрытьМаркерыПроцесса(Контекст, СостояниеЗадач, ПрерыватьВложенные = Истина)

	Процесс = Контекст.Процесс;
	Для Каждого Задача Из АктивныеЗадачиПроцесса(Процесс) Цикл
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ЗадачаОбъект.Состояние = СостояниеЗадач;
		ЗадачаОбъект.Записать();
	КонецЦикла;
	ОтменитьОтложенныеДействия(Процесс, Неопределено);
	Если ПрерыватьВложенные Тогда
		ПрерватьВложенные(Процесс, Неопределено);
	КонецЕсли;

	Набор = РегистрыСведений.кбп_Маркеры.СоздатьНаборЗаписей();
	Набор.Отбор.Процесс.Установить(Процесс);
	Набор.Прочитать();
	Для Каждого Запись Из Набор Цикл
		Запись.Состояние = Перечисления.кбп_СостоянияМаркеров.Завершен;
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры

#КонецОбласти

#Область Ветки

// Разделение: маркер ждёт на шаге, по каждой исходящей линии (с выполненным условием) идёт своя ветка.
Процедура РазделитьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки)

	Ветки = Новый Массив;
	Для Каждого Выход Из ВыходыШага(Шаг) Цикл
		Если УсловиеЛинииВыполняется(Контекст, Выход) Тогда
			Ветки.Добавить(Выход);
		КонецЕсли;
	КонецЦикла;
	Если Ветки.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'После разделения «%1» ни одна ветка не выполняется по условиям.'"), Шаг);
	КонецЕсли;

	Маркер = ПрочитатьМаркер(Контекст.Процесс, ИдМаркера);
	Маркер.Шаг = Шаг;
	Маркер.Состояние = Перечисления.кбп_СостоянияМаркеров.Ожидает;
	Маркер.ОжидаетсяВеток = Ветки.Количество();
	Маркер.ПришлоВеток = 0;
	Маркер.Записать();

	// Сначала создаются все ветки, потом они продвигаются: ветка может сразу дойти до слияния
	// и (в режиме «любая») закрыть остальные.
	ИдВеток = Новый Массив;
	Для Каждого Выход Из Ветки Цикл
		ИдВетки = Строка(Новый УникальныйИдентификатор);
		Ветка = ПрочитатьМаркер(Контекст.Процесс, ИдВетки);
		Ветка.Шаг = Шаг;
		Ветка.Состояние = Перечисления.кбп_СостоянияМаркеров.Активен;
		Ветка.РодительскийМаркер = ИдМаркера;
		Ветка.Ветка = Выход.ИдПерехода;
		Ветка.Итерация = Маркер.Итерация;
		Ветка.ДатаСоздания = ТекущаяДатаСеанса();
		Ветка.Записать();
		ИдВеток.Добавить(ИдВетки);
	КонецЦикла;

	Для Индекс = 0 По Ветки.ВГраница() Цикл
		Ветка = ПрочитатьМаркер(Контекст.Процесс, ИдВеток[Индекс]);
		Если Ветка.Состояние = Перечисления.кбп_СостоянияМаркеров.Завершен Тогда
			Продолжить;
		КонецЕсли;
		Выход = Ветки[Индекс];
		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переход, Выход.Куда, , , ИдКнопки,
			СтрШаблон(НСтр("ru = '%1 → %2 (параллельная ветка %3 из %4)'"), Шаг, Выход.Куда, Индекс + 1, Ветки.Количество()));
		ВойтиВШаг(Контекст, ИдВеток[Индекс], Выход.Куда, ИдКнопки);
	КонецЦикла;

КонецПроцедуры

// Слияние: ветка закрывается; когда пришло нужное число веток, остальные закрываются, а маркер разделения идёт дальше.
Процедура СлитьВетку(Контекст, ИдМаркера, Шаг, ИдКнопки)

	Состояния = Перечисления.кбп_СостоянияМаркеров;
	Маркер = ПрочитатьМаркер(Контекст.Процесс, ИдМаркера);
	ИдРодителя = Маркер.РодительскийМаркер;
	Если Не ЗначениеЗаполнено(ИдРодителя) Тогда
		// Слияние без разделения (например, сходятся ветки Условия) — просто проходим дальше.
		ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Состояния.Активен);
		ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки);
		Возврат;
	КонецЕсли;

	Маркер.Шаг = Шаг;
	Маркер.Состояние = Состояния.Завершен;
	Маркер.Записать();

	Родитель = ПрочитатьМаркер(Контекст.Процесс, ИдРодителя);
	Родитель.ПришлоВеток = Родитель.ПришлоВеток + 1;
	Нужно = ЧислоВетокДляСлияния(Шаг, Родитель.ОжидаетсяВеток);
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переход, Шаг, , , ИдКнопки,
		СтрШаблон(НСтр("ru = 'Ветка дошла до «%1»: %2 из %3'"), Шаг, Родитель.ПришлоВеток, Нужно));
	Если Родитель.ПришлоВеток < Нужно Тогда
		Родитель.Записать();
		Возврат;
	КонецЕсли;

	Родитель.Шаг = Шаг;
	Родитель.Состояние = Состояния.Активен;
	Родитель.ОжидаетсяВеток = 0;
	Родитель.ПришлоВеток = 0;
	Родитель.Записать();
	ЗакрытьВетки(Контекст, ИдРодителя, Перечисления.кбп_СостоянияЗадач.Отменена);
	ПродвинутьМаркер(Контекст, ИдРодителя, Шаг, ИдКнопки);

КонецПроцедуры

Функция ЧислоВетокДляСлияния(Шаг, Ожидается)

	Режимы = Перечисления.кбп_РежимыСлияния;
	Если Шаг.РежимСлияния = Режимы.Любая Тогда
		Возврат 1;
	ИначеЕсли Шаг.РежимСлияния = Режимы.NизM Тогда
		Возврат Макс(1, Мин(Шаг.КоличествоДляСлияния, Ожидается));
	КонецЕсли;
	Возврат Макс(1, Ожидается);

КонецФункции

// Закрывает ветки маркера (все вложенные уровни): задачи, отложенные действия, вложенные процессы, маркеры.
Процедура ЗакрытьВетки(Контекст, ИдМаркера, СостояниеЗадач)

	Процесс = Контекст.Процесс;
	Для Каждого ИдВетки Из ВеткиМаркера(Процесс, ИдМаркера) Цикл
		ОтменитьЗадачиМаркера(Контекст, ИдВетки, Справочники.кбп_Задачи.ПустаяСсылка(), СостояниеЗадач);
		ОтменитьОтложенныеДействия(Процесс, ИдВетки);
		ПрерватьВложенные(Процесс, ИдВетки);
		Ветка = ПрочитатьМаркер(Процесс, ИдВетки);
		Если Ветка.Выбран() И Ветка.Состояние <> Перечисления.кбп_СостоянияМаркеров.Завершен Тогда
			Ветка.Состояние = Перечисления.кбп_СостоянияМаркеров.Завершен;
			Ветка.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Идентификаторы всех маркеров-потомков (ветки, ветки веток, …).
Функция ВеткиМаркера(Процесс, ИдМаркера)

	Дети = ДетиМаркеров(Процесс);
	Результат = Новый Массив;
	Очередь = Новый Массив;
	Очередь.Добавить(ИдМаркера);
	Индекс = 0;
	Пока Индекс < Очередь.Количество() Цикл
		Список = Дети[Очередь[Индекс]];
		Индекс = Индекс + 1;
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИдВетки Из Список Цикл
			Результат.Добавить(ИдВетки);
			Очередь.Добавить(ИдВетки);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДетиМаркеров(Процесс)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Маркеры.ИдМаркера КАК ИдМаркера,
	|	Маркеры.РодительскийМаркер КАК РодительскийМаркер
	|ИЗ
	|	РегистрСведений.кбп_Маркеры КАК Маркеры
	|ГДЕ
	|	Маркеры.Процесс = &Процесс
	|	И Маркеры.РодительскийМаркер <> """"";
	Дети = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Дети[Выборка.РодительскийМаркер];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Дети.Вставить(Выборка.РодительскийМаркер, Список);
		КонецЕсли;
		Список.Добавить(Выборка.ИдМаркера);
	КонецЦикла;
	Возврат Дети;

КонецФункции

// Маркер и его предки (маркеры разделений, из которых вышла ветка).
Функция ЛинияМаркера(Процесс, ИдМаркера)

	Результат = Новый Массив;
	Текущий = ИдМаркера;
	Пока ЗначениеЗаполнено(Текущий) И Результат.Найти(Текущий) = Неопределено Цикл
		Результат.Добавить(Текущий);
		Текущий = ПрочитатьМаркер(Процесс, Текущий).РодительскийМаркер;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Маркер из линии маркера, который последним прошёл шаг (для возврата за точку разделения).
Функция МаркерШагаВЛинии(Процесс, ИдМаркера, Шаг)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("Шаг", Шаг);
	Запрос.УстановитьПараметр("Маркеры", ЛинияМаркера(Процесс, ИдМаркера));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Задачи.ИдМаркера КАК ИдМаркера
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.Шаг = &Шаг
	|	И Задачи.ИдМаркера В (&Маркеры)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.ДатаСоздания УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ИдМаркера, ИдМаркера);

КонецФункции

#КонецОбласти

#Область Таймер

// Таймер: маркер ждёт до срока, срабатывание — регламентным заданием (ОбработатьОчередьДействий).
Процедура ЗапуститьТаймер(Контекст, ИдМаркера, Шаг, ИдКнопки)

	Срок = СрокТаймера(Шаг, Контекст);
	Если Срок <= ТекущаяДатаСеанса() Тогда
		ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Перечисления.кбп_СостоянияМаркеров.Активен);
		ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки);
		Возврат;
	КонецЕсли;
	ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Перечисления.кбп_СостоянияМаркеров.Ожидает);
	ПоставитьВОчередь(Контекст.Процесс, Перечисления.кбп_ВидыОтложенныхДействий.Таймер, ИдМаркера, Срок,
		Новый Структура("Шаг, ИдКнопки", Шаг, ИдКнопки));
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переход, Шаг, , , ,
		СтрШаблон(НСтр("ru = 'Таймер «%1»: ожидание до %2'"), Шаг, Формат(Срок, "ДЛФ=DT")));

КонецПроцедуры

Функция СрокТаймера(Шаг, Контекст)

	Если ЗначениеЗаполнено(Шаг.ТаймерИзПеременной) Тогда
		Значение = Контекст.Переменные[Шаг.ТаймерИзПеременной.Имя];
		Возврат ?(ТипЗнч(Значение) = Тип("Дата"), Значение, ТекущаяДатаСеанса());
	КонецЕсли;
	Возврат ДобавитьСрок(ТекущаяДатаСеанса(), Шаг.ТаймерЗначение, Шаг.ТаймерЕдиница);

КонецФункции

Процедура ПоставитьВОчередь(Процесс, Вид, ИдМаркера, ВыполнитьПосле, ПараметрыДействия, Задача = Неопределено)

	Запись = РегистрыСведений.кбп_ОчередьДействий.СоздатьМенеджерЗаписи();
	Запись.Ид = Строка(Новый УникальныйИдентификатор);
	Запись.Вид = Вид;
	Если ЗначениеЗаполнено(Процесс) Тогда
		Запись.Процесс = Процесс;
	КонецЕсли;
	Если ЗначениеЗаполнено(Задача) Тогда
		Запись.Задача = Задача;
	КонецЕсли;
	Запись.ИдМаркера = ИдМаркера;
	Запись.ВыполнитьПосле = ВыполнитьПосле;
	Запись.Статус = Перечисления.кбп_СтатусыОчереди.Ожидает;
	Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Запись.Параметры = Новый ХранилищеЗначения(ПараметрыДействия);
	Запись.Записать();

КонецПроцедуры

// Отменяет ожидающие отложенные действия процесса (или одного маркера).
Процедура ОтменитьОтложенныеДействия(Процесс, ИдМаркера)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("ИдМаркера", ИдМаркера);
	Запрос.УстановитьПараметр("ВсеМаркеры", ИдМаркера = Неопределено);
	Запрос.УстановитьПараметр("Ожидает", Перечисления.кбп_СтатусыОчереди.Ожидает);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.кбп_ОчередьДействий КАК Очередь
	|ГДЕ
	|	Очередь.Процесс = &Процесс
	|	И Очередь.Статус = &Ожидает
	|	И (&ВсеМаркеры
	|			ИЛИ Очередь.ИдМаркера = &ИдМаркера)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.кбп_ОчередьДействий.СоздатьМенеджерЗаписи();
		Запись.Ид = Выборка.Ид;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Отменено;
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Автозапуск процесса по правилу схемы (запись или проведение предмета, ФТ-108): проверки выполняются
// на момент запуска — активность правила, исключения, условие, второй экземпляр.
Функция ВыполнитьАвтозапуск(ПараметрыДействия)

	Схема = ПараметрыДействия.Схема;
	Предмет = ПараметрыДействия.Предмет;
	Если Не ЗначениеЗаполнено(Схема) Или Не ЗначениеЗаполнено(Схема.ТекущаяВерсия) Тогда
		Возврат Ложь;
	КонецЕсли;
	Контекст = Новый Структура("Процесс, Предмет, Автор, Пользователь, Переменные, Задача, ИдКнопки",
		Неопределено, Предмет, ПараметрыДействия.Автор, ПараметрыДействия.Автор, Новый Соответствие, Неопределено, "");
	Если Не кбп_ПроцессыСлужебный.АвтозапускРазрешен(Схема, ПараметрыДействия.Событие, Контекст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Предмет) И АктивныеПроцессыПредмета(Предмет, Схема).Количество() > 0
		И (Схема.ЗапретВторогоЭкземпляра Или ПараметрыДействия.Событие <> Перечисления.кбп_СобытияЗапуска.Расписание) Тогда
		// Повторная запись или перепроведение предмета не запускает второй процесс по тому же правилу.
		Возврат Ложь;
	КонецЕсли;
	СоздатьПроцесс(Схема, Схема.ТекущаяВерсия, Предмет, Неопределено,
		СтрШаблон(НСтр("ru = 'Автозапуск: %1'"), НРег(Строка(ПараметрыДействия.Событие))), ПараметрыДействия.Автор);
	Возврат Истина;

КонецФункции

// Запуск процессов по расписанию (ФТ-108): правила «По расписанию» схем без предмета.
// Время последнего запуска хранится в кбп_Настройки.
Функция ЗапуститьПоРасписанию()

	Запущено = 0;
	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Правило Из кбп_ПроцессыСлужебный.ПравилаПоРасписанию() Цикл
		Ключ = "ЗапускПоРасписанию/" + Правило.Ключ;
		Последний = кбп_ПроцессыСлужебный.Настройка(Ключ);
		Последний = ?(ТипЗнч(Последний) = Тип("Дата"), Последний, Дата(1, 1, 1));
		Если Не Правило.Расписание.ТребуетсяВыполнение(Сейчас, Последний) Тогда
			Продолжить;
		КонецЕсли;
		кбп_ПроцессыСлужебный.УстановитьНастройку(Ключ, Сейчас);
		ПоставитьВОчередь(Неопределено, Перечисления.кбп_ВидыОтложенныхДействий.ЗапускПоРасписанию, "", Сейчас,
			Новый Структура("Схема, Предмет, Событие, Автор", Правило.Схема, Неопределено,
				Перечисления.кбп_СобытияЗапуска.Расписание, Правило.Схема.Ответственный));
		Запущено = Запущено + 1;
	КонецЦикла;
	Если Запущено > 0 Тогда
		// Поставленные запуски выполняются этим же вызовом, без ожидания следующего цикла.
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ожидает", Перечисления.кбп_СтатусыОчереди.Ожидает);
		Запрос.УстановитьПараметр("Вид", Перечисления.кбп_ВидыОтложенныхДействий.ЗапускПоРасписанию);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.Ид КАК Ид
		|ИЗ
		|	РегистрСведений.кбп_ОчередьДействий КАК Очередь
		|ГДЕ
		|	Очередь.Статус = &Ожидает
		|	И Очередь.Вид = &Вид";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВыполнитьОтложенноеДействие(Выборка.Ид);
		КонецЦикла;
	КонецЕсли;
	Возврат Запущено;

КонецФункции

// Ставит автозапуск в очередь (вызывается из подписки на запись и проведение объектов, в их транзакции).
//
// Параметры:
//  Схема - СправочникСсылка.кбп_СхемыПроцессов
//  Предмет - ЛюбаяСсылка
//  Событие - ПеречислениеСсылка.кбп_СобытияЗапуска
//
Процедура ПоставитьАвтозапуск(Схема, Предмет, Событие) Экспорт

	ПоставитьВОчередь(Неопределено, Перечисления.кбп_ВидыОтложенныхДействий.ЗапускПоРасписанию, "", ТекущаяДатаСеанса(),
		Новый Структура("Схема, Предмет, Событие, Автор", Схема, Предмет, Событие,
			кбп_АдаптерКонфигурации.ТекущийПользователь()));

КонецПроцедуры

// Выполняет одно отложенное действие в своей транзакции. Возвращает Истина, если действие выполнено.
Функция ВыполнитьОтложенноеДействие(Ид)

	Выполнено = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.кбп_ОчередьДействий").УстановитьЗначение("Ид", Ид);
		Блокировка.Заблокировать();
		Запись = РегистрыСведений.кбп_ОчередьДействий.СоздатьМенеджерЗаписи();
		Запись.Ид = Ид;
		Запись.Прочитать();
		Если Не Запись.Выбран() Или Запись.Статус <> Перечисления.кбп_СтатусыОчереди.Ожидает Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
		Процесс = Запись.Процесс;
		ПараметрыДействия = Запись.Параметры.Получить();
		Виды = Перечисления.кбп_ВидыОтложенныхДействий;
		Если ЗначениеЗаполнено(Процесс) Тогда
			ЗаблокироватьПроцесс(Процесс);
		КонецЕсли;

		Если Запись.Вид = Виды.ЗапускПоРасписанию Тогда
			Выполнено = ВыполнитьАвтозапуск(ПараметрыДействия);
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Выполнено;
		ИначеЕсли Процесс.Состояние <> Перечисления.кбп_СостоянияПроцессов.Активен Тогда
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Отменено;
		ИначеЕсли Запись.Вид = Виды.КонтрольСрока Тогда
			Выполнено = ВыполнитьКонтрольСрока(Процесс, ПараметрыДействия.Задача);
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Выполнено;
		ИначеЕсли Запись.Вид = Виды.Автовыполнение Тогда
			Выполнено = ВыполнитьАвтовыполнение(Процесс, ПараметрыДействия.Задача);
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Выполнено;
		ИначеЕсли Запись.Вид = Перечисления.кбп_ВидыОтложенныхДействий.ПродолжитьРодителя Тогда
			Выполнено = ПродолжитьРодителя(Процесс, Запись.ИдМаркера, ПараметрыДействия.Шаг, ПараметрыДействия.Дочерний);
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Выполнено;
		ИначеЕсли Запись.Вид = Перечисления.кбп_ВидыОтложенныхДействий.Таймер Тогда
			Маркер = ПрочитатьМаркер(Процесс, Запись.ИдМаркера);
			Если Маркер.Выбран() И Маркер.Состояние = Перечисления.кбп_СостоянияМаркеров.Ожидает
				И Маркер.Шаг = ПараметрыДействия.Шаг Тогда
				Контекст = НовыйКонтекст(Процесс);
				ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переход, ПараметрыДействия.Шаг, , , ,
					СтрШаблон(НСтр("ru = 'Таймер «%1» сработал'"), ПараметрыДействия.Шаг));
				Маркер.Состояние = Перечисления.кбп_СостоянияМаркеров.Активен;
				Маркер.Записать();
				ПродвинутьМаркер(Контекст, Запись.ИдМаркера, ПараметрыДействия.Шаг, ПараметрыДействия.ИдКнопки);
				Выполнено = Истина;
			КонецЕсли;
			Запись.Статус = ?(Выполнено, Перечисления.кбп_СтатусыОчереди.Выполнено, Перечисления.кбп_СтатусыОчереди.Отменено);
		Иначе
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Отменено;
			Запись.ПоследняяОшибка = СтрШаблон(НСтр("ru = 'Вид действия «%1» не поддерживается.'"), Запись.Вид);
		КонецЕсли;
		Запись.Попыток = Запись.Попыток + 1;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибкуОтложенногоДействия(Ид, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Выполнено;

КонецФункции

// После 5 неудачных попыток действие получает статус «Ошибка», а в журнал процесса пишется ошибка.
Процедура ЗаписатьОшибкуОтложенногоДействия(Ид, Информация)

	Текст = ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация);
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы.Очередь действий'"), УровеньЖурналаРегистрации.Ошибка, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	НачатьТранзакцию();
	Попытка
		Запись = РегистрыСведений.кбп_ОчередьДействий.СоздатьМенеджерЗаписи();
		Запись.Ид = Ид;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Попыток = Запись.Попыток + 1;
			Запись.ПоследняяОшибка = Текст;
			Если Запись.Попыток >= 5 Тогда
				Запись.Статус = Перечисления.кбп_СтатусыОчереди.Ошибка;
				Если ЗначениеЗаполнено(Запись.Процесс) Тогда
					ЗаблокироватьПроцесс(Запись.Процесс);
					Контекст = НовыйКонтекст(Запись.Процесс);
					ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Ошибка, , , Текст);
				КонецЕсли;
			Иначе
				Запись.ВыполнитьПосле = ТекущаяДатаСеанса() + 60 * Запись.Попыток;
			КонецЕсли;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Вложенные

// Вложенный процесс (ФТ-701, ФТ-702): синхронно — маркер ждёт завершения дочернего, асинхронно — идёт дальше.
Процедура ЗапуститьВложенный(Контекст, ИдМаркера, Шаг, ИдКнопки)

	Синхронно = (Шаг.РежимВложенного <> Перечисления.кбп_РежимыВложенногоПроцесса.Асинхронно);
	ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, ?(Синхронно,
		Перечисления.кбп_СостоянияМаркеров.Ожидает, Перечисления.кбп_СостоянияМаркеров.Активен));

	Схема = Шаг.ВложеннаяСхема;
	Если Не ЗначениеЗаполнено(Схема) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У шага «%1» не указана вложенная схема.'"), Шаг);
	КонецЕсли;
	Версия = ?(ЗначениеЗаполнено(Шаг.ВложеннаяВерсия), Шаг.ВложеннаяВерсия, Схема.ТекущаяВерсия);
	Если Не ЗначениеЗаполнено(Версия) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У вложенной схемы «%1» нет опубликованной версии.'"), Схема);
	КонецЕсли;
	Уровень = Контекст.Процесс.УровеньВложенности + 1;
	Предел = кбп_ПроцессыСлужебный.Настройка("МаксимальнаяГлубинаВложенности");
	Предел = ?(ТипЗнч(Предел) = Тип("Число") И Предел > 0, Предел, 20);
	Если Уровень > Предел Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Превышена глубина вложенности процессов (%1). Проверьте, не вызывает ли схема сама себя.'"), Предел);
	КонецЕсли;

	Родитель = Новый Структура("Процесс, Шаг, ИдМаркера, Корень, Уровень",
		Контекст.Процесс, Шаг, ИдМаркера, Контекст.Процесс.КорневойПроцесс, Уровень);
	Дочерний = СоздатьПроцесс(Схема, Версия, Контекст.Предмет, ВходныеПеременные(Шаг, Схема, Контекст),
		СтрШаблон(НСтр("ru = 'Вложенный процесс шага «%1» процесса «%2»'"), Шаг, Контекст.Процесс), Контекст.Автор, Родитель);

	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ВложенныйЗапущен, Шаг, , , ,
		СтрШаблон(НСтр("ru = '%1 (%2)'"), Дочерний, ?(Синхронно, НСтр("ru = 'ждём завершения'"), НСтр("ru = 'без ожидания'"))));
	Если Не Синхронно Тогда
		ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, ИдКнопки);
	КонецЕсли;

КонецПроцедуры

// Значения входных переменных дочернего процесса: по таблице «Параметры вложенного»,
// а если она пуста — переменные родителя с теми же именами (у дочерней переменной отмечено «Вход»).
Функция ВходныеПеременные(Шаг, СхемаДочернего, Контекст)

	Значения = Новый Соответствие;
	Если Шаг.ПараметрыВложенного.Количество() > 0 Тогда
		Для Каждого Параметр Из Шаг.ПараметрыВложенного Цикл
			Если Параметр.Вход И ЗначениеЗаполнено(Параметр.ПеременнаяРодителя) И ЗначениеЗаполнено(Параметр.ПеременнаяДочернего) Тогда
				Значения.Вставить(Параметр.ПеременнаяДочернего.Имя, Контекст.Переменные[Параметр.ПеременнаяРодителя.Имя]);
			КонецЕсли;
		КонецЦикла;
		Возврат Значения;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Схема", СхемаДочернего);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переменные.Имя КАК Имя
	|ИЗ
	|	ПланВидовХарактеристик.кбп_ПеременныеПроцессов КАК Переменные
	|ГДЕ
	|	Переменные.Схема = &Схема
	|	И Переменные.Вход
	|	И НЕ Переменные.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Контекст.Переменные[Выборка.Имя];
		Если Значение <> Неопределено Тогда
			Значения.Вставить(Выборка.Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Завершение дочернего процесса — отложенное действие для родителя: родитель продолжается отдельной операцией
// сразу после фиксации (в той же операции контекст родителя может быть уже открыт выше по стеку).
Процедура ПриЗавершенииВложенного(Дочерний)

	ПоставитьВОчередь(Дочерний.РодительскийПроцесс, Перечисления.кбп_ВидыОтложенныхДействий.ПродолжитьРодителя,
		Дочерний.ИдМаркераРодителя, ТекущаяДатаСеанса(), Новый Структура("Шаг, Дочерний", Дочерний.ШагРодителя, Дочерний));

КонецПроцедуры

// Выходные переменные дочернего процесса — в родителя, ждущий маркер родителя идёт дальше (ФТ-704).
// Возвращает Истина, если маркер родителя продвинут.
Функция ПродолжитьРодителя(Родитель, ИдМаркера, Шаг, Дочерний)

	Контекст = НовыйКонтекст(Родитель);
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ВложенныйЗавершен, Шаг, , , , Строка(Дочерний));
	Маркер = ПрочитатьМаркер(Родитель, ИдМаркера);
	Если Не Маркер.Выбран() Или Маркер.Состояние <> Перечисления.кбп_СостоянияМаркеров.Ожидает Или Маркер.Шаг <> Шаг Тогда
		Возврат Ложь; // асинхронный запуск или ветка уже закрыта
	КонецЕсли;

	ПеременныеДочернего = ПеременныеПроцесса(Дочерний);
	Если Шаг.ПараметрыВложенного.Количество() > 0 Тогда
		Для Каждого Параметр Из Шаг.ПараметрыВложенного Цикл
			Если Параметр.Выход И ЗначениеЗаполнено(Параметр.ПеременнаяРодителя) И ЗначениеЗаполнено(Параметр.ПеременнаяДочернего) Тогда
				Контекст.Переменные.Вставить(Параметр.ПеременнаяРодителя.Имя, ПеременныеДочернего[Параметр.ПеременнаяДочернего.Имя]);
				Контекст.ПеременныеИзменены = Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Переменная Из Дочерний.Переменные Цикл
			Если Переменная.Переменная.Выход И Контекст.Переменные[Переменная.Переменная.Имя] <> Неопределено Тогда
				Контекст.Переменные.Вставить(Переменная.Переменная.Имя, Переменная.Значение);
				Контекст.ПеременныеИзменены = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СохранитьПеременные(Контекст);

	Маркер.Состояние = Перечисления.кбп_СостоянияМаркеров.Активен;
	Маркер.Записать();
	ПродвинутьМаркер(Контекст, ИдМаркера, Шаг, "");
	Возврат Истина;

КонецФункции

// Дочерний процесс прерван пользователем: родитель продолжает ждать, в его ленту пишется предупреждение.
Процедура ПриПрерыванииВложенного(Дочерний)

	Родитель = Дочерний.РодительскийПроцесс;
	ЗаблокироватьПроцесс(Родитель);
	Контекст = НовыйКонтекст(Родитель);
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Предупреждение, Дочерний.ШагРодителя, , , ,
		СтрШаблон(НСтр("ru = 'Вложенный процесс «%1» прерван. Шаг «%2» не будет продолжен автоматически: прервите процесс или запустите шаг заново.'"),
			Дочерний, Дочерний.ШагРодителя));

КонецПроцедуры

// Прерывает активные дочерние процессы (всего процесса или одного маркера) вместе с их потомками.
Процедура ПрерватьВложенные(Процесс, ИдМаркера)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Процесс);
	Запрос.УстановитьПараметр("ИдМаркера", ИдМаркера);
	Запрос.УстановитьПараметр("ВсеМаркеры", ИдМаркера = Неопределено);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивныхПроцессов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Процессы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.кбп_Процессы КАК Процессы
	|ГДЕ
	|	Процессы.РодительскийПроцесс = &Родитель
	|	И Процессы.Состояние В (&Активные)
	|	И (&ВсеМаркеры
	|			ИЛИ Процессы.ИдМаркераРодителя = &ИдМаркера)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаблокироватьПроцесс(Выборка.Ссылка);
		КонтекстДочернего = НовыйКонтекст(Выборка.Ссылка);
		ПрерватьВТранзакции(КонтекстДочернего, "", Истина);
	КонецЦикла;

КонецПроцедуры

// Создаёт процесс и продвигает маркер от Старта. Вызывается в транзакции.
Функция СоздатьПроцесс(Схема, Версия, Предмет, Переменные, Комментарий, Автор, Родитель = Неопределено)

	ПроверитьПредмет(Схема, Предмет);
	Если Схема.ЗапретВторогоЭкземпляра И ЗначениеЗаполнено(Предмет) Тогда
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.кбп_СхемыПроцессов").УстановитьЗначение("Ссылка", Схема);
		Блокировка.Заблокировать();
		Если АктивныеПроцессыПредмета(Предмет, Схема).Количество() > 0 Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'По «%1» уже идёт процесс «%2». Второй экземпляр запрещён настройкой схемы.'"), Предмет, Схема);
		КонецЕсли;
	КонецЕсли;
	Старт = ШагСтарт(Версия);

	Ссылка = Справочники.кбп_Процессы.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ЗаблокироватьПроцесс(Ссылка);

	ПроцессОбъект = Справочники.кбп_Процессы.СоздатьЭлемент();
	ПроцессОбъект.УстановитьСсылкуНового(Ссылка);
	ПроцессОбъект.Схема = Схема;
	ПроцессОбъект.ВерсияСхемы = Версия;
	ПроцессОбъект.Предмет = Предмет;
	ПроцессОбъект.ПредставлениеПредмета = Лев(ПредставлениеПредмета(Предмет), 255);
	ПроцессОбъект.Автор = Автор;
	ПроцессОбъект.Состояние = Перечисления.кбп_СостоянияПроцессов.Активен;
	ПроцессОбъект.ДатаСтарта = ТекущаяДатаСеанса();
	Если Родитель = Неопределено Тогда
		ПроцессОбъект.КорневойПроцесс = Ссылка;
	Иначе
		ПроцессОбъект.РодительскийПроцесс = Родитель.Процесс;
		ПроцессОбъект.ШагРодителя = Родитель.Шаг;
		ПроцессОбъект.ИдМаркераРодителя = Родитель.ИдМаркера;
		ПроцессОбъект.КорневойПроцесс = ?(ЗначениеЗаполнено(Родитель.Корень), Родитель.Корень, Родитель.Процесс);
		ПроцессОбъект.УровеньВложенности = Родитель.Уровень;
	КонецЕсли;
	ПроцессОбъект.Наименование = Лев(НаименованиеПроцесса(Схема, Предмет), 150);
	ЗаполнитьПеременные(ПроцессОбъект, Схема, Переменные);
	ПроцессОбъект.Записать();

	Контекст = НовыйКонтекст(Ссылка);
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Запуск, Старт, , Комментарий);

	ИдМаркера = Строка(Новый УникальныйИдентификатор);
	ЗаписатьМаркер(Контекст, ИдМаркера, Старт, Перечисления.кбп_СостоянияМаркеров.Активен);
	ПродвинутьМаркер(Контекст, ИдМаркера, Старт, "");
	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область Задачи

Процедура СоздатьЗадачи(Контекст, ИдМаркера, Шаг)

	Маркер = ПрочитатьМаркер(Контекст.Процесс, ИдМаркера);
	Исполнители = Неопределено;
	Если Контекст.Возврат И Шаг.ТотЖеИсполнительПриВозврате Тогда
		Исполнители = ПрежниеИсполнителиШага(Контекст.Процесс, Шаг);
	КонецЕсли;
	Если Исполнители = Неопределено Или Исполнители.Количество() = 0 Тогда
		Исполнители = кбп_Адресация.ОпределитьИсполнителей(Шаг, Контекст);
	КонецЕсли;
	Если Исполнители.Количество() = 0 Тогда
		Администратор = кбп_ПроцессыСлужебный.Настройка("АдминистраторПроцессов");
		Получатель = ?(ЗначениеЗаполнено(Администратор), Администратор, Контекст.Автор);
		Исполнители.Добавить(кбп_Адресация.НовыйИсполнитель(Получатель));
		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Предупреждение, Шаг, , ,
			, СтрШаблон(НСтр("ru = 'Не найдены исполнители шага «%1», задача назначена: %2'"), Шаг, Получатель));
	КонецЕсли;

	Срок = СрокЗадачи(Шаг, Контекст);
	Для Каждого Исполнитель Из Исполнители Цикл
		ЗадачаОбъект = Справочники.кбп_Задачи.СоздатьЭлемент();
		ЗадачаОбъект.Наименование = Лев(Строка(Шаг), 150);
		ЗадачаОбъект.Процесс = Контекст.Процесс;
		ЗадачаОбъект.Шаг = Шаг;
		ЗадачаОбъект.ИдМаркера = ИдМаркера;
		ЗадачаОбъект.Состояние = Перечисления.кбп_СостоянияЗадач.Ожидает;
		ЗадачаОбъект.Назначенный = Исполнитель.Пользователь;
		ЗадачаОбъект.Роль = Исполнитель.Роль;
		ЗадачаОбъект.ОбъектАдресации1 = Исполнитель.ОбъектАдресации1;
		ЗадачаОбъект.ОбъектАдресации2 = Исполнитель.ОбъектАдресации2;
		ЗадачаОбъект.ДатаСоздания = ТекущаяДатаСеанса();
		ЗадачаОбъект.Срок = Срок;
		ЗадачаОбъект.Итерация = Маркер.Итерация;
		ЗадачаОбъект.Предмет = Контекст.Предмет;
		ЗадачаОбъект.ПредставлениеПредмета = Лев(ПредставлениеПредмета(Контекст.Предмет), 255);
		ЗадачаОбъект.Записать();

		ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ЗадачаСоздана, Шаг, ЗадачаОбъект.Ссылка, , ,
			СтрШаблон(НСтр("ru = 'исполнитель: %1'"), Исполнитель.Пользователь));
		кбп_Оповещения.ОповеститьОЗадаче(ЗадачаОбъект.Ссылка, Перечисления.кбп_СобытияПроцессов.ЗадачаНазначена);
		ПоставитьКонтрольСрока(Контекст.Процесс, ЗадачаОбъект);
	КонецЦикла;

КонецПроцедуры

Функция СрокЗадачи(Шаг, Контекст)

	Если ЗначениеЗаполнено(Шаг.СрокИзПеременной) Тогда
		Значение = Контекст.Переменные[Шаг.СрокИзПеременной.Имя];
		Возврат ?(ТипЗнч(Значение) = Тип("Дата"), Значение, Дата(1, 1, 1));
	КонецЕсли;
	Если Шаг.СрокЗначение = 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат ДобавитьСрок(ТекущаяДатаСеанса(), Шаг.СрокЗначение, Шаг.СрокЕдиница);

КонецФункции

// Дата через Значение единиц срока (пустая единица — дни).
Функция ДобавитьСрок(Начало, Значение, Единица)

	Единицы = Перечисления.кбп_ЕдиницыСрока;
	Если Единица = Единицы.Минуты Тогда
		Возврат Начало + Значение * 60;
	ИначеЕсли Единица = Единицы.Часы Тогда
		Возврат Начало + Значение * 3600;
	ИначеЕсли Единица = Единицы.РабочиеЧасы Тогда
		Возврат кбп_АдаптерКонфигурации.ДобавитьРабочиеЧасы(Начало, Значение);
	ИначеЕсли Единица = Единицы.РабочиеДни Тогда
		Возврат кбп_АдаптерКонфигурации.ДобавитьРабочиеДни(Начало, Значение);
	КонецЕсли;
	Возврат Начало + Значение * 86400;

КонецФункции

// Значения полей к заполнению — в переменные процесса. Обязательные поля проверяются, если Проверять.
Процедура ПрименитьЗначенияПолей(Контекст, Шаг, ЗначенияПолей, Проверять)

	Для Каждого Поле Из Шаг.ПоляЗаполнения Цикл
		Переменная = Поле.Переменная;
		Если Не ЗначениеЗаполнено(Переменная) Тогда
			Продолжить;
		КонецЕсли;
		Имя = Переменная.Имя;
		Если Не Поле.ТолькоПросмотр И ЗначенияПолей <> Неопределено Тогда
			Значение = Неопределено;
			Если ТипЗнч(ЗначенияПолей) = Тип("Структура") Тогда
				ЗначенияПолей.Свойство(Имя, Значение);
			Иначе
				Значение = ЗначенияПолей[Имя];
			КонецЕсли;
			Значение = Переменная.ТипЗначения.ПривестиЗначение(Значение);
			Если Контекст.Переменные[Имя] <> Значение Тогда
				Контекст.Переменные.Вставить(Имя, Значение);
				Контекст.ПеременныеИзменены = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Проверять И Поле.Обязательное И Не ЗначениеЗаполнено(Контекст.Переменные[Имя]) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Заполните поле «%1».'"),
				?(ЗначениеЗаполнено(Поле.Заголовок), Поле.Заголовок, Переменная.Наименование));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВыполнениеЗадачи(ЗадачаОбъект)

	Если ЗадачаОбъект.ЭтоКопия Тогда
		ВызватьИсключение НСтр("ru = 'Это копия задачи для сведения, её не выполняют.'");
	КонецЕсли;
	Если СостоянияАктивных().Найти(ЗадачаОбъект.Состояние) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Задача уже в состоянии «%1».'"), ЗадачаОбъект.Состояние);
	КонецЕсли;
	Если ЗадачаОбъект.Процесс.Состояние <> Перечисления.кбп_СостоянияПроцессов.Активен Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Процесс в состоянии «%1».'"), ЗадачаОбъект.Процесс.Состояние);
	КонецЕсли;
	Пользователь = кбп_АдаптерКонфигурации.ТекущийПользователь();
	Если ЗадачаОбъект.Назначенный <> Пользователь И Не кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов()
		И кбп_Адресация.ЗамещениеДляЗадачи(ЗадачаОбъект, Пользователь) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Задача назначена пользователю %1.'"), ЗадачаОбъект.Назначенный);
	КонецЕсли;

КонецПроцедуры

// Снимает принятие к исполнению заместителем с активных задач замещаемого.
Процедура ВернутьЗадачиЗамещаемому(Замещаемый, Замещающий)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Замещаемый", Замещаемый);
	Запрос.УстановитьПараметр("Замещающий", Замещающий);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивных());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка,
	|	Задачи.Процесс КАК Процесс
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Назначенный = &Замещаемый
	|	И Задачи.ПринялКИсполнению = &Замещающий
	|	И Задачи.ПринятаКИсполнению
	|	И Задачи.Состояние В (&Активные)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьПроцесс(Выборка.Процесс);
			ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ЗадачаОбъект.ПринятаКИсполнению = Ложь;
			ЗадачаОбъект.ПринялКИсполнению = Справочники.Пользователи.ПустаяСсылка();
			ЗадачаОбъект.Состояние = Перечисления.кбп_СостоянияЗадач.Ожидает;
			ЗадачаОбъект.Записать();
			Контекст = НовыйКонтекст(Выборка.Процесс);
			ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переадресация, ЗадачаОбъект.Шаг, Выборка.Ссылка, , ,
				СтрШаблон(НСтр("ru = 'замещение закончилось: задача возвращена %1'"), Замещаемый));
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы.Замещение'"), УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Выполнение задачи кнопкой в открытой транзакции (пользователем или автовыполнением по сроку).
Процедура ВыполнитьЗадачуВКонтексте(Контекст, ЗадачаОбъект, ИдКнопки, Комментарий, ЗначенияПолей, Автоматически)

	Задача = ЗадачаОбъект.Ссылка;
	Шаг = ЗадачаОбъект.Шаг;
	Кнопка = кбп_Действия.НайтиКнопку(Шаг, ИдКнопки);
	Если Кнопка = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У шага «%1» нет кнопки «%2».'"), Шаг, ИдКнопки);
	КонецЕсли;
	Действия = Перечисления.кбп_ВидыДействий;
	Если Кнопка.Действие = Действия.Вернуть Тогда
		ВызватьИсключение НСтр("ru = 'Для возврата на доработку выберите шаг возврата.'");
	ИначеЕсли Кнопка.Действие = Действия.Переадресовать Или Кнопка.Действие = Действия.ОткрытьФорму
		Или Кнопка.Действие = Действия.ЗапуститьВложенный Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Кнопка «%1» не выполняет задачу.'"), Кнопка.Заголовок);
	КонецЕсли;
	Если Не Автоматически Тогда
		Если Кнопка.КомментарийОбязателен И Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Для действия «%1» нужен комментарий.'"), Кнопка.Заголовок);
		КонецЕсли;
		Если Не кбп_Действия.КнопкаВидна(Кнопка, Контекст) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Действие «%1» сейчас недоступно.'"), Кнопка.Заголовок);
		КонецЕсли;
	КонецЕсли;

	Контекст.Задача = Задача;
	Контекст.ИдКнопки = ИдКнопки;
	Контекст.Комментарий = Комментарий;
	ПрименитьЗначенияПолей(Контекст, Шаг, ЗначенияПолей, Не Автоматически
		И Кнопка.Вид <> Перечисления.кбп_ВидыКнопок.Опасная И Кнопка.Действие <> Действия.Прервать);

	ЗадачаОбъект.Состояние = Перечисления.кбп_СостоянияЗадач.Выполнена;
	ЗадачаОбъект.ДатаВыполнения = ТекущаяДатаСеанса();
	ЗадачаОбъект.Результат = ИдКнопки;
	ЗадачаОбъект.Комментарий = Комментарий;
	Если Не Автоматически Тогда
		ЗадачаОбъект.Исполнитель = Контекст.Пользователь;
		Замещение = кбп_Адресация.ЗамещениеДляЗадачи(ЗадачаОбъект, Контекст.Пользователь);
		Если Замещение <> Неопределено Тогда
			ЗадачаОбъект.Замещение = Замещение;
		КонецЕсли;
	КонецЕсли;
	ЗадачаОбъект.Записать();

	Данные = Кнопка.Заголовок;
	Если Автоматически Тогда
		Данные = СтрШаблон(НСтр("ru = '%1 (автовыполнение по сроку)'"), Кнопка.Заголовок);
	КонецЕсли;
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ЗадачаВыполнена, Шаг, Задача, Комментарий,
		ИдКнопки, Данные, ЗадачаОбъект.Назначенный);
	ОтменитьОтложенныеДействияЗадачи(Задача);

	Если Кнопка.Действие = Действия.Прервать Тогда
		ПрерватьВТранзакции(Контекст, Комментарий);
	Иначе
		Если Кнопка.Действие = Действия.Обработчик И ЗначениеЗаполнено(Кнопка.Обработчик) Тогда
			кбп_Действия.ВыполнитьОбработчик(Кнопка.Обработчик, Контекст);
		КонецЕсли;
		СохранитьПеременные(Контекст);
		ЗавершитьШагИПродвинуть(Контекст, ЗадачаОбъект, Кнопка);
	КонецЕсли;

КонецПроцедуры

// Передаёт задачу другому исполнителю (переадресация, эскалация): старая — «Переадресована», новая — копия.
Функция ПередатьЗадачу(Контекст, ЗадачаОбъект, НовыйИсполнитель, Комментарий, Данные, КонтролироватьСрок = Истина)

	ЗадачаОбъект.Состояние = Перечисления.кбп_СостоянияЗадач.Переадресована;
	ЗадачаОбъект.ДатаВыполнения = ТекущаяДатаСеанса();
	ЗадачаОбъект.Комментарий = Комментарий;
	ЗадачаОбъект.Записать();
	ОтменитьОтложенныеДействияЗадачи(ЗадачаОбъект.Ссылка);

	Новая = Справочники.кбп_Задачи.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(Новая, ЗадачаОбъект,
		"Наименование, Процесс, Шаг, ИдМаркера, Роль, ОбъектАдресации1, ОбъектАдресации2, Срок, Итерация, Предмет, ПредставлениеПредмета");
	Новая.Назначенный = НовыйИсполнитель;
	Новая.Состояние = Перечисления.кбп_СостоянияЗадач.Ожидает;
	Новая.ДатаСоздания = ТекущаяДатаСеанса();
	Новая.Записать();

	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Переадресация, ЗадачаОбъект.Шаг, ЗадачаОбъект.Ссылка,
		Комментарий, , Данные, ЗадачаОбъект.Назначенный);
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.ЗадачаСоздана, ЗадачаОбъект.Шаг, Новая.Ссылка, , ,
		СтрШаблон(НСтр("ru = 'исполнитель: %1'"), НовыйИсполнитель));
	кбп_Оповещения.ОповеститьОЗадаче(Новая.Ссылка, Перечисления.кбп_СобытияПроцессов.ЗадачаНазначена);
	Если КонтролироватьСрок Тогда
		ПоставитьКонтрольСрока(Контекст.Процесс, Новая);
	КонецЕсли;
	Возврат Новая.Ссылка;

КонецФункции

// Контроль срока задачи (ФТ-308): в срок — оповещение о просрочке и действие шага при просрочке.
Процедура ПоставитьКонтрольСрока(Процесс, ЗадачаОбъект)

	Если Не ЗначениеЗаполнено(ЗадачаОбъект.Срок) Тогда
		Возврат;
	КонецЕсли;
	ПоставитьВОчередь(Процесс, Перечисления.кбп_ВидыОтложенныхДействий.КонтрольСрока, ЗадачаОбъект.ИдМаркера,
		ЗадачаОбъект.Срок, Новый Структура("Задача", ЗадачаОбъект.Ссылка), ЗадачаОбъект.Ссылка);

КонецПроцедуры

// Задача закрыта — её контроль срока и автовыполнение больше не нужны.
Процедура ОтменитьОтложенныеДействияЗадачи(Задача)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("Ожидает", Перечисления.кбп_СтатусыОчереди.Ожидает);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.кбп_ОчередьДействий КАК Очередь
	|ГДЕ
	|	Очередь.Задача = &Задача
	|	И Очередь.Статус = &Ожидает";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.кбп_ОчередьДействий.СоздатьМенеджерЗаписи();
		Запись.Ид = Выборка.Ид;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Статус = Перечисления.кбп_СтатусыОчереди.Отменено;
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Наступил срок задачи: оповещение «Задача просрочена» и действие шага при просрочке.
Функция ВыполнитьКонтрольСрока(Процесс, Задача)

	ЗадачаОбъект = Задача.ПолучитьОбъект();
	Если СостоянияАктивных().Найти(ЗадачаОбъект.Состояние) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Контекст = НовыйКонтекст(Процесс);
	Шаг = ЗадачаОбъект.Шаг;
	ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Предупреждение, Шаг, Задача, , ,
		СтрШаблон(НСтр("ru = 'Задача «%1» просрочена (срок %2, исполнитель %3)'"), Задача,
			Формат(ЗадачаОбъект.Срок, "ДЛФ=DT"), ЗадачаОбъект.Назначенный));
	кбп_Оповещения.ОповеститьОЗадаче(Задача, Перечисления.кбп_СобытияПроцессов.ЗадачаПросрочена);

	Действия = Перечисления.кбп_ДействияПриПросрочке;
	Если Шаг.ДействиеПриПросрочке = Действия.Эскалация Тогда
		Кому = кбп_Адресация.ИсполнительЭскалации(Задача);
		Если Кому = Неопределено Тогда
			Администратор = кбп_ПроцессыСлужебный.Настройка("АдминистраторПроцессов");
			Кому = ?(ЗначениеЗаполнено(Администратор) И Администратор <> ЗадачаОбъект.Назначенный, Администратор, Неопределено);
		КонецЕсли;
		Если Кому = Неопределено Тогда
			ЗаписатьВЖурнал(Контекст, Перечисления.кбп_ВидыЗаписейЖурнала.Предупреждение, Шаг, Задача, , ,
				НСтр("ru = 'Эскалация не выполнена: не найден эскалационный исполнитель (роль шага, роль задачи, руководитель, администратор процессов).'"));
		Иначе
			Контекст.Задача = Задача;
			ПередатьЗадачу(Контекст, ЗадачаОбъект, Кому, НСтр("ru = 'Эскалация: задача просрочена'"),
				СтрШаблон(НСтр("ru = 'эскалация: %1 → %2'"), ЗадачаОбъект.Назначенный, Кому), Ложь);
		КонецЕсли;
	ИначеЕсли Шаг.ДействиеПриПросрочке = Действия.Автовыполнение Тогда
		ПоставитьВОчередь(Процесс, Перечисления.кбп_ВидыОтложенныхДействий.Автовыполнение, ЗадачаОбъект.ИдМаркера,
			ЗадачаОбъект.Срок + Шаг.ДнейДоАвтовыполнения * 86400, Новый Структура("Задача", Задача), Задача);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Автовыполнение просроченной задачи кнопкой по умолчанию шага (ФТ-308).
Функция ВыполнитьАвтовыполнение(Процесс, Задача)

	ЗадачаОбъект = Задача.ПолучитьОбъект();
	Если СостоянияАктивных().Найти(ЗадачаОбъект.Состояние) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИдКнопки = кбп_Действия.КнопкаАвтовыполнения(ЗадачаОбъект.Шаг);
	Если Не ЗначениеЗаполнено(ИдКнопки) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У шага «%1» не определена кнопка автовыполнения.'"), ЗадачаОбъект.Шаг);
	КонецЕсли;
	Контекст = НовыйКонтекст(Процесс);
	ВыполнитьЗадачуВКонтексте(Контекст, ЗадачаОбъект, ИдКнопки, НСтр("ru = 'Выполнено автоматически: истёк срок'"),
		Неопределено, Истина);
	Возврат Истина;

КонецФункции

Функция ОставшиесяЗадачиМаркера(Процесс, ИдМаркера, Кроме)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("ИдМаркера", ИдМаркера);
	Запрос.УстановитьПараметр("Кроме", Кроме);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивных());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.ИдМаркера = &ИдМаркера
	|	И Задачи.Ссылка <> &Кроме
	|	И Задачи.Состояние В (&Активные)
	|	И НЕ Задачи.ЭтоКопия";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Процедура ОтменитьЗадачиМаркера(Контекст, ИдМаркера, Кроме, Состояние)

	Для Каждого Задача Из ОставшиесяЗадачиМаркера(Контекст.Процесс, ИдМаркера, Кроме) Цикл
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ЗадачаОбъект.Состояние = Состояние;
		ЗадачаОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

Функция АктивныеЗадачиПроцесса(Процесс)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("Активные", СостоянияАктивных());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.Состояние В (&Активные)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Исполнители последней итерации шага — для возврата «тому же исполнителю» (Архитектура п. 6.4, шаг 4).
Функция ПрежниеИсполнителиШага(Процесс, Шаг)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("Шаг", Шаг);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Задачи.Итерация) КАК Итерация
	|ПОМЕСТИТЬ ВТИтерация
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.Шаг = &Шаг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Задачи.Назначенный КАК Пользователь,
	|	Задачи.Роль КАК Роль,
	|	Задачи.ОбъектАдресации1 КАК ОбъектАдресации1,
	|	Задачи.ОбъектАдресации2 КАК ОбъектАдресации2
	|ИЗ
	|	Справочник.кбп_Задачи КАК Задачи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТИтерация КАК ВТИтерация
	|		ПО Задачи.Итерация = ВТИтерация.Итерация
	|ГДЕ
	|	Задачи.Процесс = &Процесс
	|	И Задачи.Шаг = &Шаг
	|	И НЕ Задачи.ЭтоКопия";
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Исполнитель = кбп_Адресация.НовыйИсполнитель(Выборка.Пользователь);
		ЗаполнитьЗначенияСвойств(Исполнитель, Выборка, "Роль, ОбъектАдресации1, ОбъектАдресации2");
		Результат.Добавить(Исполнитель);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СостоянияВыполненных()

	Состояния = Новый Массив;
	Состояния.Добавить(Перечисления.кбп_СостоянияЗадач.Выполнена);
	Возврат Состояния;

КонецФункции

Функция СостоянияАктивныхПроцессов()

	Состояния = Новый Массив;
	Состояния.Добавить(Перечисления.кбп_СостоянияПроцессов.Активен);
	Состояния.Добавить(Перечисления.кбп_СостоянияПроцессов.Приостановлен);
	Состояния.Добавить(Перечисления.кбп_СостоянияПроцессов.Ошибка);
	Возврат Состояния;

КонецФункции

#КонецОбласти

#Область Маркеры

Процедура ЗаблокироватьПроцесс(Процесс)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.кбп_Маркеры");
	ЭлементБлокировки.УстановитьЗначение("Процесс", Процесс);
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаписатьМаркер(Контекст, ИдМаркера, Шаг, Состояние)

	Маркер = ПрочитатьМаркер(Контекст.Процесс, ИдМаркера);
	Если Не Маркер.Выбран() Тогда
		Маркер.Процесс = Контекст.Процесс;
		Маркер.ИдМаркера = ИдМаркера;
		Маркер.ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;
	Маркер.Шаг = Шаг;
	Маркер.Состояние = Состояние;
	Маркер.Записать();

КонецПроцедуры

Функция ПрочитатьМаркер(Процесс, ИдМаркера)

	Маркер = РегистрыСведений.кбп_Маркеры.СоздатьМенеджерЗаписи();
	Маркер.Процесс = Процесс;
	Маркер.ИдМаркера = ИдМаркера;
	Маркер.Прочитать();
	Если Не Маркер.Выбран() Тогда
		Маркер.Процесс = Процесс;
		Маркер.ИдМаркера = ИдМаркера;
	КонецЕсли;
	Возврат Маркер;

КонецФункции

Функция ЕстьАктивныеМаркеры(Процесс)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.УстановитьПараметр("Завершен", Перечисления.кбп_СостоянияМаркеров.Завершен);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маркеры.ИдМаркера КАК ИдМаркера
	|ИЗ
	|	РегистрСведений.кбп_Маркеры КАК Маркеры
	|ГДЕ
	|	Маркеры.Процесс = &Процесс
	|	И Маркеры.Состояние <> &Завершен";
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ПроцессАктивен(Процесс)
	Возврат СостоянияАктивныхПроцессов().Найти(Процесс.Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область Контекст

// Контекст операции над процессом: передаётся в адресацию, условия и обработчики (Архитектура п. 8.3).
Функция НовыйКонтекст(Процесс)

	Контекст = Новый Структура;
	Контекст.Вставить("Процесс", Процесс);
	Контекст.Вставить("Схема", Процесс.Схема);
	Контекст.Вставить("Версия", Процесс.ВерсияСхемы);
	Контекст.Вставить("Предмет", Процесс.Предмет);
	Контекст.Вставить("Автор", Процесс.Автор);
	Контекст.Вставить("Пользователь", кбп_АдаптерКонфигурации.ТекущийПользователь());
	Контекст.Вставить("Задача", Неопределено);
	Контекст.Вставить("ИдКнопки", "");
	Контекст.Вставить("Комментарий", "");
	Контекст.Вставить("Переменные", ПеременныеПроцесса(Процесс));
	Контекст.Вставить("ПеременныеИзменены", Ложь);
	Контекст.Вставить("Возврат", Ложь);
	Контекст.Вставить("Переходов", 0);
	Контекст.Вставить("НомерЖурнала", ПоследнийНомерЖурнала(Процесс));
	Возврат Контекст;

КонецФункции

// Соответствие «имя переменной → значение».
Функция ПеременныеПроцесса(Процесс)

	Результат = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Процесс.Переменные Цикл
		Результат.Вставить(СтрокаТаблицы.Переменная.Имя, СтрокаТаблицы.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура СохранитьПеременные(Контекст)

	Если Не Контекст.ПеременныеИзменены Тогда
		Возврат;
	КонецЕсли;
	ПроцессОбъект = Контекст.Процесс.ПолучитьОбъект();
	Для Каждого СтрокаТаблицы Из ПроцессОбъект.Переменные Цикл
		Значение = Контекст.Переменные[СтрокаТаблицы.Переменная.Имя];
		Если Значение <> Неопределено Тогда
			СтрокаТаблицы.Значение = Значение;
		КонецЕсли;
	КонецЦикла;
	ПроцессОбъект.Записать();
	Контекст.ПеременныеИзменены = Ложь;

КонецПроцедуры

Процедура ЗаполнитьПеременные(ПроцессОбъект, Схема, Значения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Схема", Схема);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переменные.Ссылка КАК Ссылка,
	|	Переменные.Имя КАК Имя
	|ИЗ
	|	ПланВидовХарактеристик.кбп_ПеременныеПроцессов КАК Переменные
	|ГДЕ
	|	Переменные.Схема = &Схема
	|	И НЕ Переменные.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Переменные.Порядок";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = ПроцессОбъект.Переменные.Добавить();
		СтрокаТаблицы.Переменная = Выборка.Ссылка;
		Значение = Неопределено;
		Если Значения <> Неопределено Тогда
			Если ТипЗнч(Значения) = Тип("Структура") Тогда
				Значения.Свойство(Выборка.Имя, Значение);
			Иначе
				Значение = Значения[Выборка.Имя];
			КонецЕсли;
		КонецЕсли;
		Если Значение = Неопределено Тогда
			Значение = Выборка.Ссылка.ЗначениеПоУмолчанию.Получить();
		КонецЕсли;
		СтрокаТаблицы.Значение = Выборка.Ссылка.ТипЗначения.ПривестиЗначение(Значение);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПредмет(Схема, Предмет)

	ТипПредмета = Схема.ТипПредмета;
	Если Не ЗначениеЗаполнено(ТипПредмета) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Предмет) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Для схемы «%1» укажите предмет процесса (%2).'"), Схема, ТипПредмета);
	КонецЕсли;
	МетаданныеПредмета = Метаданные.НайтиПоТипу(ТипЗнч(Предмет));
	Если МетаданныеПредмета = Неопределено Или МетаданныеПредмета.ПолноеИмя() <> ТипПредмета Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Предмет процесса «%1» должен иметь тип %2.'"), Предмет, ТипПредмета);
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеПредмета(Предмет)

	Если Не ЗначениеЗаполнено(Предмет) Тогда
		Возврат "";
	КонецЕсли;
	Возврат кбп_АдаптерКонфигурации.ПредставлениеОбъекта(Предмет);

КонецФункции

Функция НаименованиеПроцесса(Схема, Предмет)

	Если ЗначениеЗаполнено(Предмет) Тогда
		Возврат СтрШаблон("%1: %2", Схема, ПредставлениеПредмета(Предмет));
	КонецЕсли;
	Возврат СтрШаблон("%1 от %2", Схема, Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));

КонецФункции

#КонецОбласти

#Область Журнал

Процедура ЗаписатьВЖурнал(Контекст, ВидЗаписи, Шаг = Неопределено, Задача = Неопределено, Комментарий = "",
	ИдКнопки = "", Данные = "", ЗаКого = Неопределено)

	Контекст.НомерЖурнала = Контекст.НомерЖурнала + 1;
	Запись = РегистрыСведений.кбп_ЖурналПроцессов.СоздатьМенеджерЗаписи();
	Запись.Процесс = Контекст.Процесс;
	Запись.Момент = ТекущаяДатаСеанса();
	Запись.НомерЗаписи = Контекст.НомерЖурнала;
	Запись.ВидЗаписи = ВидЗаписи;
	Если Шаг <> Неопределено Тогда
		Запись.Шаг = Шаг;
	КонецЕсли;
	Если Задача <> Неопределено Тогда
		Запись.Задача = Задача;
	КонецЕсли;
	Запись.Пользователь = Контекст.Пользователь;
	Если ЗаКого <> Неопределено И ЗаКого <> Контекст.Пользователь Тогда
		Запись.ЗаКого = ЗаКого;
	КонецЕсли;
	Запись.ИдКнопки = ИдКнопки;
	Запись.Комментарий = Комментарий;
	Запись.Данные = Данные;
	Если Контекст.Задача <> Неопределено Тогда
		Запись.Итерация = Контекст.Задача.Итерация;
	КонецЕсли;
	Запись.Записать();

КонецПроцедуры

Функция ПоследнийНомерЖурнала(Процесс)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Процесс", Процесс);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Журнал.НомерЗаписи), 0) КАК НомерЗаписи
	|ИЗ
	|	РегистрСведений.кбп_ЖурналПроцессов КАК Журнал
	|ГДЕ
	|	Журнал.Процесс = &Процесс";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.НомерЗаписи;

КонецФункции

