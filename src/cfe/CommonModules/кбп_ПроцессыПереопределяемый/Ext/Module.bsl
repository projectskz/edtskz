#Область ПрограммныйИнтерфейс

// Регистрирует обработчики для шагов «Обработка», условий, кнопок и адресации (Архитектура п. 8.3).
// Обработчик — экспортная процедура общего модуля с одним параметром Контекст (Структура):
// Процесс, Предмет, Автор, Пользователь, Задача, ИдКнопки, Комментарий, Переменные (Соответствие имя → значение);
// в условиях — Результат (Булево), в адресации — Исполнители (Массив пользователей).
//
// Параметры:
//  Обработчики - ТаблицаЗначений - Имя, Представление, ПолноеИмяМетода («ОбщийМодуль.Метод»),
//                Контекст («Задача», «Условие», «Адресация», «Кнопка»).
//
// Пример:
//	Обработчик = Обработчики.Добавить();
//	Обработчик.Имя = "СуммаБольшеЛимита";
//	Обработчик.Представление = "Сумма больше лимита";
//	Обработчик.ПолноеИмяМетода = "мойМодуль.СуммаБольшеЛимита";
//	Обработчик.Контекст = "Условие";
//
