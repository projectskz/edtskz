#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Если Объект.ТипЗначения.Типы().Количество() = 0 Тогда
			Объект.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1024));
		КонецЕсли;
	Иначе
		ЗначениеПоУмолчанию = Объект.Ссылка.ЗначениеПоУмолчанию.Получить();
	КонецЕсли;
	Элементы.Схема.ТолькоПросмотр = ЗначениеЗаполнено(Объект.Схема);
	НастроитьЗначениеПоУмолчанию();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(ТекущийОбъект.Имя) Тогда
		ТекущийОбъект.Имя = ИмяПоНаименованию(ТекущийОбъект.Наименование);
	КонецЕсли;
	Если Не ЭтоИдентификатор(ТекущийОбъект.Имя) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Имя должно начинаться с буквы и состоять из букв, цифр и «_» (без пробелов).'"), , "Объект.Имя", , Отказ);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущийОбъект.Схема) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Укажите схему процесса.'"), , "Объект.Схема", , Отказ);
		Возврат;
	КонецЕсли;
	Если ИмяЗанято(ТекущийОбъект.Схема, ТекущийОбъект.Имя, ТекущийОбъект.Ссылка) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'В схеме уже есть переменная с именем «%1».'"), ТекущийОбъект.Имя), , "Объект.Имя", , Отказ);
		Возврат;
	КонецЕсли;
	ТекущийОбъект.ЗначениеПоУмолчанию = Новый ХранилищеЗначения(ТекущийОбъект.ТипЗначения.ПривестиЗначение(ЗначениеПоУмолчанию));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Имя) Или Объект.Имя = ИмяПоНаименованию(ПрежнееНаименование) Тогда
		Объект.Имя = ИмяПоНаименованию(Объект.Наименование);
	КонецЕсли;
	ПрежнееНаименование = Объект.Наименование;

КонецПроцедуры

&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)
	НастроитьЗначениеПоУмолчанию();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьЗначениеПоУмолчанию()

	Элементы.ЗначениеПоУмолчанию.ОграничениеТипа = Объект.ТипЗначения;
	ЗначениеПоУмолчанию = Объект.ТипЗначения.ПривестиЗначение(ЗначениеПоУмолчанию);
	ПрежнееНаименование = Объект.Наименование;

КонецПроцедуры

// «Сумма согласования» → «СуммаСогласования».
&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоНаименованию(Наименование)

	Допустимые = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_";
	Имя = "";
	СЗаглавной = Истина;
	Для Позиция = 1 По СтрДлина(Наименование) Цикл
		Символ = Сред(Наименование, Позиция, 1);
		Если СтрНайти(Допустимые, НРег(Символ)) = 0 Тогда
			СЗаглавной = Истина;
			Продолжить;
		КонецЕсли;
		Если СЗаглавной Тогда
			Символ = ВРег(Символ);
			СЗаглавной = Ложь;
		КонецЕсли;
		Имя = Имя + Символ;
	КонецЦикла;
	Если ЗначениеЗаполнено(Имя) И СтрНайти("0123456789", Лев(Имя, 1)) > 0 Тогда
		Имя = "_" + Имя;
	КонецЕсли;
	Возврат Лев(Имя, 100);

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоИдентификатор(Имя)

	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Проверка = Новый Структура(Имя);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Проверка.Количество() = 1;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяЗанято(Схема, Имя, Ссылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Схема", Схема);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Переменные.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.кбп_ПеременныеПроцессов КАК Переменные
	|ГДЕ
	|	Переменные.Схема = &Схема
	|	И Переменные.Имя = &Имя
	|	И Переменные.Ссылка <> &Ссылка
	|	И НЕ Переменные.ПометкаУдаления";
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
