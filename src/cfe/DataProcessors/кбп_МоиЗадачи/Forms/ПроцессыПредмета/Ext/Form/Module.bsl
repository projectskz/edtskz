#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Предмет = Параметры.Предмет;
	Если Не ЗначениеЗаполнено(Предмет) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Заголовок = СтрШаблон(НСтр("ru = 'Процессы: %1'"), Предмет);
	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "кбп_ИзменениеЗадачи" Или ИмяСобытия = "кбп_ЗапускПроцесса" Тогда
		ОбновитьНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормы

&НаКлиенте
Процедура МоиЗадачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.МоиЗадачи.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроцессыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Процессы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьПроцесс(Команда)
	ОткрытьФорму("Обработка.кбп_МоиЗадачи.Форма.ЗапускПроцесса", Новый Структура("Предмет", Предмет), ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()

	// Автозапуски по этому объекту могли только что встать в очередь — выполняем их, не дожидаясь задания.
	Попытка
		кбп_Движок.ЗапуститьОбработкуОчереди();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы.Очередь действий'"), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	МоиЗадачи.Очистить();
	Для Каждого СтрокаЗадачи Из кбп_Движок.ЗадачиПредметаПользователя(Предмет,
		кбп_АдаптерКонфигурации.ТекущийПользователь()) Цикл
		ЗаполнитьЗначенияСвойств(МоиЗадачи.Добавить(), СтрокаЗадачи);
	КонецЦикла;
	Элементы.ГруппаМоиЗадачи.Видимость = МоиЗадачи.Количество() > 0;

	Процессы.Очистить();
	Для Каждого СтрокаПроцесса Из кбп_Движок.ПроцессыПредмета(Предмет) Цикл
		ЗаполнитьЗначенияСвойств(Процессы.Добавить(), СтрокаПроцесса);
	КонецЦикла;
	Элементы.ГруппаПроцессы.Заголовок = ?(Процессы.Количество() = 0,
		НСтр("ru = 'Процессов по объекту нет — «Запустить процесс…»'"),
		СтрШаблон(НСтр("ru = 'Процессы по объекту (%1)'"), Процессы.Количество()));

КонецПроцедуры

#КонецОбласти
