#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Схема") И ЗначениеЗаполнено(Параметры.Схема) Тогда
		Схема = Параметры.Схема;
	КонецЕсли;
	НастроитьПредмет();
	Если Параметры.Свойство("Предмет") И ЗначениеЗаполнено(Параметры.Предмет) Тогда
		Предмет = Параметры.Предмет;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СхемаПриИзменении(Элемент)
	НастроитьПредмет();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Запустить(Команда)

	Если Не ЗначениеЗаполнено(Схема) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите схему процесса.'"), , "Схема");
		Возврат;
	КонецЕсли;
	Процесс = ЗапуститьНаСервере();
	Оповестить("кбп_ЗапускПроцесса", Процесс);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Процесс запущен'"), ПолучитьНавигационнуюСсылку(Процесс), Строка(Процесс));
	Закрыть();
	ПоказатьЗначение(, Процесс);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗапуститьНаСервере()
	Возврат кбп_Движок.ЗапуститьПроцесс(Схема, ?(ЗначениеЗаполнено(Предмет), Предмет, Неопределено), , Комментарий);
КонецФункции

// Тип предмета ограничивается типом из карточки схемы (ФТ-104).
&НаСервере
Процедура НастроитьПредмет()

	ТипПредмета = ?(ЗначениеЗаполнено(Схема), Схема.ТипПредмета, "");
	Элементы.Предмет.Видимость = ЗначениеЗаполнено(ТипПредмета);
	Если Не ЗначениеЗаполнено(ТипПредмета) Тогда
		Предмет = Неопределено;
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ТипПредмета);
	Если ОбъектМетаданных = Неопределено Тогда
		Элементы.Предмет.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(ТипПредмета, ".");
	ОписаниеТипаПредмета = Новый ОписаниеТипов(Части[0] + "Ссылка." + Части[1]);
	Элементы.Предмет.ОграничениеТипа = ОписаниеТипаПредмета;
	Элементы.Предмет.Заголовок = ОбъектМетаданных.Представление();
	Предмет = ОписаниеТипаПредмета.ПривестиЗначение(Предмет);

КонецПроцедуры

#КонецОбласти
