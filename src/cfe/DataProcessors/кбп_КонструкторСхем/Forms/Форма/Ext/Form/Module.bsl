#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не кбп_Лицензирование.ДоступноДействие("ОткрытиеКонструктора") Тогда
		ВызватьИсключение НСтр("ru = 'Конструктор схем недоступен по условиям лицензии.'");
	КонецЕсли;

	СвязиВерсии = Новый Массив;
	СвязиВерсии.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Схема"));
	Элементы.Версия.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиВерсии);

	Если Параметры.Свойство("Схема") И ЗначениеЗаполнено(Параметры.Схема) Тогда
		Схема = Параметры.Схема;
		Версия = кбп_КомпиляторСхем.ВерсияДляРедактирования(Схема);
	КонецЕсли;
	ПрочитатьВерсию();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не Модифицированность Или Не ЭтоЧерновик Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Схема процесса не сохранена.'");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		НСтр("ru = 'Схема изменена. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СхемаПриИзменении(Элемент)
	ОткрытьСхемуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВерсияПриИзменении(Элемент)
	ПрочитатьВерсию();
КонецПроцедуры

&НаКлиенте
Процедура ГрафСхемаВыбор(Элемент)

#Если ВебКлиент Тогда
	// В веб-клиенте текущий элемент графической схемы недоступен — свойства открываются из списка шагов.
	ПоказатьПредупреждение(, НСтр("ru = 'В веб-клиенте свойства шага открываются двойным щелчком в списке шагов справа.'"));
#Иначе
	ТекущийЭлементСхемы = Элементы.ГрафСхема.ТекущийЭлемент;
	Если ТекущийЭлементСхемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьСвойстваЭлемента(ТекущийЭлементСхемы.Имя);
#КонецЕсли

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыШаги

&НаКлиенте
Процедура ШагиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Шаги.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФорму("Справочник.кбп_ЭлементыСхем.ФормаОбъекта", Новый Структура("Ключ", ТекущиеДанные.Ссылка), ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	Если ЭтоЧерновик Тогда
		СохранитьНаСервере();
	КонецЕсли;
	ПроверитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Опубликовать(Команда)

	Если Не ЭтоЧерновик Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Публикуется только черновик.'"));
		Возврат;
	КонецЕсли;
	СохранитьНаСервере();
	Если ОпубликоватьНаСервере() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Версия опубликована'"), , Строка(Версия));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСхему(Команда)

	Если ЭтоЧерновик Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Открыт черновик — его можно изменять.'"));
		Возврат;
	КонецЕсли;
	СоздатьЧерновикНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Редактирование(Команда)

	Если Не ЭтоЧерновик Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Опубликованная версия не изменяется. Нажмите «Изменить схему».'"));
		Возврат;
	КонецЕсли;
	Элементы.ГрафСхема.Редактирование = Не Элементы.ГрафСхема.Редактирование;
	Элементы.ФормаРедактирование.Пометка = Элементы.ГрафСхема.Редактирование;

КонецПроцедуры

&НаКлиенте
Процедура СвойстваЭлемента(Команда)

#Если ВебКлиент Тогда
	ПоказатьПредупреждение(, НСтр("ru = 'В веб-клиенте выберите шаг в списке справа.'"));
#Иначе
	ТекущийЭлементСхемы = Элементы.ГрафСхема.ТекущийЭлемент;
	Если ТекущийЭлементСхемы = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите элемент на схеме.'"));
		Возврат;
	КонецЕсли;
	ОткрытьСвойстваЭлемента(ТекущийЭлементСхемы.Имя);
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура Перечитать(Команда)

	Если Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПеречитатьЗавершение", ЭтотОбъект),
			НСтр("ru = 'Несохранённые изменения схемы будут потеряны. Перечитать?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ПрочитатьВерсию();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтруктураСхемы(Команда)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтруктураСхемыНаСервере());
	Текст.Показать(НСтр("ru = 'Структура графической схемы'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
	КонецЕсли;
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПрочитатьВерсию();
	КонецЕсли;

КонецПроцедуры

// Открывает свойства шага (элемент справочника) или линии (запись регистра переходов).
// Несохранённая схема сначала сохраняется: у нового элемента ещё нет записи в справочнике.
&НаКлиенте
Процедура ОткрытьСвойстваЭлемента(ИмяЭлемента)

	Имя = ИмяЭлемента;
	Если ЭтоЧерновик И Модифицированность Тогда
		Переименования = СохранитьНаСервере();
		Если Переименования[Имя] <> Неопределено Тогда
			Имя = Переименования[Имя];
		КонецЕсли;
	КонецЕсли;

	НайденныйОбъект = ОбъектПоИмени(Версия, Имя);
	Если НайденныйОбъект = Неопределено Тогда
		Если ЭтоЧерновик Тогда
			Переименования = СохранитьНаСервере();
			Если Переименования[Имя] <> Неопределено Тогда
				Имя = Переименования[Имя];
			КонецЕсли;
			НайденныйОбъект = ОбъектПоИмени(Версия, Имя);
		КонецЕсли;
		Если НайденныйОбъект = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'У этого элемента схемы нет настроек (декорация).'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(НайденныйОбъект) = Тип("СправочникСсылка.кбп_ЭлементыСхем") Тогда
		ОткрытьФорму("Справочник.кбп_ЭлементыСхем.ФормаОбъекта", Новый Структура("Ключ", НайденныйОбъект), ЭтотОбъект);
	Иначе
		ОткрытьФорму("РегистрСведений.кбп_ПереходыСхем.ФормаЗаписи", Новый Структура("Ключ", НайденныйОбъект), ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбъектПоИмени(Версия, Имя)
	Возврат кбп_КомпиляторСхем.ОбъектПоИдЭлемента(Версия, Имя);
КонецФункции

// Сохраняет черновик. Возвращает соответствие «старое имя → новое имя» для переименованных элементов схемы.
&НаСервере
Функция СохранитьНаСервере()

	Переименования = Новый Соответствие;
	Если Не ЭтоЧерновик Тогда
		Возврат Переименования;
	КонецЕсли;

	// Реквизит формы типа ГрафическаяСхема на сервере — сам объект схемы: имена элементов проставляются в нём.
	Результат = кбп_КомпиляторСхем.СохранитьЧерновик(Версия, ГрафСхема);
	Переименования = Результат.Переименования;

	Модифицированность = Ложь;
	ЗаполнитьШаги();
	ПоказатьОшибки(Результат.Ошибки, НСтр("ru = 'Схема сохранена.'"));
	Возврат Переименования;

КонецФункции

&НаСервере
Процедура ПроверитьНаСервере()
	ПоказатьОшибки(кбп_КомпиляторСхем.ПроверитьВерсию(Версия), НСтр("ru = 'Ошибок не найдено.'"));
КонецПроцедуры

&НаСервере
Функция ОпубликоватьНаСервере()

	Ошибки = кбп_КомпиляторСхем.Опубликовать(Версия);
	Если Ошибки.Количество() > 0 Тогда
		ПоказатьОшибки(Ошибки, "");
		Возврат Ложь;
	КонецЕсли;
	ПрочитатьВерсию();
	ТекстПроверки = НСтр("ru = 'Версия опубликована. Новые процессы будут запускаться по ней.'");
	Возврат Истина;

КонецФункции

&НаСервере
Процедура СоздатьЧерновикНаСервере()
	Версия = кбп_КомпиляторСхем.СоздатьЧерновик(Схема);
	ПрочитатьВерсию();
КонецПроцедуры

&НаСервере
Процедура ОткрытьСхемуНаСервере()
	Версия = кбп_КомпиляторСхем.ВерсияДляРедактирования(Схема);
	ПрочитатьВерсию();
КонецПроцедуры

&НаСервере
Функция СтруктураСхемыНаСервере()
	Возврат кбп_КомпиляторСхем.СтруктураСхемы(ГрафСхема);
КонецФункции

&НаСервере
Процедура ПрочитатьВерсию()

	ГрафСхема = кбп_КомпиляторСхем.ГрафическаяСхемаВерсии(Версия);
	ЭтоЧерновик = ЗначениеЗаполнено(Версия)
		И Версия.Статус = Перечисления.кбп_СтатусыВерсийСхем.Черновик;
	Если ЗначениеЗаполнено(Версия) Тогда
		Статус = СтрШаблон("%1: %2", Версия.Статус, Версия);
	Иначе
		Статус = НСтр("ru = 'Выберите схему'");
	КонецЕсли;

	Элементы.ГрафСхема.Редактирование = ЭтоЧерновик;
	Элементы.ФормаРедактирование.Пометка = ЭтоЧерновик;
	Элементы.ФормаРедактирование.Доступность = ЭтоЧерновик;
	Элементы.ФормаСохранить.Доступность = ЭтоЧерновик;
	Элементы.ФормаОпубликовать.Доступность = ЭтоЧерновик;
	Элементы.ФормаИзменитьСхему.Доступность = ЗначениеЗаполнено(Версия) И Не ЭтоЧерновик;

	ЗаполнитьШаги();
	ТекстПроверки = "";
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШаги()

	Шаги.Очистить();
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из кбп_КомпиляторСхем.ШагиВерсии(Версия) Цикл
		ЗаполнитьЗначенияСвойств(Шаги.Добавить(), Строка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПоказатьОшибки(Ошибки, ТекстЕслиНет)

	Для Каждого Строка Из Шаги Цикл
		Строка.Ошибка = Ложь;
	КонецЦикла;
	Если Ошибки.Количество() = 0 Тогда
		ТекстПроверки = ТекстЕслиНет;
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		Строки.Добавить("• " + Ошибка.Текст);
		Для Каждого Строка Из Шаги.НайтиСтроки(Новый Структура("ИдЭлемента", Ошибка.Ид)) Цикл
			Строка.Ошибка = Истина;
		КонецЦикла;
	КонецЦикла;
	ТекстПроверки = СтрШаблон(НСтр("ru = 'Найдено ошибок: %1'"), Ошибки.Количество())
		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

#КонецОбласти
