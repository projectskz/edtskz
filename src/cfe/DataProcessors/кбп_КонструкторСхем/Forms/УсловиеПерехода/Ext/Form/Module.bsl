#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИдентификаторВладельца = Параметры.ИдентификаторВладельца;
	СхемаКомпоновки = кбп_Условия.СхемаУсловия(Параметры.Схема);
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));

	Настройки = Неопределено;
	Если ЭтоАдресВременногоХранилища(Параметры.АдресНастроек) Тогда
		Настройки = ПолучитьИзВременногоХранилища(Параметры.АдресНастроек);
	КонецЕсли;
	Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		Компоновщик.ЗагрузитьНастройки(Настройки);
	Иначе
		Компоновщик.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.ЗаголовокФормы) Тогда
		Заголовок = Параметры.ЗаголовокФормы;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗаголовокЛинии) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Условие перехода: %1'"), Параметры.ЗаголовокЛинии);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	Закрыть(ПоместитьНастройки());
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	Компоновщик.Настройки.Отбор.Элементы.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройки помещаются в хранилище формы-владельца: хранилище этой формы очищается при её закрытии.
&НаСервере
Функция ПоместитьНастройки()
	Возврат ПоместитьВоВременноеХранилище(Компоновщик.ПолучитьНастройки(), ИдентификаторВладельца);
КонецФункции

#КонецОбласти
