#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Процесс запускается из «Мои задачи» → «Запустить процесс…» или из конструктора схем.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗадачи

&НаКлиенте
Процедура ЗадачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Задачи.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрерватьПроцесс(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ПрерватьЗавершение", ЭтотОбъект), ,
		НСтр("ru = 'Причина прерывания процесса'"), , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПриостановитьПроцесс(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ИзменитьСостояниеЗавершение", ЭтотОбъект, "Приостановить"), ,
		НСтр("ru = 'Почему процесс приостанавливается (можно не заполнять)'"), , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПроцесс(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ИзменитьСостояниеЗавершение", ЭтотОбъект, "Продолжить"), ,
		НСтр("ru = 'Комментарий к продолжению (можно не заполнять)'"), , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомментарий(Команда)

	Если Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Напишите комментарий.'"), , "Комментарий");
		Возврат;
	КонецЕсли;
	ДобавитьКомментарийНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтложенные(Команда)

	Выполнено = ВыполнитьОтложенныеНаСервере();
	Если Выполнено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У процесса нет ожидающих таймеров и отложенных действий.'"));
	Иначе
		Оповестить("кбп_ИзменениеЗадачи", Объект.Ссылка);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отложенные действия выполнены'"), , СтрШаблон("%1", Выполнено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Ссылка <> Объект.Ссылка Тогда
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрерватьЗавершение(Причина, ДополнительныеПараметры) Экспорт

	Если Причина = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПрерватьНаСервере(Причина);
	Оповестить("кбп_ИзменениеЗадачи", Объект.Ссылка);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Процесс прерван'"), , Строка(Объект.Ссылка));

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСостояниеЗавершение(Комментарий, Действие) Экспорт

	Если Комментарий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИзменитьСостояниеНаСервере(Действие, Комментарий);
	Оповестить("кбп_ИзменениеЗадачи", Объект.Ссылка);
	ПоказатьОповещениеПользователя(?(Действие = "Приостановить", НСтр("ru = 'Процесс приостановлен'"),
		НСтр("ru = 'Процесс продолжен'")), , Строка(Объект.Ссылка));

КонецПроцедуры

&НаСервере
Процедура ИзменитьСостояниеНаСервере(Действие, Комментарий)

	Если Действие = "Приостановить" Тогда
		кбп_ПроцессыAPI.ПриостановитьПроцесс(Объект.Ссылка, Комментарий);
	Иначе
		кбп_ПроцессыAPI.ПродолжитьПроцесс(Объект.Ссылка, Комментарий);
	КонецЕсли;
	ОбновитьНаСервере();

КонецПроцедуры

&НаСервере
Функция ВыполнитьОтложенныеНаСервере()

	Если Не кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов() Тогда
		ВызватьИсключение НСтр("ru = 'Команда доступна администратору процессов.'");
	КонецЕсли;
	Выполнено = кбп_Движок.ОбработатьОчередьДействий(Объект.Ссылка, Истина);
	ОбновитьНаСервере();
	Возврат Выполнено;

КонецФункции

&НаСервере
Процедура ПрерватьНаСервере(Причина)
	кбп_ПроцессыAPI.ПрерватьПроцесс(Объект.Ссылка, Причина);
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомментарийНаСервере()
	кбп_ПроцессыAPI.ДобавитьКомментарий(Объект.Ссылка, Комментарий);
	Комментарий = "";
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	Заголовок = СтрШаблон(НСтр("ru = 'Процесс: %1'"), Объект.Наименование);
	Элементы.ФормаПрерватьПроцесс.Доступность = кбп_Движок.МожноУправлятьПроцессом(Объект.Ссылка)
		И (Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Активен
			Или Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Приостановлен
			Или Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Ошибка);
	МожноУправлять = кбп_Движок.МожноУправлятьПроцессом(Объект.Ссылка);
	Элементы.ФормаПриостановитьПроцесс.Видимость = МожноУправлять
		И Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Активен;
	Элементы.ФормаПродолжитьПроцесс.Видимость = МожноУправлять
		И Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Приостановлен
		Или Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Ошибка
			И кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов();
	Элементы.СтраницаПеременные.Видимость = Объект.Переменные.Количество() > 0;
	Элементы.Предмет.Видимость = ЗначениеЗаполнено(Объект.Предмет);
	Элементы.ДатаЗавершения.Видимость = ЗначениеЗаполнено(Объект.ДатаЗавершения);
	Элементы.РодительскийПроцесс.Видимость = ЗначениеЗаполнено(Объект.РодительскийПроцесс);

	СостояниеСейчас = кбп_Движок.ТекущееСостояние(Объект.Ссылка);
	Если СостояниеСейчас.Количество() > 0 Тогда
		Сейчас = СтрСоединить(СостояниеСейчас, Символы.ПС);
	Иначе
		Сейчас = СтрШаблон(НСтр("ru = 'Процесс %1'"), НРег(Строка(Объект.Состояние)));
	КонецЕсли;
	Элементы.ФормаВыполнитьОтложенные.Видимость = кбп_АдаптерКонфигурации.ЭтоАдминистраторПроцессов()
		И Объект.Состояние = Перечисления.кбп_СостоянияПроцессов.Активен;

	Дерево.Очистить();
	СтрокиДерева = кбп_Движок.ДеревоПроцесса(Объект.Ссылка);
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		НоваяСтрока = Дерево.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		НоваяСтрока.Представление = СтрШаблон("%1%2%3", ПолучитьОтступ(СтрокаДерева.УровеньВложенности),
			СтрокаДерева.Ссылка, ?(СтрокаДерева.ЭтоТекущий, " " + НСтр("ru = '(этот процесс)'"), ""));
	КонецЦикла;
	Элементы.СтраницаВложенные.Видимость = СтрокиДерева.Количество() > 1;

	Задачи.Очистить();
	Для Каждого СтрокаЗадачи Из кбп_Движок.ЗадачиПроцесса(Объект.Ссылка) Цикл
		ЗаполнитьЗначенияСвойств(Задачи.Добавить(), СтрокаЗадачи);
	КонецЦикла;

	Журнал.Очистить();
	Для Каждого Запись Из кбп_Движок.ЖурналПроцесса(Объект.Ссылка) Цикл
		ЗаполнитьЗначенияСвойств(Журнал.Добавить(), Запись);
	КонецЦикла;

	ПоказатьСхему();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОтступ(Уровень)

	Отступ = "";
	Для Номер = 1 По Уровень Цикл
		Отступ = Отступ + "    ";
	КонецЦикла;
	Возврат ?(Уровень > 0, Отступ + "└ ", "");

КонецФункции

// Схема версии с подсветкой: пройденные шаги — зелёные, текущие — жёлтые (ФТ-110).
&НаСервере
Процедура ПоказатьСхему()

	ГрафСхема = кбп_КомпиляторСхем.ГрафическаяСхемаВерсии(Объект.ВерсияСхемы);
	Состояния = кбп_Движок.СостоянияШаговПроцесса(Объект.Ссылка);
	Пройденный = Новый Цвет(200, 235, 200);
	Текущий = Новый Цвет(255, 230, 150);
	Для Каждого ЭлементСхемы Из ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Состояние = Состояния[ЭлементСхемы.Имя];
		Если Состояние = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЭлементСхемы.ЦветФона = ?(Состояние = "Текущий", Текущий, Пройденный);
		Исключение
			// У элементов этого вида нет цвета фона — оставляем как есть.
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
