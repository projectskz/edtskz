#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Задачи создаются процессом. Запустите процесс: «Бизнес-процессы» → «Мои задачи» → «Запустить процесс…».'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Кнопки шага, созданные в СоздатьКнопки.
&НаКлиенте
Процедура Подключаемый_ВыполнитьДействие(Команда)

	Строки = Кнопки.НайтиСтроки(Новый Структура("ИмяКоманды", Команда.Имя));
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Описание = Строки[0];

	Если Описание.ЭтоВозврат Тогда
		ВыбратьШагВозврата();
		Возврат;
	КонецЕсли;
	// Действия, которые не выполняют задачу: она остаётся открытой.
	Действия = Новый Структура("Переадресовать, ОткрытьФорму, ЗапуститьВложенный",
		ПредопределенноеЗначение("Перечисление.кбп_ВидыДействий.Переадресовать"),
		ПредопределенноеЗначение("Перечисление.кбп_ВидыДействий.ОткрытьФорму"),
		ПредопределенноеЗначение("Перечисление.кбп_ВидыДействий.ЗапуститьВложенный"));
	Если Описание.Действие = Действия.Переадресовать Тогда
		ПоказатьВводЗначения(Новый ОписаниеОповещения("ВыборИсполнителяПереадресацииЗавершение", ЭтотОбъект),
			ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"), НСтр("ru = 'Кому переадресовать задачу'"));
		Возврат;
	ИначеЕсли Описание.Действие = Действия.ОткрытьФорму Тогда
		ОткрытьФормуКнопки(Описание.ИмяФормы);
		Возврат;
	ИначеЕсли Описание.Действие = Действия.ЗапуститьВложенный Тогда
		ТекстВопроса = ?(Описание.Подтверждение И ЗначениеЗаполнено(Описание.ТекстПодтверждения),
			Описание.ТекстПодтверждения, СтрШаблон(НСтр("ru = 'Запустить процесс «%1»?'"), Описание.Заголовок));
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗапуститьПроцессПослеПодтверждения", ЭтотОбъект, Описание.ИдКнопки),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	Если Описание.КомментарийОбязателен И Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Для действия «%1» напишите комментарий.'"), Описание.Заголовок), , "Комментарий");
		Возврат;
	КонецЕсли;
	Если Не Описание.Опасная И Не ПоляЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	Если Описание.Подтверждение Тогда
		Текст = ?(ЗначениеЗаполнено(Описание.ТекстПодтверждения), Описание.ТекстПодтверждения,
			СтрШаблон(НСтр("ru = 'Выполнить «%1»?'"), Описание.Заголовок));
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьДействиеПослеПодтверждения", ЭтотОбъект, Описание.ИдКнопки),
			Текст, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ВыполнитьДействие(Описание.ИдКнопки);

КонецПроцедуры

&НаКлиенте
Процедура ПринятьКИсполнению(Команда)
	ПринятьКИсполнениюНаСервере();
	Оповестить("кбп_ИзменениеЗадачи", Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомментарий(Команда)

	Если Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Напишите комментарий.'"), , "Комментарий");
		Возврат;
	КонецЕсли;
	ДобавитьКомментарийНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Комментарий добавлен'"));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПроцесс(Команда)
	ПоказатьЗначение(, Объект.Процесс);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьДействиеПослеПодтверждения(Ответ, ИдКнопки) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьДействие(ИдКнопки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборИсполнителяПереадресацииЗавершение(Исполнитель, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ПереадресоватьЗадачу(Исполнитель, Комментарий);
		Возврат;
	КонецЕсли;
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ВводКомментарияПереадресацииЗавершение", ЭтотОбъект, Исполнитель),
		, СтрШаблон(НСтр("ru = 'Почему переадресуете (%1)'"), Исполнитель), , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВводКомментарияПереадресацииЗавершение(ВведенныйТекст, Исполнитель) Экспорт

	Если Не ЗначениеЗаполнено(СокрЛП(ВведенныйТекст)) Тогда
		Возврат;
	КонецЕсли;
	ПереадресоватьЗадачу(Исполнитель, ВведенныйТекст);

КонецПроцедуры

&НаКлиенте
Процедура ПереадресоватьЗадачу(Исполнитель, ТекстКомментария)

	ПереадресоватьНаСервере(Исполнитель, ТекстКомментария);
	ПослеВыполнения(СтрШаблон(НСтр("ru = 'Задача переадресована: %1'"), Исполнитель));

КонецПроцедуры

// «Предмет» — карточка предмета; иначе полное имя формы («Отчет.ВаловаяПрибыль» → основная форма отчёта).
&НаКлиенте
Процедура ОткрытьФормуКнопки(ИмяФормы)

	Если Не ЗначениеЗаполнено(ИмяФормы) Или ВРег(СокрЛП(ИмяФормы)) = ВРег("Предмет") Тогда
		Если ЗначениеЗаполнено(Объект.Предмет) Тогда
			ПоказатьЗначение(, Объект.Предмет);
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'У процесса нет предмета.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ПолноеИмя = СокрЛП(ИмяФормы);
	Если СтрРазделить(ПолноеИмя, ".").Количество() = 2 Тогда
		ПолноеИмя = ПолноеИмя + ".Форма";
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Предмет, Задача, Процесс", Объект.Предмет, Объект.Ссылка, Объект.Процесс);
	Попытка
		ОткрытьФорму(ПолноеИмя, ПараметрыФормы, ЭтотОбъект);
	Исключение
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Не удалось открыть форму «%1»: %2'"), ПолноеИмя,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПроцессПослеПодтверждения(Ответ, ИдКнопки) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Процесс = ЗапуститьПроцессНаСервере(ИдКнопки);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Процесс запущен'"), ПолучитьНавигационнуюСсылку(Процесс), Строка(Процесс));
	Оповестить("кбп_ИзменениеЗадачи", Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(ИдКнопки)

	ВыполнитьДействиеНаСервере(ИдКнопки);
	ПослеВыполнения(НСтр("ru = 'Задача выполнена'"));

КонецПроцедуры

// Обязательные поля заполнены; незаполненные подсвечиваются.
&НаКлиенте
Функция ПоляЗаполнены()

	Заполнены = Истина;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Обязательное И Не Поле.ТолькоПросмотр И Не ЗначениеЗаполнено(ЭтотОбъект[Поле.ИмяРеквизита]) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Заполните поле «%1».'"), Поле.Заголовок), , Поле.ИмяРеквизита);
			Заполнены = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Заполнены;

КонецФункции

&НаКлиенте
Процедура ВыбратьШагВозврата()

	Шаги = ШагиВозврата(Объект.Ссылка);
	Если Шаги.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет пройденных шагов, на которые можно вернуть задачу.'"));
		Возврат;
	КонецЕсли;
	Если Шаги.Количество() = 1 Тогда
		ВыборШагаВозвратаЗавершение(Шаги[0], Неопределено);
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыборШагаВозвратаЗавершение", ЭтотОбъект), Шаги,
		Элементы.Комментарий);

КонецПроцедуры

&НаКлиенте
Процедура ВыборШагаВозвратаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ВернутьЗадачу(ВыбранныйЭлемент.Значение, Комментарий);
		Возврат;
	КонецЕсли;
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ВводКомментарияВозвратаЗавершение", ЭтотОбъект, ВыбранныйЭлемент.Значение),
		, СтрШаблон(НСтр("ru = 'Что доработать (возврат на «%1»)'"), ВыбранныйЭлемент.Представление), , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВводКомментарияВозвратаЗавершение(ВведенныйТекст, Шаг) Экспорт

	Если Не ЗначениеЗаполнено(СокрЛП(ВведенныйТекст)) Тогда
		Возврат;
	КонецЕсли;
	ВернутьЗадачу(Шаг, ВведенныйТекст);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьЗадачу(Шаг, ТекстКомментария)

	ВернутьНаСервере(Шаг, ТекстКомментария);
	ПослеВыполнения(НСтр("ru = 'Задача возвращена на доработку'"));

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполнения(Текст)

	Оповестить("кбп_ИзменениеЗадачи", Объект.Ссылка);
	ПоказатьОповещениеПользователя(Текст, ПолучитьНавигационнуюСсылку(Объект.Ссылка), Строка(Объект.Ссылка));
	Закрыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ШагиВозврата(Задача)
	Возврат кбп_Движок.ШагиДляВозврата(Задача);
КонецФункции

&НаСервере
Процедура ВыполнитьДействиеНаСервере(ИдКнопки)

	ЗначенияПолей = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		Если Не Поле.ТолькоПросмотр Тогда
			ЗначенияПолей.Вставить(Поле.Имя, ЭтотОбъект[Поле.ИмяРеквизита]);
		КонецЕсли;
	КонецЦикла;
	кбп_ПроцессыAPI.ВыполнитьДействие(Объект.Ссылка, ИдКнопки, Комментарий, ЗначенияПолей);
	Комментарий = "";

КонецПроцедуры

&НаСервере
Процедура ПереадресоватьНаСервере(Исполнитель, ТекстКомментария)
	кбп_ПроцессыAPI.Переадресовать(Объект.Ссылка, Исполнитель, ТекстКомментария);
	Комментарий = "";
КонецПроцедуры

&НаСервере
Функция ЗапуститьПроцессНаСервере(ИдКнопки)
	Процесс = кбп_Движок.ЗапуститьПроцессИзЗадачи(Объект.Ссылка, ИдКнопки);
	ЗаполнитьЖурнал();
	Возврат Процесс;
КонецФункции

&НаСервере
Процедура ВернутьНаСервере(Шаг, ТекстКомментария)
	кбп_ПроцессыAPI.ВернутьНаДоработку(Объект.Ссылка, Шаг, ТекстКомментария);
	Комментарий = "";
КонецПроцедуры

&НаСервере
Процедура ПринятьКИсполнениюНаСервере()
	кбп_Движок.ПринятьКИсполнению(Объект.Ссылка);
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомментарийНаСервере()
	кбп_ПроцессыAPI.ДобавитьКомментарий(Объект.Процесс, Комментарий, Объект.Ссылка);
	Комментарий = "";
	ЗаполнитьЖурнал();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	Инструкция = Объект.Шаг.Инструкция;
	МожноВыполнить = кбп_Движок.МожноВыполнитьЗадачу(Объект.Ссылка);
	Заголовок = СтрШаблон(НСтр("ru = 'Задача: %1'"), Объект.Наименование);
	Сводка = СводкаЗадачи();

	Элементы.ГруппаИнструкция.Видимость = ЗначениеЗаполнено(Инструкция);
	Элементы.Предмет.Видимость = ЗначениеЗаполнено(Объект.Предмет);
	Элементы.Срок.Видимость = ЗначениеЗаполнено(Объект.Срок);
	Элементы.ФормаПринятьКИсполнению.Видимость = МожноВыполнить И Не Объект.ПринятаКИсполнению;
	Элементы.Комментарий.Видимость = МожноВыполнить;
	Элементы.Результат.Видимость = Не МожноВыполнить И ЗначениеЗаполнено(Объект.Результат);
	Результат = кбп_Действия.ЗаголовокКнопки(Объект.Шаг, Объект.Результат);
	Если ЗначениеЗаполнено(Объект.Комментарий) Тогда
		Результат = Результат + ": " + Объект.Комментарий;
	КонецЕсли;
	СоздатьПоля();
	СоздатьКнопки();
	ЗаполнитьЖурнал();

КонецПроцедуры

// «Ожидает · срок 25.09.2026 14:34 (осталось 5 ч)», «Просрочена на 2 дн.», «Выполнена 24.09.2026».
&НаСервере
Функция СводкаЗадачи()

	Части = Новый Массив;
	Части.Добавить(Строка(Объект.Состояние));
	Сейчас = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
		Части.Добавить(Формат(Объект.ДатаВыполнения, "ДЛФ=DT"));
	ИначеЕсли ЗначениеЗаполнено(Объект.Срок) Тогда
		Остаток = Объект.Срок - Сейчас;
		Если Остаток < 0 Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'просрочена на %1'"), ПредставлениеИнтервала(-Остаток)));
		Иначе
			Части.Добавить(СтрШаблон(НСтр("ru = 'осталось %1'"), ПредставлениеИнтервала(Остаток)));
		КонецЕсли;
	КонецЕсли;
	Если Объект.ПринятаКИсполнению И ЗначениеЗаполнено(Объект.ПринялКИсполнению) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'в работе у %1'"), Объект.ПринялКИсполнению));
	КонецЕсли;
	// Задача замещаемого, видимая по замещению (ФТ-304).
	Если Не ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
		Замещение = кбп_Адресация.ЗамещениеДляЗадачи(Объект.Ссылка, кбп_АдаптерКонфигурации.ТекущийПользователь());
		Если ЗначениеЗаполнено(Замещение) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'вы замещаете: %1'"), Замещение.Замещаемый));
		КонецЕсли;
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеИнтервала(Секунд)

	Если Секунд < 3600 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 мин'"), Макс(1, Цел(Секунд / 60)));
	ИначеЕсли Секунд < 86400 * 2 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 ч'"), Цел(Секунд / 3600));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1 дн'"), Цел(Секунд / 86400));

КонецФункции

// Поля к заполнению шага и переменные «показывать в задаче» — динамические реквизиты формы (ФТ-402, ФТ-403).
&НаСервере
Процедура СоздатьПоля()

	Удаляемые = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Элемент = Элементы.Найти(Поле.ИмяРеквизита);
		Если Элемент <> Неопределено Тогда
			Элементы.Удалить(Элемент);
		КонецЕсли;
		Удаляемые.Добавить(Поле.ИмяРеквизита);
	КонецЦикла;
	Поля.Очистить();

	Описания = кбп_Движок.ПоляЗадачи(Объект.Ссылка);
	ИменаПолей = Новый Соответствие;
	Для Каждого Описание Из Описания Цикл
		ИменаПолей.Вставить(Описание.Имя, Истина);
		Описание.Вставить("Группа", "ГруппаПоля");
		Описание.ТолькоПросмотр = Описание.ТолькоПросмотр Или Не МожноВыполнить;
	КонецЦикла;
	Для Каждого Описание Из ИнформацияПроцесса() Цикл
		Если ИменаПолей[Описание.Имя] = Неопределено Тогда
			Описания.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;

	Добавляемые = Новый Массив;
	Номер = 0;
	Для Каждого Описание Из Описания Цикл
		Номер = Номер + 1;
		Поле = Поля.Добавить();
		ЗаполнитьЗначенияСвойств(Поле, Описание);
		Поле.ИмяРеквизита = "кбп_Поле" + Формат(Номер, "ЧГ=0");
		Добавляемые.Добавить(Новый РеквизитФормы(Поле.ИмяРеквизита, Описание.ТипЗначения, , Описание.Заголовок));
	КонецЦикла;
	ИзменитьРеквизиты(Добавляемые, Удаляемые);

	ЕстьПоля = Ложь;
	ЕстьИнформация = Ложь;
	Для Индекс = 0 По Описания.ВГраница() Цикл
		Описание = Описания[Индекс];
		Поле = Поля[Индекс];
		ЭтотОбъект[Поле.ИмяРеквизита] = Описание.Значение;
		Элемент = Элементы.Добавить(Поле.ИмяРеквизита, Тип("ПолеФормы"), Элементы[Описание.Группа]);
		Элемент.ПутьКДанным = Поле.ИмяРеквизита;
		Если Описание.ТипЗначения.Типы().Количество() = 1 И Описание.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			Элемент.Вид = ВидПоляФормы.ПолеФлажка;
		Иначе
			Элемент.Вид = ВидПоляФормы.ПолеВвода;
			Элемент.АвтоОтметкаНезаполненного = Описание.Обязательное И Не Описание.ТолькоПросмотр;
		КонецЕсли;
		Элемент.ТолькоПросмотр = Описание.ТолькоПросмотр;
		Если Описание.Группа = "ГруппаПоля" Тогда
			ЕстьПоля = Истина;
		Иначе
			ЕстьИнформация = Истина;
		КонецЕсли;
	КонецЦикла;
	Элементы.ГруппаПоля.Видимость = ЕстьПоля;
	Элементы.ГруппаПоля.Заголовок = ?(МожноВыполнить, НСтр("ru = 'Заполните'"), НСтр("ru = 'Поля задачи'"));
	Элементы.ГруппаИнформация.Видимость = ЕстьИнформация;

КонецПроцедуры

// Переменные процесса с признаком «Показывать в задаче» — только для просмотра.
&НаСервере
Функция ИнформацияПроцесса()

	Результат = Новый Массив;
	Для Каждого СтрокаПеременной Из Объект.Процесс.Переменные Цикл
		Переменная = СтрокаПеременной.Переменная;
		Если Не ЗначениеЗаполнено(Переменная) Или Не Переменная.ПоказыватьВЗадаче Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("Имя, Заголовок, ТипЗначения, Значение, Обязательное, ТолькоПросмотр, Группа");
		Описание.Имя = Переменная.Имя;
		Описание.Заголовок = Переменная.Наименование;
		Описание.ТипЗначения = Переменная.ТипЗначения;
		Описание.Значение = СтрокаПеременной.Значение;
		Описание.Обязательное = Ложь;
		Описание.ТолькоПросмотр = Истина;
		Описание.Группа = "ГруппаИнформация";
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Кнопки шага создаются программно (Архитектура п. 8.1).
&НаСервере
Процедура СоздатьКнопки()

	Для Каждого Описание Из Кнопки Цикл
		Элемент = Элементы.Найти(Описание.ИмяКоманды);
		Если Элемент <> Неопределено Тогда
			Элементы.Удалить(Элемент);
		КонецЕсли;
		Команда = Команды.Найти(Описание.ИмяКоманды);
		Если Команда <> Неопределено Тогда
			Команды.Удалить(Команда);
		КонецЕсли;
	КонецЦикла;
	Кнопки.Очистить();

	Номер = 0;
	ЕстьОсновная = Ложь;
	ПерваяКнопка = Элементы.ФормаПринятьКИсполнению;
	Для Каждого КнопкаШага Из кбп_Действия.КнопкиЗадачи(Объект.Ссылка) Цикл
		Номер = Номер + 1;
		Описание = Кнопки.Добавить();
		Описание.ИмяКоманды = "кбп_Кнопка" + Формат(Номер, "ЧГ=0");
		Описание.ИдКнопки = КнопкаШага.ИдКнопки;
		Описание.Заголовок = КнопкаШага.Заголовок;
		Описание.ЭтоВозврат = (КнопкаШага.Действие = Перечисления.кбп_ВидыДействий.Вернуть);
		Описание.Опасная = (КнопкаШага.Вид = Перечисления.кбп_ВидыКнопок.Опасная) Или Описание.ЭтоВозврат;
		Описание.Подтверждение = КнопкаШага.Подтверждение;
		Описание.ТекстПодтверждения = КнопкаШага.ТекстПодтверждения;
		Описание.КомментарийОбязателен = КнопкаШага.КомментарийОбязателен;
		Описание.Действие = КнопкаШага.Действие;
		Описание.ИмяФормы = КнопкаШага.ИмяФормы;

		Команда = Команды.Добавить(Описание.ИмяКоманды);
		Команда.Заголовок = КнопкаШага.Заголовок;
		Команда.Действие = "Подключаемый_ВыполнитьДействие";

		// Кнопки действий — перед «Принять к исполнению» и «Только комментарий».
		Кнопка = Элементы.Вставить(Описание.ИмяКоманды, Тип("КнопкаФормы"), Элементы.Действия, ПерваяКнопка);
		Кнопка.ИмяКоманды = Описание.ИмяКоманды;
		Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		Кнопка.Высота = 2;
		Если Не КнопкаШага.Доступна Тогда
			// Условие доступности (ФТ-204) не выполнено: кнопку видно, но нажать нельзя, в подсказке — почему.
			Кнопка.Доступность = Ложь;
			Кнопка.Подсказка = СтрШаблон(НСтр("ru = 'Станет доступна, когда: %1'"),
				кбп_Условия.ПредставлениеУсловия(КнопкаШага.УсловиеДоступности));
			Кнопка.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
		ИначеЕсли КнопкаШага.Вид = Перечисления.кбп_ВидыКнопок.Основная И Не ЕстьОсновная Тогда
			Кнопка.КнопкаПоУмолчанию = Истина;
			ЕстьОсновная = Истина;
		ИначеЕсли КнопкаШага.Вид = Перечисления.кбп_ВидыКнопок.Опасная Тогда
			Кнопка.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
	КонецЦикла;
	Элементы.ФормаДобавитьКомментарий.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЖурнал()

	Журнал.Очистить();
	Для Каждого Запись Из кбп_Движок.ЖурналПроцесса(Объект.Процесс) Цикл
		ЗаполнитьЗначенияСвойств(Журнал.Добавить(), Запись);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
